xeo:ranksFor rdfs:label "ranks for" .
xeo:hasSnapshot rdfs:label "has snapshot" .
xeo:hasResult rdfs:label "has result" .
xeo:inTopic rdfs:label "in topic" .
xeo:childOf rdfs:label "child of" .
xeo:scopedTo rdfs:label "scoped to" .
xeo:origin rdfs:label "origin" .
xeo:address rdfs:label "address" .
xeo:statusCode rdfs:label "status code" .
xeo:anchorText rdfs:label "anchor text" .
xeo:clicks rdfs:label "clicks" .
xeo:impressions rdfs:label "impressions" .
xeo:avgPosition rdfs:label "average position" .
xeo:embeddingRef rdfs:label "embedding reference" .
xeo:embeddingModel rdfs:label "embedding model" .
xeo:confidence rdfs:label "confidence" .
xeo:websiteId rdfs:label "website id" .
xeo:datasetUri rdfs:label "dataset URI" .
xeo:name rdfs:label "name" .
xeo:title rdfs:label "title" .
xeo:metaDescription rdfs:label "meta description" .
xeo:rel rdfs:label "rel" .
xeo:resultType rdfs:label "result type" .
xeo:position rdfs:label "position" .
xeo:ctr rdfs:label "CTR" .
