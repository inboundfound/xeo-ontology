@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix xeo:  <https://xeoontology.org/xeo#> .

# XEO core module: the terms every other module builds on.
# Namespace served at xeoontology.org; a w3id.org redirect may front it later
# without changing term local names.

xeo: a owl:Ontology ;
    dct:title "XEO Core Ontology" ;
    dct:description "XEO core: sites, pages, queries, crawls, search results, engines, observations, metrics, website conversions, people, organizations, consent and money. Every add-on module needs only this one. Entities are durable, episodes are immutable, observations name what they are grounded in, derivations carry provenance." ;
    dct:creator "Inbound Found" ;
    owl:versionInfo "0.7.0" .

# --- Annotation properties -------------------------------------------------

xeo:xeoLayer a owl:AnnotationProperty ;
    rdfs:comment "One of: entity, episode, observation, derivation, interpretation, norm. Types every term by the kind of claim it makes; every term carries exactly one. A layer is a kind of claim, not a file: the files are modules, and any module may hold terms of any layer. A graph that stamps instances with their layer uses the same name and values. Named epistemicLayer until 0.7." .

xeo:groundedIn a owl:AnnotationProperty ;
    rdfs:comment "The primary standard or API contract that defines this term's meaning." .

xeo:canonicalStore a owl:AnnotationProperty ;
    rdfs:comment "Where this term's instances authoritatively live: neo4j, bigquery, vector-store, crm. The ontology is storage-agnostic; identity keys (websiteId, address, term name, date) join across stores." .

# --- Classes ----------------------------------------------------------------

xeo:Website a owl:Class ;
    rdfs:label "Website" ;
    xeo:xeoLayer "entity" ;
    xeo:groundedIn "WHATWG URL Standard (origin)" ;
    dct:description "A site under observation, identified by its origin. The tenancy scope for URLs, crawls, and topics." .

xeo:URL a owl:Class ;
    rdfs:label "URL" ;
    xeo:xeoLayer "entity" ;
    xeo:groundedIn "WHATWG URL Standard" ;
    dct:description "A resource address within a Website. Durable identity; the state of the resource at a time is recorded by Fetch observations." .

xeo:Term a owl:Class ;
    rdfs:label "Term" ;
    xeo:xeoLayer "entity" ;
    dct:description "A search query string, unique by name. Data sources are attributed on observations that mention the term, never as subtypes of the term." .

xeo:Crawl a owl:Class ;
    rdfs:label "Crawl" ;
    xeo:xeoLayer "episode" ;
    dct:description "One crawl run over one Website: time-bounded, agent-attributed, immutable once finished." .

xeo:SerpSnapshot a owl:Class ;
    rdfs:label "SERP Snapshot" ;
    xeo:xeoLayer "episode" ;
    dct:description "One observation of a search results page for a Term at a moment, for a stated engine, locale, and device." .

xeo:Topic a owl:Class ;
    rdfs:label "Topic" ;
    xeo:xeoLayer "derivation" ;
    dct:description "A named grouping of Terms and/or URLs produced by a clustering or labeling process. Site-scoped. Assignments (inTopic for a Term, about for a URL or Prompt) carry method, model, and confidence." .

xeo:SearchPerformanceFact a owl:Class ;
    rdfs:label "Search Performance Fact" ;
    xeo:xeoLayer "observation" ;
    xeo:canonicalStore "bigquery" ;
    xeo:groundedIn "Google Search Console Search Analytics API" ;
    dct:description "The atomic ground-truth metric row for one (websiteId, address, term, date [, device, country]) tuple. Never instantiated as graph relationships; the graph carries windowed ranksFor rollups whose datasetUri points back to the authoritative table." .

# --- Object properties -------------------------------------------------------

xeo:partOf a owl:ObjectProperty ;
    rdfs:domain xeo:URL ; rdfs:range xeo:Website ;
    xeo:xeoLayer "entity" .

xeo:hasCrawl a owl:ObjectProperty ;
    rdfs:domain xeo:Website ; rdfs:range xeo:Crawl ;
    xeo:xeoLayer "episode" .

xeo:fetched a owl:ObjectProperty ;
    rdfs:domain xeo:Crawl ; rdfs:range xeo:URL ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "RFC 9110 (HTTP Semantics)" ;
    dct:description "An HTTP fetch of a URL within a crawl. In the property graph this relationship carries statusCode, contentType, title, metaDescription, robotsMeta, contentHash, fetchedAt." .

xeo:linksTo a owl:ObjectProperty ;
    rdfs:domain xeo:URL ; rdfs:range xeo:URL ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "WHATWG HTML §4.5.1 (the a element)" ;
    dct:description "An observed hyperlink. Carries anchorText, rel, linkPosition, firstSeenAt, lastSeenAt, lastSeenCrawlId." .

xeo:redirectsTo a owl:ObjectProperty ;
    rdfs:domain xeo:URL ; rdfs:range xeo:URL ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "RFC 9110 §15.4 (Redirection 3xx)" .

xeo:hasCanonical a owl:ObjectProperty ;
    rdfs:domain xeo:URL ; rdfs:range xeo:URL ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "RFC 6596 (The Canonical Link Relation)" .

xeo:ranksFor a owl:ObjectProperty ;
    rdfs:domain xeo:URL ; rdfs:range xeo:Term ;
    xeo:xeoLayer "observation" ;
    xeo:canonicalStore "neo4j" ;
    xeo:groundedIn "Google Search Console Search Analytics API" ;
    dct:description "Windowed rollup projection of SearchPerformanceFacts for a (page, query) pair. Carries clicks, impressions, ctr, avgPosition, periodStart, periodEnd, source, datasetUri, syncedAt." .

xeo:hasSnapshot a owl:ObjectProperty ;
    rdfs:domain xeo:Term ; rdfs:range xeo:SerpSnapshot ;
    xeo:xeoLayer "episode" .

xeo:hasResult a owl:ObjectProperty ;
    rdfs:domain xeo:SerpSnapshot ; rdfs:range xeo:URL ;
    xeo:xeoLayer "observation" ;
    dct:description "A result observed on the SERP. Carries position and resultType. A result is a URL whether or not its site is under observation: a competitor's result has no partOf edge, it has onDomain." .

xeo:inTopic a owl:ObjectProperty ;
    rdfs:domain xeo:Term ; rdfs:range xeo:Topic ;
    xeo:xeoLayer "derivation" ;
    dct:description "Process-attributed topic assignment. Carries method, model, confidence, assignedAt." .

xeo:childOf a owl:ObjectProperty ;
    rdfs:domain xeo:Topic ; rdfs:range xeo:Topic ;
    xeo:xeoLayer "derivation" .

xeo:scopedTo a owl:ObjectProperty ;
    rdfs:domain xeo:Topic ; rdfs:range xeo:Website ;
    xeo:xeoLayer "entity" .

# --- Datatype properties (selection; relationship-carried ones documented in README) ---

xeo:origin a owl:DatatypeProperty ;
    rdfs:domain xeo:Website ; rdfs:range xsd:string ;
    xeo:groundedIn "WHATWG URL Standard (origin serialization)" .

xeo:address a owl:DatatypeProperty ;
    rdfs:domain xeo:URL ; rdfs:range xsd:string ;
    xeo:groundedIn "WHATWG URL Standard (serialized absolute URL)" .

xeo:statusCode a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "RFC 9110 §15 (Status Codes)" .

xeo:anchorText a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "WHATWG HTML §4.5.1" .

xeo:clicks a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "GSC Search Analytics API" .

xeo:impressions a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "GSC Search Analytics API" .

xeo:avgPosition a owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "GSC Search Analytics API" .

xeo:embeddingRef a owl:DatatypeProperty ;
    rdfs:range xsd:string ;  # domain-free since v0.6.0 (was xeo:Term): any embedded node carries it. See the v0.6.0 notes at the foot.
    xeo:xeoLayer "derivation" ;
    xeo:canonicalStore "vector-store" ;
    dct:description "Pointer (collection + id) to the vector in the external store, on any embedded node (a Term, a URL, a Prompt, a Topic). The geometry lives where ANN search happens; the graph keeps the claim and its provenance." .

xeo:embeddingModel a owl:DatatypeProperty ;
    rdfs:range xsd:string ;  # domain-free since v0.6.0 (was xeo:Term), with embeddingRef.
    xeo:xeoLayer "derivation" .

xeo:confidence a owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    xeo:xeoLayer "derivation" ;
    dct:description "0-1 confidence attached to a derivation edge." .

# --- Relationship-carried properties -----------------------------------------
# These ride on edges rather than nodes, so they carry no rdfs:domain. They were
# previously described in the README only, while context.jsonld already published
# them as xeo: IRIs — so they had to resolve. Declared here to close that gap.

xeo:websiteId a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    xeo:xeoLayer "entity" ;
    dct:description "The tenancy key, where a graph holds more than one tenant: scope lives in this property on the scoped nodes and edges, never in a dynamic label — the identity half of 'tenancy is data, not schema'. Optional: XEO requires it nowhere, and a single-tenant graph can leave it out." .

xeo:datasetUri a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    xeo:xeoLayer "derivation" ;
    dct:description "Pointer to the authoritative table a windowed rollup was projected from (e.g. a BigQuery table URI). The provenance contract for ranksFor and visibilityFor: the graph keeps the traversable projection, this says where the ground truth lives." .

xeo:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    xeo:xeoLayer "entity" ;
    dct:description "The identifying name of a Term, Topic, Brand, or Capability — and of a Domain, Entity, Engine, Organization, Framework, Stage, Diagnostic, Tactic or ExternalEvent. Unique within its scope; see schema.cypher for the per-class identity keys." .

xeo:title a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "WHATWG HTML (the title element)" ;
    dct:description "The document title observed on a fetch. Carried on the fetched edge, not on the URL: the address is durable, the title is what one crawl saw." .

xeo:metaDescription a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "WHATWG HTML (meta name=description)" ;
    dct:description "The meta description observed on a fetch. Carried on the fetched edge." .

xeo:rel a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "WHATWG HTML (link types)" ;
    dct:description "The rel attribute of an observed hyperlink (nofollow, sponsored, ugc, ...). Carried on linksTo." .

xeo:resultType a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    xeo:xeoLayer "observation" ;
    dct:description "The kind of SERP result observed (organic, featured snippet, local pack, ...). Carried on hasResult and relatedTerm. The vocabulary is per-engine and belongs to the consumer; xeos:serpResultType is a published reference filling." .

xeo:position a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    xeo:xeoLayer "observation" ;
    dct:description "1-based rank of a result within a SERP snapshot. Carried on hasResult. Distinct from avgPosition, which is a windowed rollup, not a single observation." .

xeo:ctr a owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "GSC Search Analytics API" ;
    dct:description "Clickthrough rate over the rollup window. Carried on ranksFor." .

xeo:periodStart a owl:DatatypeProperty ;
    rdfs:range xsd:date ;
    xeo:xeoLayer "derivation" ;
    dct:description "First day of a rollup window: a calendar date, in the source's own time zone. The window runs from periodStart to periodEnd with both days included. Carried on ranksFor and visibilityFor, and on a MetricReading; never pool across windows silently." .

xeo:periodEnd a owl:DatatypeProperty ;
    rdfs:range xsd:date ;
    xeo:xeoLayer "derivation" ;
    dct:description "Last day of a rollup window: a calendar date, in the source's own time zone. The window runs from periodStart to periodEnd with both days included, so a one-day window has periodStart equal to periodEnd. Carried on ranksFor and visibilityFor, and on a MetricReading." .

xeo:fetchedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    xeo:xeoLayer "observation" ;
    dct:description "When the fetch observation was made. Carried on fetched." .

xeo:firstSeenAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    xeo:xeoLayer "observation" ;
    dct:description "When an observed edge (a link, typically) was first seen. Half of the bitemporal pair that makes link liveness answerable." .

xeo:lastSeenAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    xeo:xeoLayer "observation" ;
    dct:description "When an observed edge was most recently seen. With lastSeenCrawlId this is how a link is known to be live rather than merely once-observed." .

xeo:assignedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    xeo:xeoLayer "derivation" ;
    dct:description "When a derivation edge was written (e.g. a topic assignment). Carried on inTopic alongside method, model and confidence." .

# --- Module IRI convention ---------------------------------------------------
# `xeo:` above names the ontology as a whole — all modules share one hash
# namespace, so a term IRI never says which file it came from. Each module also
# declares `xeo:<name>-module` (xeo:visibility-module, xeo:align-module, ...) so
# it can be versioned and cited on its own.

# --- v0.6.0 (kit sync) ---------------------------------------------------------
# Appended at the foot, so no line above moves. Three kinds of change:
#
# ADDED. The slots every crawl export and SERP capture already carried, which
# core named only in prose (contentType, robotsMeta, contentHash, crawlDepth,
# indexable, wordCount, h1, linkPosition, crawler, startedAt, endedAt,
# lastSeenCrawlId, syncedAt, embeddedAt, embeddingDim, locale, device); the
# registrable Domain a URL sits on, so a competitor's result has somewhere to
# attach without becoming a tracked Website; relatedTerm for the queries a
# results page suggests; and Entity + about for meaning that is not a keyword
# cluster.
#
# WIDENED (in place, above, each on its own line so nothing shifted).
# embeddingRef and embeddingModel lost `rdfs:domain xeo:Term`: URLs, Prompts and
# Topics are embedded too, and rdfs:domain is an entailment rule, not a
# constraint — the old domain typed every embedded URL as a Term. Topic's
# description now covers grouping URLs as well as Terms.
#
# HINTS. xeo:domainIncludes / xeo:rangeIncludes say where an open-domain
# property is expected, without the entailment rdfs:domain would bring.

xeo:domainIncludes a owl:AnnotationProperty ;
    rdfs:comment "A class this property is expected on, where rdfs:domain is deliberately left open or would be too narrow. A hint for documentation, the Neo4j profile and SHACL shapes — never an entailment, so a value on some other class is unlisted, not wrong. Same reading as schema.org's domainIncludes." .

xeo:rangeIncludes a owl:AnnotationProperty ;
    rdfs:comment "A class this property is expected to point at, where rdfs:range is deliberately left open. A hint, never an entailment. Same reading as schema.org's rangeIncludes." .

# --- v0.6.0 classes -------------------------------------------------------------

xeo:Domain a owl:Class ;
    rdfs:label "Domain" ;
    xeo:xeoLayer "entity" ;
    xeo:groundedIn "WHATWG URL Standard (host) · Public Suffix List (registrable domain)" ;
    dct:description "A registrable domain (the public suffix plus one label, e.g. example.co.uk), identified by its name in lower case. The publisher-level identity a URL sits on, whether or not the site is under observation: a competitor's result has no partOf edge to a tracked Website, it has onDomain. Not tenant-scoped: one node per domain, shared by every tenant that sees it, and it carries no websiteId." .

xeo:Entity a owl:Class ;
    rdfs:label "Entity" ;
    xeo:xeoLayer "entity" ;
    dct:description "A real-world thing or concept that content is about — a product, a place, a person, a material, a method — identified by a reference into a public knowledge base (entityRef) where one exists, otherwise by name. Distinct from Topic, which is a site-scoped grouping somebody derived, and from Brand, which is a market identity engines mention: an Entity is the thing itself, shared across sites. Not tenant-scoped. Named for the knowledge-graph sense of the word; not to be confused with the layer 'entity', which Website, URL and Term also occupy." .

# --- v0.6.0 object properties ----------------------------------------------------

xeo:onDomain a owl:ObjectProperty ;
    rdfs:label "on domain" ;
    rdfs:domain xeo:URL ; rdfs:range xeo:Domain ;
    xeo:xeoLayer "entity" ;
    xeo:groundedIn "WHATWG URL Standard (host) · Public Suffix List (registrable domain)" ;
    dct:description "The registrable domain this URL's host belongs to. A fact of the address, not of any crawl: computed from the host and the public suffix list, the same for every tenant. One per URL." .

xeo:relatedTerm a owl:ObjectProperty ;
    rdfs:label "related term" ;
    rdfs:domain xeo:SerpSnapshot ; rdfs:range xeo:Term ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "The results page as served (per-provider SERP API contract)" ;
    dct:description "A query the results page itself suggested: a 'people also ask' question or a related search. Carries resultType to say which, and position where the engine orders them. The suggested query is a Term like any other, which is what joins a snapshot's neighbourhood back to rank data." .

xeo:about a owl:ObjectProperty ;
    rdfs:label "about" ;
    xeo:xeoLayer "derivation" ;
    xeo:domainIncludes xeo:URL , xeo:Prompt , xeo:Term ;
    xeo:rangeIncludes xeo:Topic , xeo:Entity ;
    dct:description "The subject says something about this Topic or Entity, as assigned by a stated process (entity linking, a classifier, a human tagger). Carries method and confidence, and model where a model made the call. Many per subject. Domain and range left open across the terms listed: inTopic stays the narrower, clustering-specific edge from a Term to its Topic; about is the general aboutness claim for a URL, a Prompt or a Term." .

# --- v0.6.0 crawl-observation slots ----------------------------------------------
# Carried on the fetched edge unless stated: the address is durable, these are
# what one crawl saw. A property-graph implementation often copies the latest
# crawl's values onto the URL node for convenience. That copy is a cache of one
# observation and should say which (lastSeenCrawlId); the fetched edge remains
# the record.

xeo:contentType a owl:DatatypeProperty ;
    rdfs:label "content type" ;
    rdfs:range xsd:string ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "RFC 9110 §8.3 (Content-Type)" ;
    dct:description "The media type the server declared for the fetched representation (text/html, application/pdf, ...), parameters dropped. Carried on fetched." .

xeo:robotsMeta a owl:DatatypeProperty ;
    rdfs:label "robots meta" ;
    rdfs:range xsd:string ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "WHATWG HTML (meta name=robots) · the X-Robots-Tag response header" ;
    dct:description "The robots directives observed on a fetch, as a comma-separated list in lower case (noindex, nofollow, ...), combining the robots meta element and the X-Robots-Tag header. Absent when the page declares none. Carried on fetched." .

xeo:h1 a owl:DatatypeProperty ;
    rdfs:label "h1" ;
    rdfs:range xsd:string ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "WHATWG HTML §4.3.6 (the h1 element)" ;
    dct:description "The text of the first h1 element observed on a fetch. Carried on fetched. A page with several h1 elements records the first; the count is a crawler's finding, not this slot's." .

xeo:contentHash a owl:DatatypeProperty ;
    rdfs:label "content hash" ;
    rdfs:range xsd:string ;
    xeo:xeoLayer "derivation" ;
    dct:description "A digest of the fetched body, used to tell whether a page changed between crawls. A derivation: the algorithm and what was hashed (raw bytes, rendered text) are the crawler's choice, so the value names its algorithm (sha256:...) and is only comparable with hashes made the same way. Carried on fetched." .

xeo:crawlDepth a owl:DatatypeProperty ;
    rdfs:label "crawl depth" ;
    rdfs:range xsd:integer ;
    xeo:xeoLayer "derivation" ;
    dct:description "The fewest link hops from the crawl's start URL to this one, 0 for the start URL. A derivation over one crawl's link graph: it depends on where that crawl started and what it was allowed to follow, so it is carried on fetched and compared only within a crawl." .

xeo:indexable a owl:DatatypeProperty ;
    rdfs:label "indexable" ;
    rdfs:range xsd:boolean ;
    xeo:xeoLayer "derivation" ;
    dct:description "Whether the crawler judged the fetched page eligible for indexing: a successful status, no noindex directive, not canonicalised elsewhere, not blocked. A derivation from statusCode, robotsMeta and hasCanonical by the crawler's own rule, which is the method; it is not a statement that any engine has indexed the page. Carried on fetched." .

xeo:wordCount a owl:DatatypeProperty ;
    rdfs:label "word count" ;
    rdfs:range xsd:integer ;
    xeo:xeoLayer "derivation" ;
    dct:description "The number of words the crawler counted in the fetched page. A derivation: tools differ on what is counted (body text only, or navigation and footer as well), so counts from different crawlers are not comparable. Carried on fetched." .

xeo:linkPosition a owl:DatatypeProperty ;
    rdfs:label "link position" ;
    rdfs:range xsd:string ;
    xeo:xeoLayer "derivation" ;
    dct:description "Where on the source page an observed hyperlink sits, as a code from a slotted-in scheme (content, navigation, header, footer, sidebar, other — xeos:linkPosition is a published reference filling). A derivation: the crawler classifies it from the markup around the link. Carried on linksTo. It is what separates an editorial link from a template link, which is why role and authority derivations read it." .

xeo:crawler a owl:DatatypeProperty ;
    rdfs:label "crawler" ;
    rdfs:range xsd:string ;
    xeo:xeoLayer "episode" ;
    xeo:groundedIn "RFC 9110 §10.1.5 (User-Agent)" ;
    dct:description "The agent that ran a Crawl: its product token and version as sent in User-Agent, or the tool's name and version. Carried on the Crawl. Without it two crawls of one site are not comparable, because rendering, depth limits and counting rules differ by tool." .

xeo:startedAt a owl:DatatypeProperty ;
    rdfs:label "started at" ;
    rdfs:range xsd:dateTime ;
    xeo:xeoLayer "episode" ;
    dct:description "When a time-bounded episode began: a Crawl, an Experiment. Domain left open so any episode with a duration can carry it. With endedAt (or concludedAt on an Experiment) it bounds the window." .

xeo:endedAt a owl:DatatypeProperty ;
    rdfs:label "ended at" ;
    rdfs:range xsd:dateTime ;
    xeo:xeoLayer "episode" ;
    dct:description "When a time-bounded episode finished and became immutable. Carried on a Crawl. An Experiment keeps concludedAt, which says the same for its own case. Domain left open." .

xeo:lastSeenCrawlId a owl:DatatypeProperty ;
    rdfs:label "last seen crawl id" ;
    rdfs:range xsd:string ;
    xeo:xeoLayer "episode" ;
    dct:description "The id of the Crawl that most recently observed an edge or a cached value. An identity key naming an episode, not itself a measurement. Carried on linksTo with lastSeenAt: a link whose lastSeenCrawlId is not the site's latest crawl is one that crawl did not find." .

xeo:syncedAt a owl:DatatypeProperty ;
    rdfs:label "synced at" ;
    rdfs:range xsd:dateTime ;
    xeo:xeoLayer "derivation" ;
    dct:description "When a windowed rollup was last projected from its authoritative table. Carried on ranksFor and visibilityFor beside datasetUri. It dates the projection, not the data: the window is periodStart to periodEnd." .

xeo:embeddedAt a owl:DatatypeProperty ;
    rdfs:label "embedded at" ;
    rdfs:range xsd:dateTime ;
    xeo:xeoLayer "derivation" ;
    dct:description "When the vector behind embeddingRef was computed. Carried beside embeddingRef and embeddingModel on any embedded node; an embedding older than the content it was made from is stale." .

xeo:embeddingDim a owl:DatatypeProperty ;
    rdfs:label "embedding dimension" ;
    rdfs:range xsd:integer ;
    xeo:xeoLayer "derivation" ;
    dct:description "The number of dimensions of the vector behind embeddingRef. Fixed by embeddingModel and any truncation applied; two vectors are comparable only when model and dimension both match." .

# --- v0.6.0 SERP capture slots ----------------------------------------------------

xeo:locale a owl:DatatypeProperty ;
    rdfs:label "locale" ;
    rdfs:range xsd:string ;
    xeo:xeoLayer "episode" ;
    xeo:groundedIn "BCP 47 (RFC 5646)" ;
    dct:description "The language and region a capture was requested for, as a BCP 47 tag (en-GB, de-DE). Carried on a SerpSnapshot, and on an LLMResponse where the engine takes one. Part of what makes two captures comparable: never pool across locales silently. A finer location (a city, coordinates) is the capturing tool's parameter and is not modelled here." .

xeo:device a owl:DatatypeProperty ;
    rdfs:label "device" ;
    rdfs:range xsd:string ;
    xeo:xeoLayer "episode" ;
    dct:description "The device class a capture was requested for, as a code from a slotted-in scheme (desktop, mobile, tablet — xeos:device is a published reference filling). Carried on a SerpSnapshot. Results differ by device, so it is part of what makes two snapshots comparable." .

xeo:entityRef a owl:DatatypeProperty ;
    rdfs:label "entity reference" ;
    rdfs:range xsd:string ;
    xeo:xeoLayer "entity" ;
    dct:description "Identity-key pointer from an Entity to its record in a public knowledge base, written as a compact or full IRI (a Wikidata item, a knowledge-graph machine id). The identity of the Entity where present: two Entities with the same entityRef are the same thing whatever their names. The graph joins on the key and never mirrors the knowledge base's schema." .

# --- v0.6.0 annotation completeness -----------------------------------------------
# Every class and property now carries rdfs:label, dct:description and
# xeo:xeoLayer, so tools/validate.py can require all three. The triples
# below add what the declarations above lacked; nothing is redefined.

xeo:origin xeo:xeoLayer "entity" ;
    dct:description "The serialized origin (scheme, host, port) that identifies a Website, e.g. https://www.example.com. One per Website." .

xeo:address xeo:xeoLayer "entity" ;
    dct:description "The serialized absolute URL. The identity of a URL, together with websiteId where the URL is tenant-scoped." .

xeo:partOf dct:description "The Website this URL belongs to. Present only for URLs of a site under observation; any other URL is placed by onDomain alone." .

xeo:hasCrawl dct:description "A crawl run over this Website." .

xeo:redirectsTo dct:description "An observed HTTP redirect from one URL to the next hop. Carries statusCode and the crawl that saw it." .

xeo:hasCanonical dct:description "The canonical URL a page declared for itself, by link element or header, as observed on a fetch." .

xeo:hasSnapshot dct:description "A captured results page for this Term." .

xeo:childOf dct:description "The broader Topic this Topic sits under. The Topic tree is the only hierarchy core defines." .

xeo:scopedTo dct:description "The Website whose content a Topic was derived from. Topics are site-scoped." .

xeo:statusCode dct:description "The HTTP status code of a fetch. Carried on fetched, and on redirectsTo for the redirect's own code." .

xeo:anchorText dct:description "The text content of an observed hyperlink. Carried on linksTo." .

xeo:clicks dct:description "Search clicks over the rollup window. Carried on ranksFor." .

xeo:impressions dct:description "Search impressions over the rollup window. Carried on ranksFor." .

xeo:avgPosition dct:description "Impression-weighted average position over the rollup window, 1-based, lower is better. Carried on ranksFor. Distinct from position, which is one observation on one results page." .

xeo:embeddingModel dct:description "The model that produced the vector behind embeddingRef, with its version. Two vectors are comparable only when this matches." .

# Labels for the properties declared above, which carried none.

xeo:partOf rdfs:label "part of" .
xeo:hasCrawl rdfs:label "has crawl" .
xeo:fetched rdfs:label "fetched" .
xeo:linksTo rdfs:label "links to" .
xeo:redirectsTo rdfs:label "redirects to" .
xeo:hasCanonical rdfs:label "has canonical" .
xeo:ranksFor rdfs:label "ranks for" .
xeo:hasSnapshot rdfs:label "has snapshot" .
xeo:hasResult rdfs:label "has result" .
xeo:inTopic rdfs:label "in topic" .
xeo:childOf rdfs:label "child of" .
xeo:scopedTo rdfs:label "scoped to" .
xeo:origin rdfs:label "origin" .
xeo:address rdfs:label "address" .
xeo:statusCode rdfs:label "status code" .
xeo:anchorText rdfs:label "anchor text" .
xeo:clicks rdfs:label "clicks" .
xeo:impressions rdfs:label "impressions" .
xeo:avgPosition rdfs:label "average position" .
xeo:embeddingRef rdfs:label "embedding reference" .
xeo:embeddingModel rdfs:label "embedding model" .
xeo:confidence rdfs:label "confidence" .
xeo:websiteId rdfs:label "website id" .
xeo:datasetUri rdfs:label "dataset URI" .
xeo:name rdfs:label "name" .
xeo:title rdfs:label "title" .
xeo:metaDescription rdfs:label "meta description" .
xeo:rel rdfs:label "rel" .
xeo:resultType rdfs:label "result type" .
xeo:position rdfs:label "position" .
xeo:ctr rdfs:label "CTR" .
xeo:periodStart rdfs:label "period start" .
xeo:periodEnd rdfs:label "period end" .
xeo:fetchedAt rdfs:label "fetched at" .
xeo:firstSeenAt rdfs:label "first seen at" .
xeo:lastSeenAt rdfs:label "last seen at" .
xeo:assignedAt rdfs:label "assigned at" .

# --- v0.6.0 (metrics and CRM pipeline, 2026-11-10) --------------------------------
# Appended at the foot, so no line above moves. One annotation property, for the
# two research reports that landed after the kit sync. No core class or property
# is added: the metric terms were in xeo-metrics.ttl (core since 0.7) and the
# pipeline terms in xeo-engagement.ttl (xeo-sales.ttl since 0.7). periodStart and periodEnd (above) are reused by
# xeo:MetricReading with the meaning they already have, an inclusive first and
# last day; their descriptions gained that case in place.

xeo:termStatus a owl:AnnotationProperty ;
    rdfs:comment "Whether a term is part of the core every implementation is expected to support, or of the extension set: 'core' or 'extension'. Absent means core, so every term published before this annotation existed is core without being touched. An extension term is declared, stable and usable; it is marked because only some of the systems XEO maps support the idea, and a consumer may ignore it. Also carried by a concept in a reference scheme, with the same reading. Says nothing about deprecation, which is owl:deprecated." .

# --- v0.6.0 (mappings, 2026-11-11) -------------------------------------------------
# Appended at the foot, so no line above moves. The per-tool mappings moved out of
# the ontology into mappings/ before release. The one annotation they all carry is
# an XEO term, so it is declared here. Its text is unchanged.

xeo:mappingConfidence a owl:AnnotationProperty ;
    rdfs:comment "How a vendor-field mapping is known: 'documented' (the vendor's own documentation states the field and its meaning), 'inferred' (the meaning is documented but the field name or its role rests on a secondary source or on the mapper's reading), or 'verified' (checked against live API output). Carried by every concept in a vendor scheme. No mapping published so far is verified." .

# --- v0.6.0 (canonical parties, 2026-11-12) ----------------------------------------
# Appended at the foot, so no line above moves. Decided 2026-11-12: a person and
# an organization are core, canonical nodes, and every system's record of one
# points at it the same way.
#
# MOVED. Organization, owns and organizationKind were added in 0.6.0 to
# xeo-delivery.ttl (now xeo-work.ttl). They were never published, so they move here unchanged in
# name; clientOf and holdsCapability stay in delivery (agency and scope terms).
#
# ADDED. Person, the canonical person, and refersTo, the edge from a system's
# record of a party to the canonical Person or Organization it represents.
#
# VENDOR RECORDS. A HubSpot contact, a Hyros lead or a SegMetrics visitor is a
# node of its own, labelled by the implementation's vendor-label convention
# (HUBSPOT_Contact: the vendor's name in capitals, an underscore, the record
# type as the vendor names it). A vendor label is never an XEO term. The
# neutral pipeline properties (crmRecordRef, dealAmount, ...) sit on that
# record; the canonical node carries no vendor's fields. mappings/README.md
# states the convention. This replaces the CrmRecord class minted on
# 2026-11-11, which is removed: one class standing for a person, a company, a
# deal or a task said too little.
#
# THE LAYER OF refersTo. An identity match made by a key the systems share is
# recorded; one made by comparing emails or names is someone's call. One term
# has one layer, so refersTo takes the weaker one, derivation, and its method
# says how each match was made.

xeo:Organization a owl:Class ;
    rdfs:label "Organization" ;
    xeo:xeoLayer "entity" ;
    dct:description "The canonical organization: one node per real organization (an agency, a brand's company, an in-house team, a customer's company), which every system's record of it (a CRM company, an ad account's owner, a billing customer) points at with refersTo. Identified by name. The owner of Websites and Brands (owns), the holder of Capabilities and the client of another Organization (holdsCapability and clientOf, in xeo-work), and a tenancy node that activates Frameworks and Playbooks. It copies no vendor's fields: what a CRM knows about the company stays on the CRM's record, which refers to this node. Its kind is a slotted-in concept (organizationKind), never a subclass." .

xeo:Person a owl:Class ;
    rdfs:label "Person" ;
    xeo:xeoLayer "entity" ;
    dct:description "The canonical person: one node per real person (a contact, a lead, a known visitor, a client's marketer, a team member), which every system's record of that person (a HubSpot contact, a Hyros lead, a SegMetrics visitor) points at with refersTo, so all of a person's representations join the same way. Its identity is a key the implementation mints; an email or a name is how a record is matched to it, not what it is. It copies no vendor's fields: a lifecycle stage, an owner or a source channel stays on the system's record that refers to it." .

xeo:owns a owl:ObjectProperty ;
    rdfs:label "owns" ;
    rdfs:domain xeo:Organization ;
    xeo:xeoLayer "entity" ;
    xeo:rangeIncludes xeo:Website , xeo:Brand ;
    dct:description "A Website or Brand this Organization is responsible for. Ownership in the working sense — whose site it is — not a legal claim. Range left open across Website and Brand." .

xeo:organizationKind a owl:ObjectProperty ;
    rdfs:label "organization kind" ;
    rdfs:domain xeo:Organization ; rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
    xeo:xeoLayer "entity" ;
    dct:description "What kind of party an Organization is, as a slotted-in concept (agency, brand, in_house — xeos:organizationKind is a published reference filling). One per Organization." .

xeo:refersTo a owl:ObjectProperty ;
    rdfs:label "refers to" ;
    xeo:xeoLayer "derivation" ;
    xeo:rangeIncludes xeo:Person , xeo:Organization ;
    dct:description "From a system's record of a party to the canonical Person or Organization it represents: a HubSpot contact or company, a Hyros lead, a SegMetrics visitor. Many records may refer to one canonical node; a record refers to one. A derivation, because matching a record to a real party is a resolution two resolvers can make differently. It carries method, which says how the match was made: system-key:<key> where the systems share a key (a vendor id carried across an integration, the strongest match and as good as recorded), email-match or name-match where values were compared, manual where a person linked them; and confidence where the method reports one. Domain left open: the record is a vendor-labelled node, and a vendor label is never an XEO term. Range left open across Person and Organization." .

# --- v0.7.0 (modules, 2026-11-12) ---------------------------------------------------
# Appended at the foot, so no line above moves. 0.7 repackages XEO so that every
# module needs only core. The terms below moved here unchanged: the same names,
# types and statements, only in a different file.
#
#   From xeo-visibility.ttl: Engine and SearchEngine, and the three properties a
#     core SerpSnapshot already carries (onEngine, capturedAt, model).
#   From xeo-engagement.ttl: search intent, website conversions (ConversionPoint,
#     ConversionEvent and the properties that describe them) and the money terms
#     (currencyCode, recurringValue, valuePeriod, amountInReportingCurrency).
#     The CRM side of engagement is now xeo-sales.ttl; attributedResponse went to
#     visibility, since it points at an LLMResponse.
#   From xeo-metrics.ttl: the whole module. Metric and MetricReading are core.
#
# Deprecated terms among them (the ConversionPoint subclasses, the four
# SearchIntent individuals, valuePeriod) moved too, and were deleted later in 0.7.

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# --- Engines (from xeo-visibility.ttl) ------------------------------------------------

xeo:Engine a owl:Class ;
    rdfs:label "Engine" ;
    xeo:xeoLayer "entity" ;
    dct:description "A system that mediates between a person's question and web content. A parent class only: every engine node is one of its subtypes, SearchEngine (here), or GenerativeOverview or AnswerEngine (visibility)." .

xeo:SearchEngine a owl:Class ; rdfs:subClassOf xeo:Engine ;
    rdfs:label "Search Engine" ;
    dct:description "Classic ranked-results retrieval (the SEO surface)." ;
    xeo:xeoLayer "entity" .

xeo:onEngine a owl:ObjectProperty ;
    rdfs:range xeo:Engine ;  # domain-free since v0.6.0 (was xeo:LLMResponse): a SerpSnapshot is on an engine too.
    xeo:xeoLayer "episode" ;
    dct:description "Which engine (and, via model/modelVersion properties, which model) produced this response — or, on a SerpSnapshot, served this results page." ;
    rdfs:label "on engine" .

xeo:capturedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;  # domain-free since v0.6.0 (was xeo:LLMResponse): SerpSnapshot carries it, and the domain typed every snapshot as a response.
    xeo:xeoLayer "episode" ;
    dct:description "When a capture episode was taken: an LLMResponse or a SerpSnapshot. The instant the record was made, after which it is immutable." ;
    rdfs:label "captured at" .

xeo:model a owl:DatatypeProperty ;
    rdfs:range xsd:string ;  # domain-free since v0.6.0 (was xeo:LLMResponse): inTopic and other derivation edges carry it.
    xeo:xeoLayer "episode" ;
    dct:description "Model identifier + version as reported at capture time. Without this the episode is not comparable across time. Also carried on derivation edges (inTopic, about) to name the model that produced the assignment." ;
    rdfs:label "model" .

# --- Search intent (from xeo-engagement.ttl) -------------------------------------------

xeo:SearchIntent a owl:Class ;
    rdfs:label "Search Intent" ;
    xeo:xeoLayer "entity" ;
    xeo:groundedIn "Broder (2002), 'A taxonomy of web search', as extended in common practice" ;
    dct:description "Why the person is asking. Modeled as named individuals, not free strings. Since 0.6.0 the same four values are also published as concepts in xeos:searchIntent, each a SearchIntent, which is the form to write." .

# Removed in 0.7: xeo:Informational. Use the xeos:searchIntent concept informational.


# Removed in 0.7: xeo:Navigational. Use the xeos:searchIntent concept navigational.


# Removed in 0.7: xeo:CommercialInvestigation. Use the xeos:searchIntent concept commercial_investigation.


# Removed in 0.7: xeo:Transactional. Use the xeos:searchIntent concept transactional.


xeo:targetsIntent a owl:ObjectProperty ;
    rdfs:range xeo:SearchIntent ;
    xeo:xeoLayer "interpretation" ;
    dct:description "A URL or Prompt is aimed at this intent. A strategist's or model's claim — carries method and confidence." ;
    rdfs:label "targets intent" .

# --- Website conversions (from xeo-engagement.ttl) -------------------------------------
# A ConversionPoint is the on-page mechanism; a ConversionEvent is a visitor's action
# on one, recorded by the capturing system. Not a CRM record, which may follow.

xeo:ConversionPoint a owl:Class ;
    rdfs:label "Conversion Point" ;
    xeo:xeoLayer "entity" ;
    dct:description "A durable on-page mechanism that turns attention into a pipeline event. Identified by the URL it sits on and its form id or selector. Its kind is conversionPointType." .

# Removed in 0.7: xeo:CallToAction. Use conversionPointType cta.





# Removed in 0.7: xeo:LeadCaptureForm. Use conversionPointType lead_form.





# Removed in 0.7: xeo:GatedAsset. Use conversionPointType gated_asset.





xeo:conversionPointType a owl:DatatypeProperty ;
    rdfs:label "conversion point type" ;
    rdfs:domain xeo:ConversionPoint ; rdfs:range xsd:string ;
    xeo:xeoLayer "entity" ;
    dct:description "The kind of mechanism a ConversionPoint is, as a code from a slotted-in scheme (cta, lead_form, gated_asset, meeting_booker, chat — xeos:conversionPointType is a published reference filling). One per ConversionPoint. Says with a value what the CallToAction, LeadCaptureForm and GatedAsset subclasses said with a class, so a new kind of mechanism is a new code and not a new term." .

xeo:hasConversionPoint a owl:ObjectProperty ;
    rdfs:domain xeo:URL ; rdfs:range xeo:ConversionPoint ;
    xeo:xeoLayer "observation" ;
    dct:description "Observed presence of a conversion point on a page (crawl-attributed, bitemporal like linksTo)." ;
    rdfs:label "has conversion point" ;
    xeo:groundedIn "The page's markup as one crawl fetched it (WHATWG HTML: the form, a and button elements)" .

xeo:ConversionEvent a owl:Class ;
    rdfs:label "Conversion Event" ;
    xeo:xeoLayer "episode" ;
    dct:description "A submission/click/unlock that happened at a time: a visitor's action on a ConversionPoint, recorded by the capturing system. Immutable once recorded. Identified by the capturing system and its submission id; one per submission. Not the creation of a CRM record, which may follow, be merged into an existing record, or never happen: events are not leads." .

xeo:capturedBy a owl:ObjectProperty ;
    rdfs:domain xeo:ConversionEvent ; rdfs:range xeo:ConversionPoint ;
    xeo:xeoLayer "observation" ;
    dct:description "The conversion point this event happened at." ;
    rdfs:label "captured by" ;
    xeo:groundedIn "The capturing system's submission payload (per-vendor form or event API contract)" .

xeo:occurredAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;  # domain-free since v0.6.0 (was xeo:ConversionEvent): xeo:ExternalEvent carries it too.
    xeo:xeoLayer "episode" ;
    dct:description "When an event happened: a ConversionEvent, an ExternalEvent. Domain left open so any dated event can carry it. In UTC, as recorded by the system that captured the event." ;
    rdfs:label "occurred at" .

# --- Money (from xeo-engagement.ttl) ----------------------------------------------------

xeo:currencyCode a owl:DatatypeProperty ;
    rdfs:label "currency code" ;
    rdfs:range xsd:string ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "ISO 4217 · the vendor's deal object API contract" ;
    xeo:canonicalStore "crm" ;
    dct:description "The ISO 4217 code (three upper-case letters) of the amount it travels with: a dealAmount, or the value of a currency MetricReading. Where a CRM runs in one currency and has no field for it, the account's currency is stated here. A vendor's internal currency id is not a code and is resolved to one first." .

xeo:recurringValue a owl:DatatypeProperty ;
    rdfs:label "recurring value" ;
    rdfs:range xsd:decimal ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "The vendor's deal object API contract (recurring revenue fields)" ;
    xeo:canonicalStore "crm" ;
    xeo:termStatus "extension" ;
    dct:description "The recurring revenue a CRM records for a deal, per billing period (billingInterval and billingIntervalCount), in the deal's currency. Distinct from dealAmount and never added to it. Always travels with billingInterval." .

# Removed in 0.7: xeo:valuePeriod. Use billingInterval with billingIntervalCount.








xeo:amountInReportingCurrency a owl:DatatypeProperty ;
    rdfs:label "amount in reporting currency" ;
    rdfs:range xsd:decimal ;
    xeo:xeoLayer "derivation" ;
    xeo:canonicalStore "crm" ;
    xeo:termStatus "extension" ;
    dct:description "A dealAmount converted into the account's reporting currency. A derivation: the result depends on the rate, the date the rate was taken on and where it came from, and method states all three. CRMs differ on which rate they use for an open deal and a closed one, so totals for the same deals differ between systems." .

# --- Metrics (from xeo-metrics.ttl) ------------------------------------------------------
# What a metric is, and what a number of one is.
#
#   Metric {metricType, aggregation, readsSlot, unit, betterDirection, additivity}   (the rule)
#   MetricReading {readingOf, scope, periodStart, periodEnd, value, source}          (a number)
#
# TWO THINGS, KEPT APART. A Metric is a definition: a standing rule over a class
# of numbers, and so a NORM. A MetricReading is the value that rule took over
# one window, for one scope, from one source. Editing a definition in place
# silently changes what every stored reading and target means, so a Metric is
# never edited: a changed rule is a new Metric.
#
# RATES ARE QUOTIENTS, ROLLED UP FROM THEIR PARTS. A ratio is stored as a 0 to 1
# quotient, never a percentage. A rolled-up ratio is sum(numerator) divided by
# sum(denominator), never a mean of rates, which is why a ratio reading carries
# numeratorValue and denominatorValue.
#
# VENDOR NAMES ARE NOT XEO NAMES. The Metric instances published in xeos:metric
# (xeo-schemes.ttl) are defined neutrally; each vendor's field is mapped to one
# of them in mappings/ (one file per tool).

# --- Metric classes ----------------------------------------------------------------

xeo:Metric a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Metric" ;
    xeo:xeoLayer "norm" ;
    xeo:canonicalStore "neo4j" ;
    dct:description "A named, reusable definition of a measured quantity: what is counted or computed, over which records, aggregated how, in what unit, and which way is better. A rule, not a number: the number is a MetricReading. One node per definition, identified by its skos:notation within its scheme (xeos:metric is the published reference scheme). Two Metrics are the same when metricType, aggregation, readsSlot or inputs, metricFilter, timeAnchor and unit all match; changing any of them makes a new Metric, never an edit, because readings and targets are anchored to the definition. Carries exactly one metricType, unit, betterDirection and additivity. A simple metric also carries aggregation and readsSlot; a ratio carries numerator and denominator and has unit ratio; a derived metric carries expression and at least one inputMetric. A skos:Concept, so a consumer adds its own metrics as instances without touching the ontology." .

xeo:MetricReading a owl:Class ;
    rdfs:label "Metric Reading" ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "The API contract of the system named in the reading's source (e.g. GSC searchAnalytics.query, GA4 runReport)" ;
    xeo:canonicalStore "bigquery" ;
    dct:description "The value one Metric took over one window, for one scope, from one source. One row per metric, scope, window and source: its identity is readingOf, scope, periodStart, periodEnd, source and, where the source deduplicates in more than one way, aggregationBasis. Requires value, periodStart, periodEnd and readingOf, and may carry websiteId and datasetUri; a ratio reading also carries numeratorValue and denominatorValue. An observation only when the primary API returned exactly that metric, window and scope. When the value was rolled up, recomputed, or taken from a vendor's model, the reading is a derivation and carries method and confidence. High-cardinality readings live in the column store; the graph holds the windowed readings a target, an Outcome or an Objective points at." .

# --- The definition: object properties ----------------------------------------

xeo:metricType a owl:ObjectProperty ;
    rdfs:label "metric type" ;
    rdfs:domain xeo:Metric ; rdfs:range skos:Concept ;
    xeo:xeoLayer "norm" ;
    xeo:canonicalStore "neo4j" ;
    dct:description "How a Metric is computed, as a slotted-in concept (simple, ratio, derived, cumulative, conversion — xeos:metricType is a published reference filling). Exactly one per Metric. The type decides which other properties are required: a simple metric aggregates one slot, a ratio divides one metric by another, a derived metric is arithmetic over others." .

xeo:aggregation a owl:ObjectProperty ;
    rdfs:label "aggregation" ;
    rdfs:domain xeo:Metric ; rdfs:range skos:Concept ;
    xeo:xeoLayer "norm" ;
    xeo:canonicalStore "neo4j" ;
    dct:description "How a simple Metric reduces the values of its readsSlot in a window to one number, as a slotted-in concept (sum, count, count_distinct, mean, weighted_mean, min, max, median, percentile, last — xeos:aggregation is a published reference filling). Required on a simple metric and absent on the others. 'count' is also a unit; this slot says how the values are combined, unit says what the result is a number of." .

xeo:readsSlot a owl:ObjectProperty ;
    rdfs:label "reads slot" ;
    rdfs:domain xeo:Metric ; rdfs:range rdf:Property ;
    xeo:xeoLayer "norm" ;
    xeo:canonicalStore "neo4j" ;
    dct:description "The XEO property a simple Metric aggregates: clicks, dealAmount, mentionRank. Required on a simple metric. If the slot is a derivation, every reading of the metric is a derivation. Where XEO declares no slot beneath the number, because the source returns it already aggregated (an analytics tool's sessions, a vendor's modelled traffic value), readsSlot is xeo:value: the metric combines the source's own readings, and the vendor scheme says which field that is." .

xeo:numerator a owl:ObjectProperty ;
    rdfs:label "numerator" ;
    rdfs:domain xeo:Metric ; rdfs:range xeo:Metric ;
    xeo:xeoLayer "norm" ;
    xeo:canonicalStore "neo4j" ;
    dct:description "The Metric a ratio divides. Required on a ratio, with denominator. A filter on the numerator does not apply to the denominator unless it is declared there too. A ratio is rolled up as sum(numerator) divided by sum(denominator), never as a mean of ratios." .

xeo:denominator a owl:ObjectProperty ;
    rdfs:label "denominator" ;
    rdfs:domain xeo:Metric ; rdfs:range xeo:Metric ;
    xeo:xeoLayer "norm" ;
    xeo:canonicalStore "neo4j" ;
    dct:description "The Metric a ratio divides by. Required on a ratio, with numerator. Two tools that share a metric's name and differ in its denominator are reporting two different metrics." .

xeo:inputMetric a owl:ObjectProperty ;
    rdfs:label "input metric" ;
    rdfs:domain xeo:Metric ; rdfs:range xeo:Metric ;
    xeo:xeoLayer "norm" ;
    xeo:canonicalStore "neo4j" ;
    dct:description "A Metric a derived metric is computed from. At least one on a derived metric, each named by its notation in expression." .

xeo:timeAnchor a owl:ObjectProperty ;
    rdfs:label "time anchor" ;
    rdfs:domain xeo:Metric ; rdfs:range rdf:Property ;
    xeo:xeoLayer "norm" ;
    xeo:canonicalStore "neo4j" ;
    dct:description "Which timestamp places a record in a window: recordCreatedAt or dealClosedAt for a deal, capturedAt for a sampled answer. Part of a Metric's identity: deals counted by create date and by close date are two metrics. Absent where the source places records itself and offers no choice." .

xeo:unit a owl:ObjectProperty ;
    rdfs:label "unit" ;
    rdfs:domain xeo:Metric ; rdfs:range skos:Concept ;
    xeo:xeoLayer "norm" ;
    xeo:canonicalStore "neo4j" ;
    dct:description "What a reading of this Metric is a number of, as a slotted-in concept (count, ratio, rank, currency, seconds, days, score_0_100 — xeos:metricUnit is a published reference filling). Exactly one per Metric. A ratio is a 0 to 1 quotient, never a percentage. A rank is 1-based with 1 best. A currency reading carries currencyCode. Distinct from magnitudeUnit, which names the unit of a Gap's size." .

xeo:betterDirection a owl:ObjectProperty ;
    rdfs:label "better direction" ;
    rdfs:domain xeo:Metric ; rdfs:range skos:Concept ;
    xeo:xeoLayer "norm" ;
    xeo:canonicalStore "neo4j" ;
    dct:description "Which way a change in this Metric counts as improvement, as a slotted-in concept (up, down, none — xeos:betterDirection is a published reference filling). Exactly one per Metric, declared here and nowhere else: positions and ranks are 1-based, so a shared '+20%' would ask for a rank 20% worse. A change is recorded signed and raw; whether it is an improvement is read through this. Replaces xeo:direction, which stored a copy on each target." .

xeo:additivity a owl:ObjectProperty ;
    rdfs:label "additivity" ;
    rdfs:domain xeo:Metric ; rdfs:range skos:Concept ;
    xeo:xeoLayer "norm" ;
    xeo:canonicalStore "neo4j" ;
    dct:description "Whether readings of this Metric may be summed across windows, pages or terms, as a slotted-in concept (additive, semi_additive, non_additive — xeos:additivity is a published reference filling). Exactly one per Metric. A non-additive reading (a ratio, an average, a rank, a distinct count) is never summed: it is recomputed over the union from the column store." .

# --- The definition: datatype properties ----------------------------------------

xeo:expression a owl:DatatypeProperty ;
    rdfs:label "expression" ;
    rdfs:domain xeo:Metric ; rdfs:range xsd:string ;
    xeo:xeoLayer "norm" ;
    xeo:canonicalStore "neo4j" ;
    dct:description "On a derived Metric: the arithmetic over its inputMetrics, each named by its notation ('revenue_won / deals_won'). Required on a derived metric. On a simple Metric it may state a row-level computation applied before aggregation, where the number is not the slot's own value ('days from recordCreatedAt to dealClosedAt'). Plain arithmetic in neutral names, never a vendor's query syntax." .

xeo:metricFilter a owl:DatatypeProperty ;
    rdfs:label "metric filter" ;
    rdfs:domain xeo:Metric ; rdfs:range xsd:string ;
    xeo:xeoLayer "norm" ;
    xeo:canonicalStore "neo4j" ;
    dct:description "A condition applied to the records before they are aggregated, over neutral names (dealOutcome = 'won'; firstTouchChannel = 'ai_assistant'). Part of the Metric's identity: sessions and sessions from AI assistants are two metrics. Distinct from scope, which belongs to a reading and restricts numerator and denominator alike; a metricFilter on a numerator restricts only that numerator." .

xeo:minDenominator a owl:DatatypeProperty ;
    rdfs:label "minimum denominator" ;
    rdfs:domain xeo:Metric ; rdfs:range xsd:integer ;
    xeo:xeoLayer "norm" ;
    xeo:canonicalStore "neo4j" ;
    dct:description "The smallest denominatorValue at which a reading of this Metric is reportable: for a ratio the denominator, for a mean the number of values averaged. A reading below it is flagged, and an Outcome read from it is inconclusive with resultReason below_volume_floor. An XEO norm: no vendor publishes one. A slot only: XEO ships no value, and the Metrics in xeos:metric carry none. Each implementation sets its own." .

# --- The reading -----------------------------------------------------------------

xeo:readingOf a owl:ObjectProperty ;
    rdfs:label "reading of" ;
    rdfs:domain xeo:MetricReading ; rdfs:range xeo:Metric ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "The API contract of the system named in the reading's source" ;
    xeo:canonicalStore "bigquery" ;
    dct:description "The Metric this reading is a value of. Exactly one per reading. Two readings are comparable only when this matches: a changed definition is a new Metric, and its readings are not continued from the old one's." .

xeo:scope a owl:ObjectProperty ;
    rdfs:label "scope" ;
    rdfs:domain xeo:MetricReading ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "The API contract of the system named in the reading's source" ;
    xeo:canonicalStore "bigquery" ;
    xeo:rangeIncludes xeo:Website , xeo:URL , xeo:Term , xeo:Topic , xeo:Prompt , xeo:Brand , xeo:Campaign ;
    dct:description "What the reading covers: a whole Website, one URL or Term, a Topic, a Prompt, a Brand, or the pages and terms of a Campaign. Many per reading where the scope is a set. Range left open across the terms listed. Restricts numerator and denominator alike, which is what separates it from metricFilter. A baseline reading and a result reading are comparable only over the same scope." .

xeo:value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    rdfs:domain xeo:MetricReading ; rdfs:range xsd:decimal ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "The API contract of the system named in the reading's source" ;
    xeo:canonicalStore "bigquery" ;
    dct:description "The number the Metric took over the reading's window and scope, in the Metric's unit: a ratio as a 0 to 1 quotient, a rank 1-based, a currency amount in the reading's currencyCode. Exactly one per reading. A rate the source computed itself goes here as returned; its parts, where the source gives them, go in numeratorValue and denominatorValue." .

xeo:numeratorValue a owl:DatatypeProperty ;
    rdfs:label "numerator value" ;
    rdfs:domain xeo:MetricReading ; rdfs:range xsd:decimal ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "The API contract of the system named in the reading's source" ;
    xeo:canonicalStore "bigquery" ;
    dct:description "The numerator behind a ratio or mean reading: the clicks behind a clickthrough rate, the summed positions behind an average. With denominatorValue it is what lets readings be rolled up correctly, as sum(numeratorValue) divided by sum(denominatorValue)." .

xeo:denominatorValue a owl:DatatypeProperty ;
    rdfs:label "denominator value" ;
    rdfs:domain xeo:MetricReading ; rdfs:range xsd:decimal ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "The API contract of the system named in the reading's source" ;
    xeo:canonicalStore "bigquery" ;
    dct:description "The denominator behind a ratio reading, or the number of values behind a mean. Compared with the Metric's minDenominator to decide whether the reading is reportable." .

# --- Extension set -----------------------------------------------------------------
# Declared and usable; not something a consumer is expected to implement. Each
# is supported by one to three of the surveyed standards, or is an XEO norm.

xeo:offsetWindow a owl:DatatypeProperty ;
    rdfs:label "offset window" ;
    rdfs:domain xeo:Metric ; rdfs:range xsd:duration ;
    xeo:xeoLayer "norm" ;
    xeo:canonicalStore "neo4j" ;
    xeo:termStatus "extension" ;
    dct:description "A lag applied to the input of a derived Metric, as an ISO 8601 duration (P28D): the input is read over the window that long before the reading's own. How a period-over-period metric is defined once instead of being recomputed by each client." .

xeo:cumulativeWindow a owl:DatatypeProperty ;
    rdfs:label "cumulative window" ;
    rdfs:domain xeo:Metric ; rdfs:range xsd:duration ;
    xeo:xeoLayer "norm" ;
    xeo:canonicalStore "neo4j" ;
    xeo:termStatus "extension" ;
    dct:description "The trailing window a cumulative Metric accumulates over, as an ISO 8601 duration (P7D for a trailing seven days). Absent on a cumulative metric that accumulates from the start of a grain; that one carries grainToDate." .

xeo:grainToDate a owl:ObjectProperty ;
    rdfs:label "grain to date" ;
    rdfs:domain xeo:Metric ; rdfs:range skos:Concept ;
    xeo:xeoLayer "norm" ;
    xeo:canonicalStore "neo4j" ;
    xeo:termStatus "extension" ;
    dct:description "The grain at whose start a cumulative Metric resets, as a slotted-in concept (day, week, month, quarter, year — xeos:timeGrain is a published reference filling): month for a month-to-date total. Used instead of cumulativeWindow, never with it." .

xeo:conversionEntity a owl:ObjectProperty ;
    rdfs:label "conversion entity" ;
    rdfs:domain xeo:Metric ; rdfs:range rdf:Property ;
    xeo:xeoLayer "norm" ;
    xeo:canonicalStore "neo4j" ;
    xeo:termStatus "extension" ;
    dct:description "On a conversion Metric: the identity key that joins a base event to the conversion event that followed it (crmRecordRef, for a lead that became a deal). The metric is the share of that entity's base events followed by a conversion event within conversionWindow." .

xeo:conversionWindow a owl:DatatypeProperty ;
    rdfs:label "conversion window" ;
    rdfs:domain xeo:Metric ; rdfs:range xsd:duration ;
    xeo:xeoLayer "norm" ;
    xeo:canonicalStore "neo4j" ;
    xeo:termStatus "extension" ;
    dct:description "On a conversion Metric: how long after a base event a conversion event still counts, as an ISO 8601 duration." .

xeo:baseMetric a owl:ObjectProperty ;
    rdfs:label "base metric" ;
    rdfs:domain xeo:Metric ; rdfs:range xeo:Metric ;
    xeo:xeoLayer "norm" ;
    xeo:canonicalStore "neo4j" ;
    xeo:termStatus "extension" ;
    dct:description "On a conversion Metric: the Metric that counts the base events, the ones a conversion may follow." .

xeo:conversionMetric a owl:ObjectProperty ;
    rdfs:label "conversion metric" ;
    rdfs:domain xeo:Metric ; rdfs:range xeo:Metric ;
    xeo:xeoLayer "norm" ;
    xeo:canonicalStore "neo4j" ;
    xeo:termStatus "extension" ;
    dct:description "On a conversion Metric: the Metric that counts the conversion events." .

xeo:percentileValue a owl:DatatypeProperty ;
    rdfs:label "percentile value" ;
    rdfs:domain xeo:Metric ; rdfs:range xsd:decimal ;
    xeo:xeoLayer "norm" ;
    xeo:canonicalStore "neo4j" ;
    xeo:termStatus "extension" ;
    dct:description "Which percentile a Metric whose aggregation is percentile takes, from 0 to 1 (0.9 for the ninetieth). Required with that aggregation and meaningless with any other." .

xeo:agentContext a owl:DatatypeProperty ;
    rdfs:label "agent context" ;
    rdfs:domain xeo:Metric ; rdfs:range xsd:string ;
    xeo:xeoLayer "norm" ;
    xeo:canonicalStore "neo4j" ;
    xeo:termStatus "extension" ;
    dct:description "Guidance to an agent on when to use this Metric and when not to, in plain language: what it is commonly mistaken for, which question it answers. Read by a model choosing between metrics; it does not change how the metric is computed." .

xeo:aggregationBasis a owl:ObjectProperty ;
    rdfs:label "aggregation basis" ;
    rdfs:domain xeo:MetricReading ; rdfs:range skos:Concept ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "Google Search Console Search Analytics API (aggregationType)" ;
    xeo:canonicalStore "bigquery" ;
    xeo:termStatus "extension" ;
    dct:description "How the source deduplicated before it returned the value, as a slotted-in concept (by_property, by_page, auto — xeos:aggregationBasis is a published reference filling). One source documents it, and there it moves every search number: clicks counted by page and by property are different counts under one field name. Part of a reading's identity where the source offers the choice; two readings on different bases are not comparable. Not xeo:basis, which says what a similarity compared." .

xeo:dataState a owl:ObjectProperty ;
    rdfs:label "data state" ;
    rdfs:domain xeo:MetricReading ; rdfs:range skos:Concept ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "Google Search Console Search Analytics API (dataState), as reported by a secondary source" ;
    xeo:canonicalStore "bigquery" ;
    xeo:termStatus "extension" ;
    dct:description "Whether the source considered the reading's window complete when it answered, as a slotted-in concept (final, partial — xeos:dataState is a published reference filling). A partial reading is expected to change and should not anchor a baseline. Absent where the source does not say." .

# --- v0.7.0 (grounding, 2026-11-12) ---------------------------------------------
# Appended at the foot, so no line above moves. Every observation names what it
# is grounded in; these 6 did not. Nothing else about them changes.

xeo:fetchedAt xeo:groundedIn "The crawler's fetch log: when the HTTP response (RFC 9110) was received" .
xeo:firstSeenAt xeo:groundedIn "The crawl records in which the edge was observed (each Crawl's own run log)" .
xeo:lastSeenAt xeo:groundedIn "The crawl records in which the edge was observed (each Crawl's own run log)" .
xeo:hasResult xeo:groundedIn "The engine's results page as one SerpSnapshot captured it (the provider's SERP API contract, or the rendered page)" .
xeo:position xeo:groundedIn "The engine's results page as one SerpSnapshot captured it (the provider's SERP API contract, or the rendered page)" .
xeo:resultType xeo:groundedIn "The engine's results page as one SerpSnapshot captured it (the provider's result-type field, mapped to xeos:serpResultType)" .

# --- v0.7.0 (core additions, 2026-11-12) ---------------------------------------------
# Appended at the foot, so no line above moves. From the 0.7 plan of record and
# Jim's answers of 12 November.
#
# ENGINES (C3). Engine stays, as the parent class only: every engine node is one
# of its subtypes. SearchEngine is here; GenerativeOverview (was GenerativeEngine)
# and AnswerEngine (which absorbs ConversationalAgent) are in visibility.
#
# MODEL. A model is a thing with a family, a dated build and a kind, so it is a
# node. modelVersion is redefined on it: the dated build. The plain model text
# field stays, for imports that only give a name.
#
# CONSENT. One recorded choice, for one purpose, by one subject, as one system
# captured it. Always keep history: a new choice is a new Consent, never an edit,
# and the current status is the latest for that subject and purpose. Whether a
# choice is valid under a law is an interpretation made elsewhere.
#
# MONEY. billingInterval and billingIntervalCount replace valuePeriod (D3):
# quarterly is month and 3.
#
# INBOUND REFERENCES (C6). A page on another site that links to or mentions you,
# however it came about. How it came about (placed, pitched, a link magnet) is a
# Tactic, linked from decision with acquiredByTactic; organic references have
# none.

xeo:Model a owl:Class ;
    rdfs:label "Model" ;
    xeo:xeoLayer "entity" ;
    dct:description "A machine-learning model as a durable thing: one node per build (claude-opus-5-5 as of a given date, a BERT checkpoint, a ranking model). Carries modelFamily, modelVersion and modelKind; optionally its architecture, size and where it runs. An AI answer or a model call points at the Model that produced it with producedByModel. Distinct from the plain model text field, which only names one." .

xeo:modelFamily a owl:DatatypeProperty ;
    rdfs:label "model family" ;
    rdfs:domain xeo:Model ; rdfs:range xsd:string ;
    xeo:xeoLayer "entity" ;
    dct:description "The family a Model belongs to, as its provider names it: Claude, GPT, Gemini, BERT. One per Model." .

xeo:modelVersion a owl:DatatypeProperty ;
    rdfs:label "model version" ;
    rdfs:range xsd:string ;
    xeo:domainIncludes xeo:Model ;
    xeo:xeoLayer "entity" ;
    dct:description "The dated build of a Model, as its provider names it (a version string or a dated snapshot id). One per Model. Redefined in 0.7: until then it was a text field on an LLMResponse naming the build that answered; that is now the response's producedByModel link to a Model carrying this." .

xeo:modelKind a owl:DatatypeProperty ;
    rdfs:label "model kind" ;
    rdfs:domain xeo:Model ; rdfs:range xsd:string ;
    xeo:xeoLayer "entity" ;
    dct:description "What a Model does, as a code from a slotted-in scheme (language, embedding, image, classifier, decision, reranker — xeos:modelKind is a published reference filling). One per Model." .

xeo:producedByModel a owl:ObjectProperty ;
    rdfs:label "produced by model" ;
    rdfs:range xeo:Model ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "The provider's API response (its model field)" ;
    dct:description "The Model that produced an AI answer or a model call, as the provider reported it. Domain left open: an LLMResponse, a model call, or a derivation edge's run can carry it. The text field model may sit beside it for a source that gives only a name." .

xeo:Consent a owl:Class ;
    rdfs:label "Consent" ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "The capturing system's consent record: a consent banner's log, a CRM's or an ad platform's consent field or API (e.g. Google Consent Mode, Hyros adOptimizationConsent)" ;
    dct:description "One recorded consent choice, for one purpose (consentPurpose), by one subject (consentSubject), as one system captured it (consentCapturedBy), with its status and when it was recorded. A new choice is a new Consent, never an edit; the current status for a subject and purpose is the latest. Company-level choices, such as not using a company's data to train models, sit on the Organization. Validity under any law is an interpretation made elsewhere, not part of this record." .

xeo:consentSubject a owl:ObjectProperty ;
    rdfs:label "consent subject" ;
    rdfs:domain xeo:Consent ;
    xeo:rangeIncludes xeo:Person , xeo:Organization ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "The capturing system's consent record: a consent banner's log, a CRM's or an ad platform's consent field or API (e.g. Google Consent Mode, Hyros adOptimizationConsent)" ;
    dct:description "The Person or Organization a Consent is about. Exactly one per Consent." .

xeo:consentPurpose a owl:DatatypeProperty ;
    rdfs:label "consent purpose" ;
    rdfs:domain xeo:Consent ; rdfs:range xsd:string ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "The capturing system's consent record: a consent banner's log, a CRM's or an ad platform's consent field or API (e.g. Google Consent Mode, Hyros adOptimizationConsent)" ;
    dct:description "What the choice is for, as a code from a slotted-in scheme (analytics_cookies, ad_storage, ad_user_data, ad_personalization, model_training, ai_data_use, email_marketing, other — xeos:consentPurpose is a published reference filling). Exactly one per Consent; a vendor's purposes are mapped to these in mappings/." .

xeo:consentStatus a owl:DatatypeProperty ;
    rdfs:label "consent status" ;
    rdfs:domain xeo:Consent ; rdfs:range xsd:string ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "The capturing system's consent record: a consent banner's log, a CRM's or an ad platform's consent field or API (e.g. Google Consent Mode, Hyros adOptimizationConsent)" ;
    dct:description "The choice recorded: granted, denied or unspecified (xeos:consentStatus). Exactly one per Consent." .

xeo:consentRecordedAt a owl:DatatypeProperty ;
    rdfs:label "consent recorded at" ;
    rdfs:domain xeo:Consent ; rdfs:range xsd:dateTime ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "The capturing system's consent record: a consent banner's log, a CRM's or an ad platform's consent field or API (e.g. Google Consent Mode, Hyros adOptimizationConsent)" ;
    dct:description "When the capturing system recorded the choice, in UTC. Exactly one per Consent." .

xeo:consentCapturedBy a owl:DatatypeProperty ;
    rdfs:label "consent captured by" ;
    rdfs:domain xeo:Consent ; rdfs:range xsd:string ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "The capturing system's consent record: a consent banner's log, a CRM's or an ad platform's consent field or API (e.g. Google Consent Mode, Hyros adOptimizationConsent)" ;
    dct:description "The system that recorded the choice, as a code: a consent banner product, a CRM, an ad platform, an attribution tool. Not capturedBy, which links a ConversionEvent to the ConversionPoint it happened at." .

xeo:consentSource a owl:DatatypeProperty ;
    rdfs:label "consent source" ;
    rdfs:domain xeo:Consent ; rdfs:range xsd:string ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "The capturing system's consent record: a consent banner's log, a CRM's or an ad platform's consent field or API (e.g. Google Consent Mode, Hyros adOptimizationConsent)" ;
    dct:description "How the choice reached the capturing system, as a code from a slotted-in scheme (banner, form, contract, api, inferred_default — xeos:consentSource is a published reference filling). inferred_default says no one chose: the system applied its default." .

xeo:billingInterval a owl:DatatypeProperty ;
    rdfs:label "billing interval" ;
    rdfs:range xsd:string ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "The vendor's deal, subscription or price API contract (its interval and interval-count fields)" ;
    dct:description "The unit a recurring amount recurs over, as a code from a slotted-in scheme (day, week, month, year — xeos:billingInterval is a published reference filling). With billingIntervalCount: quarterly is month and 3. Travels with recurringValue, or on a subscription. Replaces valuePeriod (0.7)." .

xeo:billingIntervalCount a owl:DatatypeProperty ;
    rdfs:label "billing interval count" ;
    rdfs:range xsd:positiveInteger ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "The vendor's deal, subscription or price API contract (its interval and interval-count fields)" ;
    dct:description "How many billingIntervals make one billing period: 1 for monthly, 3 for quarterly. Absent means 1." .

xeo:InboundReference a owl:Class ;
    rdfs:label "Inbound Reference" ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "The other site's page as a crawl or a backlink index fetched it (WHATWG HTML: the a element, or the page text)" ;
    dct:description "A page on another site that links to or mentions you: your URL, Website, Brand or Organization. Observed, however it came about. Carries referencingUrl (the page), referenceTarget (what it points at or names), referenceKind (link or mention), and firstSeenAt and lastSeenAt; anchorText where it is a link. How it came about is not part of it: a placement, a pitch or a link magnet is a Tactic, linked from decision with acquiredByTactic, and an organic reference has none. A link between two pages of sites you crawl is linksTo; this is the record of a reference to you, kept whether or not you crawl the other site." .

xeo:referencingUrl a owl:ObjectProperty ;
    rdfs:label "referencing URL" ;
    rdfs:domain xeo:InboundReference ; rdfs:range xeo:URL ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "The other site's page as a crawl or a backlink index fetched it" ;
    dct:description "The page on the other site that carries the link or the mention. Exactly one per InboundReference." .

xeo:referenceTarget a owl:ObjectProperty ;
    rdfs:label "reference target" ;
    rdfs:domain xeo:InboundReference ;
    xeo:rangeIncludes xeo:URL , xeo:Website , xeo:Brand , xeo:Organization ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "The other site's page as a crawl or a backlink index fetched it" ;
    dct:description "What the reference points at or names: one of your URLs (a link), or your Website, Brand or Organization (a mention). One or more per InboundReference." .

xeo:referenceKind a owl:DatatypeProperty ;
    rdfs:label "reference kind" ;
    rdfs:domain xeo:InboundReference ; rdfs:range xsd:string ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "The other site's page as a crawl or a backlink index fetched it (WHATWG HTML: the a element, or the page text)" ;
    dct:description "Whether the reference is a link or a mention without a link, as a code (xeos:referenceKind). Exactly one per InboundReference." .
