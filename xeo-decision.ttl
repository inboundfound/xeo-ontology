@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xeo:  <https://xeoontology.org/xeo#> .

# XEO Decision module — the interpretation tier, made first-class.
#
# The top stratum of the core sample: the most interpretive layer, where an
# observed condition becomes a diagnosed Gap, a Gap becomes candidate Tactics,
# the scope gate filters them to what is in reach, prior Experiments say which
# tactic has earned trust, and a Recommendation is issued — labeled, honestly,
# as an interpretation.
#
#   observation  ->  Diagnostic reveals Gap  ->  Gap addressableBy Tactic
#                ->  Tactic requiresCapability (the scope gate)
#                ->  Experiment tests Tactic, inContext Gap, producedOutcome
#                ->  Recommendation recommends Tactic, closesGap, supportedBy Experiment
#
# DISCIPLINE (the whole point): this module ships CLASSES, never VALUES. `Gap`
# and `Tactic` are here; "Citation-Waterfall stage" and "publish a comparison
# page" are not — those are skos:Concepts and instances you slot in. The
# specific tactic dimensions (impact / risk / time-to-value), how they are
# weighted, and the rules that constrain an approach under given conditions live
# one layer higher still — a strategy/agency config layer this module
# deliberately leaves open. (It exists: the Practices at the foot of this file.)
#
# One dependency, declared honestly: unlike core/visibility/engagement (which
# stand alone on primary web standards), this module uses SKOS as its
# taxonomy-slot primitive — skos:Concept is where your interventions, gap types,
# dimensions, and priorities plug in. That is the one place a foundational
# standard is load-bearing here rather than an optional bridge.
#
# Every term is interpretation- or derivation-tier (Experiment/Outcome carry an
# observational core): an agent assembling only falsifiable context filters this
# entire module out.

# --- Classes ----------------------------------------------------------------

xeo:Diagnostic a owl:Class ;
    rdfs:label "Diagnostic" ;
    xeo:xeoLayer "entity" ;
    dct:description "A named, reusable check or framework that reads observations and reveals gaps (e.g. a waterfall-position assessment). The framework is durable; each finding it produces is a Gap." .

xeo:Gap a owl:Class ;
    rdfs:label "Gap" ;
    xeo:xeoLayer "interpretation" ;
    dct:description "A diagnosed deficit between current and desired visibility. First-order, but a claim: asserted by a Diagnostic from evidence, never observed directly. Its kind (gapType) is a slotted-in skos:Concept — e.g. a Citation-Waterfall stage — not a subclass baked into the ontology." .

xeo:Capability a owl:Class ;
    rdfs:label "Capability" ;
    xeo:xeoLayer "entity" ;
    dct:description "A lever or strength a party can bring to bear (content, technical, PR, brand, ...). The unit of the scope gate: a Tactic is in reach only when every Capability it requires is approved. Specific capabilities are instances, not subclasses." .

xeo:Tactic a owl:Class ;
    rdfs:label "Tactic" ;
    xeo:xeoLayer "entity" ;
    dct:description "A durable, named approach that can address gaps. Categorized by a slotted-in intervention taxonomy (inIntervention), scored on slotted-in dimensions (assessedAs -> TacticAssessment), and gated by the Capabilities it requires." .

xeo:Intervention a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Intervention" ;
    xeo:xeoLayer "entity" ;
    dct:description "A category of tactic in a controlled vocabulary you bring. A skos:Concept, so a whole intervention taxonomy slots in without touching the ontology." .

xeo:TacticAssessment a owl:Class ;
    rdfs:label "Tactic Assessment" ;
    xeo:xeoLayer "interpretation" ;
    dct:description "A scored estimate of a tactic on ONE dimension (onDimension), carrying score, method, and confidence. The dimension set (impact / risk / time-to-value, or ICE, or your own) and how dimensions are weighted are a strategy-layer concern; this class only records that an assessment was made, on what dimension, and by what method." .

xeo:Experiment a owl:Class ;
    rdfs:label "Experiment" ;
    xeo:xeoLayer "episode" ;
    dct:description "A test of a tactic that ran over a time window: immutable once concluded, method-attributed. The precedent record the decision layer learns from." .

xeo:Outcome a owl:Class ;
    rdfs:label "Outcome" ;
    xeo:xeoLayer "observation" ;
    dct:description "The measured result an experiment produced: the comparison of a resultReading against a baselineReading of one Metric over one scope, recorded as absoluteChange, relativeChange and result. The measurement is an observation; any claim that the tactic CAUSED it is an interpretation, carried on the Recommendation, not asserted here." .

xeo:Recommendation a owl:Class ;
    rdfs:label "Recommendation" ;
    xeo:xeoLayer "interpretation" ;
    dct:description "The labeled claim the whole chain exists to produce: deploy this Tactic to close this Gap, supported by these Experiments, at a given priority. An interpretation — carries method, confidence, and who/what issued it." .

# --- Object properties (the chain) ------------------------------------------

xeo:reveals a owl:ObjectProperty ;
    rdfs:domain xeo:Diagnostic ; rdfs:range xeo:Gap ;
    xeo:xeoLayer "interpretation" ;
    dct:description "A diagnostic asserts this gap. Carries the assessment method." .

xeo:evidencedBy a owl:ObjectProperty ;
    rdfs:domain xeo:Gap ;
    xeo:xeoLayer "derivation" ;
    dct:description "The observed facts a gap was derived from — a Prompt's visibilityFor rollup, a URL's ranksFor, a SerpSnapshot. The seam tying the interpretation tier back down to the substrate. Range left open: any observation-bearing term." .

xeo:gapType a owl:ObjectProperty ;
    rdfs:domain xeo:Gap ; rdfs:range skos:Concept ;
    xeo:xeoLayer "derivation" ;
    dct:description "The kind of gap, as a slotted-in concept (e.g. a Citation-Waterfall stage). Bring your own scheme." .

xeo:addressableBy a owl:ObjectProperty ;
    rdfs:domain xeo:Gap ; rdfs:range xeo:Tactic ;
    xeo:xeoLayer "interpretation" ;
    dct:description "A candidate tactic for closing this gap — a claim, made before the scope gate is applied." .

xeo:inIntervention a owl:ObjectProperty ;
    rdfs:domain xeo:Tactic ; rdfs:range xeo:Intervention ;
    xeo:xeoLayer "derivation" ;
    dct:description "The intervention category this tactic belongs to. Parallels core's inTopic." .

xeo:requiresCapability a owl:ObjectProperty ;
    rdfs:domain xeo:Tactic ; rdfs:range xeo:Capability ;
    xeo:xeoLayer "entity" ;
    dct:description "A capability that must be approved for this tactic to be in reach. The scope-gate edge: a tactic whose required capabilities are all approved is deployable; otherwise it stays advisory." .

xeo:assessedAs a owl:ObjectProperty ;
    rdfs:range xeo:TacticAssessment ;  # domain-free since v0.6.0 (was xeo:Tactic): a Recommendation is scored too.
    xeo:xeoLayer "interpretation" ;
    dct:description "Links a tactic to a per-dimension scored estimate. Domain left open since v0.6.0: a Recommendation may be assessed the same way, where what is scored is the call rather than the approach." .

xeo:onDimension a owl:ObjectProperty ;
    rdfs:domain xeo:TacticAssessment ; rdfs:range skos:Concept ;
    xeo:xeoLayer "interpretation" ;
    dct:description "The dimension being scored, as a slotted-in concept (impact, risk, time-to-value, ICE, RICE, ...). Bring your own dimension scheme." .

xeo:tests a owl:ObjectProperty ;
    rdfs:domain xeo:Experiment ; rdfs:range xeo:Tactic ;
    xeo:xeoLayer "episode" ;
    dct:description "The tactic this experiment put to the test." .

xeo:inContext a owl:ObjectProperty ;
    rdfs:domain xeo:Experiment ; rdfs:range xeo:Gap ;
    xeo:xeoLayer "observation" ;
    dct:description "The gap the experiment was run against. The precedent-similarity key: 'has this tactic worked on a gap like mine?' is a match on gapType through this edge." .

xeo:producedOutcome a owl:ObjectProperty ;
    rdfs:domain xeo:Experiment ; rdfs:range xeo:Outcome ;
    xeo:xeoLayer "observation" ;
    dct:description "The measured result this experiment generated." .

xeo:recommends a owl:ObjectProperty ;
    rdfs:domain xeo:Recommendation ; rdfs:range xeo:Tactic ;
    xeo:xeoLayer "interpretation" ;
    dct:description "The tactic this recommendation puts forward." .

xeo:closesGap a owl:ObjectProperty ;
    rdfs:domain xeo:Recommendation ; rdfs:range xeo:Gap ;
    xeo:xeoLayer "interpretation" ;
    dct:description "The gap this recommendation aims to close." .

xeo:supportedBy a owl:ObjectProperty ;
    rdfs:domain xeo:Recommendation ; rdfs:range xeo:Experiment ;
    xeo:xeoLayer "interpretation" ;
    dct:description "The precedent experiments backing this recommendation — the earned trust behind the pick." .

xeo:atPriority a owl:ObjectProperty ;
    rdfs:domain xeo:Recommendation ; rdfs:range skos:Concept ;
    xeo:xeoLayer "interpretation" ;
    dct:description "Priority as a slotted-in concept — bring your own scheme (P0/P1/P2, now/next/later, ...)." .

# --- Datatype properties -----------------------------------------------------
# Note: xeo:confidence is defined in xeo-core (a 0-1 derivation confidence) and
# is reused here on interpretation edges; it is not redeclared.

xeo:method a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    xeo:xeoLayer "interpretation" ;
    dct:description "How an interpretation or derivation was produced (model, rule, human analyst). Expected on reveals, assessedAs, and every Recommendation." .

xeo:score a owl:DatatypeProperty ;
    rdfs:domain xeo:TacticAssessment ; rdfs:range xsd:decimal ;
    xeo:xeoLayer "interpretation" ;
    dct:description "The value assigned on the assessed dimension. Scale is defined by the dimension scheme, not fixed here." .

xeo:approved a owl:DatatypeProperty ;
    rdfs:domain xeo:Capability ; rdfs:range xsd:boolean ;
    xeo:xeoLayer "interpretation" ;
    dct:description "Whether this capability is approved for the engagement — the live state of the scope gate. Tenancy-scoped like everything else." .

# Removed in 0.7: xeo:lift. Use absoluteChange and relativeChange on the Outcome.




xeo:concludedAt a owl:DatatypeProperty ;
    rdfs:domain xeo:Experiment ; rdfs:range xsd:dateTime ;
    xeo:xeoLayer "episode" ;
    dct:description "When the experiment concluded and its outcome became immutable." .

# --- Module header ----------------------------------------------------------
# At the foot of the file, not the head. Turtle is order-independent, so this
# parses exactly as it would at the top — and placing it here moves no line
# below it. launch-guardian and if-control-center cite this file by line number
# in 17 places; a header at the top would silently invalidate all of them at
# once. Same idiom as the IRIs appended in 6469d13. Move it up top the day those
# citations name terms instead of lines.

xeo:decision-module a owl:Ontology ;
    dct:title "XEO Decision (gaps, tactics, recommendations, and the rules that govern them)" ;
    dct:description "The top stratum of the core sample: where an observed condition becomes a diagnosed Gap, a Gap becomes candidate Tactics, the capability gate filters them to what is in reach, prior Experiments say which tactic has earned trust, and a Recommendation is issued — labeled, honestly, as an interpretation. Ships CLASSES, never VALUES. Since 0.7 it also holds what was xeo-strategy: the standing rules (Practices) that govern how a Recommendation may be made, the Playbooks they travel in, and Frameworks." ;
    dct:creator "Inbound Found" ;
    owl:versionInfo "0.7.0" .

# --- Gap disposition and size ------------------------------------------------
# Appended at the foot (line-stable for the consumers that cite this file by
# line number). What a Gap carries once an operator has looked at it: a verdict,
# and a magnitude in a stated unit. Values for both are published in
# xeo-schemes.ttl (gapVerdict, magnitudeUnit).

xeo:verdict a owl:ObjectProperty ;
    rdfs:range skos:Concept ;  # domain-free since v0.6.0 (was xeo:Gap): a Feedback carries a verdict of its own.
    xeo:xeoLayer "interpretation" ;
    dct:description "The operator's disposition on a diagnosed gap, as a slotted-in concept (attack, fix_first, defend, hold, ignore — see xeo-schemes). Distinct from gapType, which says what KIND of deficit it is; the verdict says what we intend to do about it. Carried by one finding per topic per analysis: it is a property of the topic's scoreboard row, not of every finding beneath it. The value vocabulary is subject-specific: on a Feedback the verdict is the operator's judgment of the claim (accepted, rejected, needs_work — xeos:feedbackVerdict), and the domain is left open for that reason." .

xeo:magnitude a owl:DatatypeProperty ;
    rdfs:domain xeo:Gap ; rdfs:range xsd:decimal ;
    xeo:xeoLayer "derivation" ;
    dct:description "How big the gap is, where the finding IS a size. Required together with magnitudeUnit and never alone: a magnitude with no unit is an uninterpretable number, a unit with no magnitude is noise." .

xeo:magnitudeUnit a owl:ObjectProperty ;
    rdfs:domain xeo:Gap ; rdfs:range skos:Concept ;
    xeo:xeoLayer "derivation" ;
    dct:description "The unit magnitude is read in, as a slotted-in concept (impressions, clicks, referring_domains, words, ... — see xeo-schemes). A unit that names its own provenance, like sessions_estimated, is how a derived figure is kept from rendering as a measured one. Where the size is a value of a Metric, magnitudeMetric names it." .

# --- Outcome reading -----------------------------------------------------------
# What an Outcome says once read: did it move, and if it could not be judged,
# why. Values published in xeo-schemes.ttl (outcomeResult, outcomeResultReason).

xeo:result a owl:DatatypeProperty ;
    rdfs:domain xeo:Outcome ; rdfs:range xsd:string ;
    xeo:xeoLayer "observation" ;
    dct:description "'significant', 'no_change' or 'inconclusive'. Answers DID THIS MOVE; the sign of absoluteChange answers which way. A regression is significant — the value never smuggles a direction in." .

xeo:resultReason a owl:DatatypeProperty ;
    rdfs:domain xeo:Outcome ; rdfs:range xsd:string ;
    xeo:xeoLayer "observation" ;
    dct:description "Why an outcome was inconclusive, from a small controlled set (window_incomplete, co_intervention, confounded_external, baseline_unavailable, ...). The two confounder reasons differ on purpose: a co-intervention keeps its measured change and shares attribution; an external confounder records none." .

# --- v0.6.0 (kit sync) ---------------------------------------------------------
# Appended at the foot (line-stable for the consumers that cite this file by
# line number).
#
# ADDED. The two terms the implementers named themselves and found missing:
# DiagnosticRun (the episode of a Diagnostic, as Crawl is the episode of a
# Website) and Feedback (an operator's judgment of a machine's claim). The
# experiment's design: what it treats, what it holds back as control, and the
# Recommendation it implements. ExternalEvent and confoundedBy, so "something
# outside our work changed the page" names the something. relativeTo, the
# competitor a Gap is measured against. suggests, a Diagnostic's usual response.
#
# WIDENED (in place, above). assessedAs lost `rdfs:domain xeo:Tactic`: the
# production implementation scores the Recommendation, and the narrow domain
# typed every scored Recommendation as a Tactic. verdict lost
# `rdfs:domain xeo:Gap` for the same reason once Feedback carries one.

# --- v0.6.0 classes -------------------------------------------------------------

xeo:DiagnosticRun a owl:Class ;
    rdfs:label "Diagnostic Run" ;
    xeo:xeoLayer "episode" ;
    dct:description "One execution of a Diagnostic against one scope at a time: immutable once finished, method-attributed. The Diagnostic is the durable check; the run is the occasion it was applied, and each Gap it found is revealedIn that run. Carries ranAt and websiteId. A later run supersedes an earlier one without deleting it, so a finding can always be traced to the data it was read from." .

xeo:Feedback a owl:Class ;
    rdfs:label "Feedback" ;
    xeo:xeoLayer "interpretation" ;
    dct:description "An operator's judgment of a machine's claim, hung off whatever it judges (feedbackOn): a diagnosed Gap, or the Recommendation issued to close one. Carries a verdict (a slotted-in concept), a statement in the operator's words, and who gave it and when. Not a TacticAssessment, which is a scored estimate of an approach on one dimension: Feedback is a person agreeing or disagreeing with a claim about one case. Never deleted: a rejected finding and the reason it was rejected are what a learned Practice is later drawn from." .

xeo:ExternalEvent a owl:Class ;
    rdfs:label "External Event" ;
    xeo:xeoLayer "episode" ;
    dct:description "Something outside the work that happened at a time and could move the metrics an experiment reads: an engine's ranking update, a site migration, an outage, a seasonal peak, a competitor's launch. Carries name and occurredAt. An episode, recorded once and shared: whether it actually affected a given result is a separate claim, carried on confoundedBy." .

# --- v0.6.0 object properties ----------------------------------------------------

xeo:runOf a owl:ObjectProperty ;
    rdfs:label "run of" ;
    rdfs:domain xeo:DiagnosticRun ; rdfs:range xeo:Diagnostic ;
    xeo:xeoLayer "episode" ;
    dct:description "The Diagnostic this run executed. Exactly one per run." .

xeo:revealedIn a owl:ObjectProperty ;
    rdfs:label "revealed in" ;
    rdfs:domain xeo:Gap ; rdfs:range xeo:DiagnosticRun ;
    xeo:xeoLayer "episode" ;
    dct:description "The run in which this Gap was found. reveals says which Diagnostic asserts the gap; revealedIn says on which occasion, and so against which data." .

xeo:feedbackOn a owl:ObjectProperty ;
    rdfs:label "feedback on" ;
    rdfs:domain xeo:Feedback ;
    xeo:xeoLayer "interpretation" ;
    xeo:rangeIncludes xeo:Gap , xeo:Recommendation ;
    dct:description "The claim this Feedback judges. Exactly one per Feedback. Range left open across Gap and Recommendation, the two machine claims an operator reviews, so another reviewable claim can be judged without a new property." .

xeo:relativeTo a owl:ObjectProperty ;
    rdfs:label "relative to" ;
    rdfs:domain xeo:Gap ;
    xeo:xeoLayer "interpretation" ;
    xeo:rangeIncludes xeo:URL , xeo:Domain , xeo:Brand ;
    dct:description "The party a Gap is measured against: the competitor's page, their domain, or their brand. A gap is a deficit between two things, and this names the other one. Absent where the gap is against a standard rather than a rival. Range left open across the three terms listed." .

xeo:suggests a owl:ObjectProperty ;
    rdfs:label "suggests" ;
    rdfs:domain xeo:Diagnostic ;
    xeo:xeoLayer "norm" ;
    xeo:rangeIncludes xeo:Intervention , xeo:Tactic ;
    dct:description "The usual response when this check fails: a category of work (an Intervention) or a specific Tactic. A standing association authored with the Diagnostic, about a class of cases, and marked norm for that reason. Distinct from recommends, which is one Recommendation's call about one case after the scope gate, precedent and Practices have been applied; and from addressableBy, which is a candidate for one diagnosed Gap. Range left open across the two terms listed." .

xeo:treats a owl:ObjectProperty ;
    rdfs:label "treats" ;
    rdfs:domain xeo:Experiment ;
    xeo:xeoLayer "episode" ;
    xeo:rangeIncludes xeo:URL , xeo:Term ;
    dct:description "A unit the experiment changed, or measured the change on: the pages the tactic was applied to, or the terms it was aimed at. With hasControl it is the experiment's design, fixed when the experiment starts. Range left open across URL and Term." .

xeo:hasControl a owl:ObjectProperty ;
    rdfs:label "has control" ;
    rdfs:domain xeo:Experiment ;
    xeo:xeoLayer "episode" ;
    xeo:rangeIncludes xeo:URL , xeo:Term ;
    dct:description "A unit deliberately left unchanged and measured over the same window, against which the treated units are read. An experiment with no control is a before-and-after comparison, and its Outcome should be read as one. Range left open across URL and Term." .

xeo:implementedAs a owl:ObjectProperty ;
    rdfs:label "implemented as" ;
    rdfs:domain xeo:Recommendation ; rdfs:range xeo:Experiment ;
    xeo:xeoLayer "episode" ;
    dct:description "The Experiment in which this Recommendation was carried out and measured. The forward edge of the loop: supportedBy points back at the precedents that earned the call, implementedAs points at the test the call became. A Recommendation that was approved and never run has none." .

xeo:confoundedBy a owl:ObjectProperty ;
    rdfs:label "confounded by" ;
    xeo:xeoLayer "interpretation" ;
    xeo:domainIncludes xeo:Outcome , xeo:Experiment ;
    rdfs:range xeo:ExternalEvent ;
    dct:description "The claim that an ExternalEvent fell inside the measurement window and could account for some or all of the result. An interpretation, carrying method: the event is a fact, its effect on this result is a judgment. It is the named cause behind an Outcome whose resultReason is confounded_external. Stated on the Outcome, or on the Experiment while it is still measuring." .

# --- v0.6.0 annotation completeness -----------------------------------------------
# Hints for the properties above whose domain or range is open, added without
# touching their declarations.

xeo:evidencedBy xeo:rangeIncludes xeo:URL , xeo:Term , xeo:Prompt , xeo:SerpSnapshot , xeo:LLMResponse .

xeo:assessedAs xeo:domainIncludes xeo:Tactic , xeo:Recommendation .

xeo:verdict xeo:domainIncludes xeo:Gap , xeo:Feedback .

# Labels for the properties declared above, which carried none.

xeo:reveals rdfs:label "reveals" .
xeo:evidencedBy rdfs:label "evidenced by" .
xeo:gapType rdfs:label "gap type" .
xeo:addressableBy rdfs:label "addressable by" .
xeo:inIntervention rdfs:label "in intervention" .
xeo:requiresCapability rdfs:label "requires capability" .
xeo:assessedAs rdfs:label "assessed as" .
xeo:onDimension rdfs:label "on dimension" .
xeo:tests rdfs:label "tests" .
xeo:inContext rdfs:label "in context" .
xeo:producedOutcome rdfs:label "produced outcome" .
xeo:recommends rdfs:label "recommends" .
xeo:closesGap rdfs:label "closes gap" .
xeo:supportedBy rdfs:label "supported by" .
xeo:atPriority rdfs:label "at priority" .
xeo:method rdfs:label "method" .
xeo:score rdfs:label "score" .
xeo:approved rdfs:label "approved" .

xeo:concludedAt rdfs:label "concluded at" .
xeo:verdict rdfs:label "verdict" .
xeo:magnitude rdfs:label "magnitude" .
xeo:magnitudeUnit rdfs:label "magnitude unit" .
xeo:result rdfs:label "result" .
xeo:resultReason rdfs:label "result reason" .

# --- v0.6.0 (metrics, 2026-11-10) --------------------------------------------------
# Appended at the foot (line-stable for the consumers that cite this file by
# line number). From the metrics and KPIs research report.
#
# ADDED. What makes an Outcome computable: the reading it ended on
# (resultReading; the reading it started from is baselineReading, in
# xeo-work beside baseline), and the two changes between them. "Lift" was
# one number that could be points or a percentage, and nothing said which.
# absoluteChange and relativeChange are both stated, signed and raw. And
# magnitudeMetric, so a Gap's size can name the Metric it is a value of.
#
# DEPRECATED (advisory). xeo:lift, in favour of the pair. The term stays
# declared, typed and valid, and existing data is unaffected: owl:deprecated
# tells a new implementation which form to write, nothing more.
#
# TIGHTENED (in place, above). The descriptions of Outcome, lift and
# magnitudeUnit, one line each.

xeo:resultReading a owl:ObjectProperty ;
    rdfs:label "result reading" ;
    rdfs:domain xeo:Outcome ; rdfs:range xeo:MetricReading ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "The API contract of the system named in the reading's source" ;
    xeo:canonicalStore "neo4j" ;
    dct:description "The reading of the target's Metric over the result window, which runs from the day the change was applied for the Objective's resultsWindowDays. One per Outcome. Comparable with baselineReading only when both are readings of the same Metric over the same scope, on the same aggregationBasis, across windows of the same length." .

xeo:absoluteChange a owl:DatatypeProperty ;
    rdfs:label "absolute change" ;
    rdfs:domain xeo:Outcome ; rdfs:range xsd:decimal ;
    xeo:xeoLayer "derivation" ;
    xeo:canonicalStore "neo4j" ;
    dct:description "The result reading's value minus the baseline reading's, in the Metric's unit. For a ratio this is points: 0.02 is two points of clickthrough rate, not two percent of it. Signed and raw: a rank that went from 6 to 3 is -3, and whether that is an improvement is read through the Metric's betterDirection. Never summed across Outcomes: an Objective is read from one objectiveReading over its whole scope, because overlapping Outcomes would count the same clicks twice." .

xeo:relativeChange a owl:DatatypeProperty ;
    rdfs:label "relative change" ;
    rdfs:domain xeo:Outcome ; rdfs:range xsd:decimal ;
    xeo:xeoLayer "derivation" ;
    xeo:canonicalStore "neo4j" ;
    dct:description "absoluteChange divided by the baseline reading's value, as a quotient: 0.25 is a quarter more than baseline. Signed and raw, read through betterDirection like absoluteChange. Undefined, and so absent, when the baseline is zero." .

xeo:magnitudeMetric a owl:ObjectProperty ;
    rdfs:label "magnitude metric" ;
    rdfs:domain xeo:Gap ; rdfs:range xeo:Metric ;
    xeo:xeoLayer "derivation" ;
    xeo:canonicalStore "neo4j" ;
    dct:description "Which Metric a Gap's magnitude is a value of, where the size is a measured quantity: impressions, clicks, positions. The unit and the better direction are then the Metric's. Stated beside magnitudeUnit, which stays required with magnitude; a size that is not a value of any Metric (words, internal links) carries magnitudeUnit alone." .




xeo:magnitudeUnit rdfs:seeAlso xeo:magnitudeMetric .

# --- v0.7.0 (grounding, 2026-11-12) ---------------------------------------------
# Appended at the foot, so no line above moves. Every observation names what it
# is grounded in; these 6 did not. Nothing else about them changes.

xeo:Outcome xeo:groundedIn "The two MetricReadings it compares, each grounded in the API contract of the system named in its source" .

xeo:result xeo:groundedIn "The two MetricReadings its Outcome compares, read with the test its method names" .
xeo:resultReason xeo:groundedIn "The experiment's run record: its window, and the co-interventions and ExternalEvents logged against it" .
xeo:producedOutcome xeo:groundedIn "The experiment's run record" .
xeo:inContext xeo:groundedIn "The experiment's run record: the Gap it was set up against" .

# ===========================================================================
# v0.7.0: the strategy module, merged here (2026-11-12)
# ===========================================================================
# Appended at the foot, so no line above moves. Until 0.7 this was
# xeo-strategy.ttl. Practices govern Recommendations; on its own the module had
# little to say, so it merged into decision. Its terms are unchanged. Its header
# follows as it was, apart from this note.
#
# XEO Strategy module — the norms tier: how recommendations are governed.
#
# The layer xeo-decision deliberately left open. xeo-decision produces a
# Recommendation (deploy this Tactic to close this Gap). This module governs HOW
# that recommendation is allowed to be made: the standing rules — best practices,
# SOPs, lessons learned — that veto, reorder, or caveat a candidate before it
# reaches a human, plus the reusable Playbooks those rules travel in and the
# tenancy axis that decides whose rules win.
#
#   Practice constrains Recommendation                (a rule acts on a candidate)
#   Practice appliesToConcept <role | intervention | gapType | capability>  (its scope)
#   Recommendation appliedPractice Practice           (audit: the rule fired, and why)
#   Playbook includes <Diagnostic | Tactic | Practice> ; tenancy activates Playbook
#
# THE NORM STRATUM (introduced here). Core types every term by the kind of claim
# it makes: entity / episode / observation / derivation, and the decision layer
# adds its interpretive calls on top. All of those describe what IS, or what is
# inferred to be. A norm is a different kind of claim: what SHOULD govern a
# choice — reusable across cases, authored by a person or earned from
# experiments, and revisable. It stands above a single decision: one
# Recommendation is a call about one case; a Practice is a norm about a class of
# cases. This is a new layer, and core's xeoLayer annotation
# already lists it — extension modules introducing norm terms must mark them.
#
# DISCIPLINE (unchanged from decision): this module ships CLASSES, never VALUES.
# Practice, Playbook, and the norm relations are here. "Never 301 a paginated
# archive," "prefer topically-relevant internal links," the page-role vocabulary,
# and the tenancy hierarchy (agency / client / engagement / campaign) are
# skos:Concepts and instances you slot in — not subclasses baked into the ontology.
#
# NEEDS core only. Its links to xeo-decision (constrains and appliedPractice on
# a Recommendation, a Practice placed at a Tactic or a Diagnostic) are optional:
# they work when decision is loaded too, which is how practices act on calls.
# Like decision, uses SKOS as its slot primitive (appliesToConcept, hasRole,
# appliesAtScope). An agent assembling only falsifiable context filters this
# whole module out.

# --- Classes ----------------------------------------------------------------

xeo:Practice a owl:Class ;
    rdfs:label "Practice" ;
    xeo:xeoLayer "norm" ;
    dct:description "A standing rule that governs how recommendations are made under stated conditions. Best-practices, SOPs, and lessons-learned are all Practices, distinguished by source, not by class. A Practice does one of three things (practiceKind): veto a candidate (guardrail), reorder it (preference), or attach a caveat (guidance). Revisable and versioned (supersedes); scoped to the concepts it appliesToConcept; audited on the recommendations it fired on (appliedPractice)." .

xeo:Playbook a owl:Class ;
    rdfs:label "Playbook" ;
    xeo:xeoLayer "entity" ;
    dct:description "A reusable, discipline-scoped bundle of Diagnostics, Tactics, and Practices — an 'SEO playbook', an 'AEO playbook', a 'local playbook'. Durable and named, like a Diagnostic. Its scope is the DISCIPLINE, not the account: a Playbook is authored once (by the community or an agency) and reused across every client. What varies per client or campaign is which Playbooks a tenancy activates and which Practices it overrides — never the Playbook itself." .

# --- Object properties -------------------------------------------------------

xeo:constrains a owl:ObjectProperty ;
    rdfs:domain xeo:Practice ; rdfs:range xeo:Recommendation ;
    xeo:xeoLayer "norm" ;
    dct:description "The Practice governs recommendations matching its conditions — vetoing, reordering, or caveating per its practiceKind. Which recommendations 'match' is set by appliesToConcept." .

xeo:appliesToConcept a owl:ObjectProperty ;
    rdfs:domain xeo:Practice ; rdfs:range skos:Concept ;
    xeo:xeoLayer "norm" ;
    dct:description "Binds a Practice to the slotted-in concepts it applies to — a page role (hasRole), an Intervention, a gapType, a Capability. Bring your own schemes; the Practice fires only where a candidate carries a matching concept." .

xeo:appliedPractice a owl:ObjectProperty ;
    rdfs:domain xeo:Recommendation ; rdfs:range xeo:Practice ;
    xeo:xeoLayer "derivation" ;
    dct:description "Audit edge: this Practice was evaluated against this recommendation and fired. Carries method and confidence — the application is a computed derivation, not itself a norm. The transparent record of why a candidate was blocked, demoted, or flagged." .

xeo:supersedes a owl:ObjectProperty ;
    rdfs:domain xeo:Practice ; rdfs:range xeo:Practice ;
    xeo:xeoLayer "norm" ;
    dct:description "This Practice replaces an earlier version. Editing a rule mints a new Practice that supersedes the old (retired to status 'deprecated', never deleted) — the version chain that makes the norms layer revisable and auditable." .

xeo:includes a owl:ObjectProperty ;
    # rdfs:domain xeo:Playbook removed in v0.6.0: a Framework includes the same three kinds. Domain left open.
    xeo:xeoLayer "entity" ;
    dct:description "A Diagnostic, Tactic, or Practice bundled into this Playbook or Framework. Domain and range left open: the two bundles on one side, the three decision/norm terms they may hold on the other." .

xeo:activates a owl:ObjectProperty ;
    # rdfs:range xeo:Playbook removed in v0.6.0: a Framework is activated the same way. Range left open.
    xeo:xeoLayer "norm" ;
    dct:description "A tenancy context puts a Playbook or Framework into effect for a body of work. Domain left open: model your own tenancy node (an Organization, a client, an engagement, a campaign) and point it here — this module stays agnostic about the account hierarchy, which is expressed through appliesAtScope." .

xeo:hasRole a owl:ObjectProperty ;
    rdfs:domain xeo:URL ; rdfs:range skos:Concept ;
    xeo:xeoLayer "derivation" ;
    dct:description "The structural role a URL plays on its site, as a slotted-in concept. A recommended starter scheme is coarse and purpose-based: brand-core (home, about), commercial (services, products, sales), content (articles, marketing), infrastructure (pagination, archives, tag and category indexes). Assignment is a DERIVATION from graph and crawl structure — inbound link_position, index-vs-leaf link patterns, template similarity — not URL-string matching; it carries method and confidence, and 'unknown' is a valid, conservative state. Parallels core's inTopic. Norms bind to these roles via appliesToConcept, so 'never redirect an infrastructure page for ranking' is a rule over a role, not a growing list of regexes." .

xeo:authoredBy a owl:ObjectProperty ;
    rdfs:domain xeo:Practice ;
    xeo:xeoLayer "norm" ;
    dct:description "The party that authored a Practice (or an activation or override). Range left open — a person, an agency, the system, or a prov:Agent in your own graph. One half of the customization axis: with appliesAtScope, it decides whose rule wins." .

xeo:appliesAtScope a owl:ObjectProperty ;
    rdfs:range skos:Concept ;
    xeo:xeoLayer "norm" ;
    dct:description "The tenancy level at which a Practice (or activation or override) applies, as a slotted-in concept. A recommended hierarchy is default < agency < client < engagement < campaign < user. Domain left open so it can annotate any strategy-layer assertion. Resolution is most-specific-wins: a client-level Practice overrides an agency default, which overrides the shipped default. This is the 'customization' axis — not a lens, a specificity ladder." .

# --- Datatype properties -----------------------------------------------------
# Reuses xeo:confidence (0-1) and xeo:method from core; neither is redeclared.

xeo:statement a owl:DatatypeProperty ;
    rdfs:range xsd:string ;  # domain-free since v0.6.0 (was xeo:Practice): Gap, Recommendation, Objective and Feedback carry a statement.
    xeo:xeoLayer "norm" ;
    dct:description "The rule in plain language, as a human authored or confirmed it — e.g. 'Never 301 a paginated archive URL for ranking purposes.' The canonical human-facing form; the structural fields (practiceKind, appliesToConcept, constrains) make it executable." .

xeo:practiceKind a owl:DatatypeProperty ;
    rdfs:domain xeo:Practice ; rdfs:range xsd:string ;
    xeo:xeoLayer "norm" ;
    dct:description "How the Practice acts: 'guardrail' (veto a matching candidate), 'preference' (reorder it), or 'guidance' (attach a caveat, change nothing). The mechanism, kept as a small controlled string rather than a subclass." .

xeo:source a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    xeo:xeoLayer "norm" ;
    dct:description "Provenance of an assertion. The value vocabulary is subject-specific. On a Practice: 'authored' (a human SOP or best-practice — high standing, durable), 'learned' (earned from the experiment ledger — confidence ratchets with Outcomes), or 'claimed' (an unproven assertion, e.g. a current answer-engine tactic — ships low-confidence with a halfLife and decays unless experiments promote it); this lets one class hold a firm SOP and a fragile claim without conflating their trust. On a ranksFor or visibilityFor rollup: the data source the window was built from. DOMAIN LEFT OPEN deliberately — rdfs:domain is an entailment rule, not a constraint, so naming xeo:Practice here would silently type every rollup edge carrying a source as a Practice." .

xeo:status a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    xeo:xeoLayer "norm" ;
    dct:description "Lifecycle state of a revisable term. The value vocabulary is subject-specific. On a Practice: 'proposed', 'active', or 'deprecated' — a proposed Practice is visible but does not fire, and superseding one deprecates it. DOMAIN LEFT OPEN deliberately, so another revisable term (the execution lifecycle of a Recommendation, say) can carry a lifecycle without being entailed a Practice." .

xeo:rationale a owl:DatatypeProperty ;
    rdfs:domain xeo:Practice ; rdfs:range xsd:string ;
    xeo:xeoLayer "norm" ;
    dct:description "Why the rule exists — surfaced to a user when the Practice fires, so a veto or demotion is explained, never silent." .

xeo:halfLife a owl:DatatypeProperty ;
    rdfs:domain xeo:Practice ; rdfs:range xsd:duration ;
    xeo:xeoLayer "norm" ;
    dct:description "Optional decay window for a Practice whose source is 'claimed': how long the assertion is trusted absent supporting Outcomes. Encodes the reality that today's answer-engine tactics may not survive the year — a claim nobody's experiments confirm ages out on its own." .

# --- Module header ----------------------------------------------------------
# At the foot of the file, not the head — see the note in xeo-decision.ttl.
# This file carries 14 of the line-number citations live in launch-guardian and
# if-control-center; a header at the top would break every one of them.

# --- Audit-edge value ---------------------------------------------------------
# Appended at the foot, line-stable. What a Practice DID when it fired — the
# value carried on appliedPractice. Published in xeo-schemes.ttl (practiceOutcome).

xeo:practiceOutcome a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    xeo:xeoLayer "derivation" ;
    dct:description "Carried on an appliedPractice edge: 'vetoed' (a guardrail removed the candidate), 'reranked' (a preference moved it), or 'caveated' (guidance flagged it and changed nothing). One value per practiceKind. Domain left open because it rides on the edge, not on a node." .

# --- v0.6.0 (kit sync) ---------------------------------------------------------
# Appended at the foot, line-stable.
#
# ADDED. Framework and Stage: a named method as data. Until now a method (an
# optimization waterfall, a tactic matrix, a launch checklist) could only be
# flattened into a Playbook, which is an unordered bundle and has nowhere to
# put "this check comes before that one". learnedFrom, the edge that makes a
# 'learned' Practice traceable to the experiments it was earned from.
# appliesTo, the general form of appliesToConcept for a Practice scoped to a
# Tactic or a page rather than a concept. evaluatedPractice + fired, the
# negative half of the audit record: appliedPractice says a rule fired, and
# nothing said a rule was evaluated and did not.
#
# WIDENED (in place, above, each removed line replaced by a comment so nothing
# shifted). includes lost `rdfs:domain xeo:Playbook` and activates lost
# `rdfs:range xeo:Playbook`, so a Framework can bundle and be activated the
# same way. statement lost `rdfs:domain xeo:Practice`: Gap, Recommendation,
# Objective and Feedback all carry one, and the domain typed each as a Practice.

# --- v0.6.0 classes -------------------------------------------------------------

xeo:Framework a owl:Class ;
    rdfs:label "Framework" ;
    xeo:xeoLayer "norm" ;
    dct:description "A named method: a set of Stages, ordered or not, with the Diagnostics, Tactics and Practices hung on them. An optimization waterfall (ordered stages, each with a test, a subject placed at the first stage it fails), a tactic matrix, a launch checklist and a discipline playbook are all Frameworks, told apart by frameworkKind and never by subclass. A norm: it says how the work should be approached, it is authored and revisable, and it is identified by name within its author's scope. Distinct from Playbook, which is the unordered bundle a discipline reuses; a Framework adds the structure, and may include what a Playbook includes. The method is the instance you author. XEO ships the frame and none of the stages." .

xeo:Stage a owl:Class ;
    rdfs:label "Stage" ;
    xeo:xeoLayer "norm" ;
    dct:description "One step or cell of a Framework: a named position that Diagnostics, Tactics and Gaps are placed at (atStage). Carries name, an optional stageOrder, and an optional test — the question a subject must pass to move on. Belongs to exactly one Framework (hasStage) and is identified by name within it. In an ordered Framework, nextStage links each stage to the one after." .

# --- v0.6.0 object properties ----------------------------------------------------

xeo:hasStage a owl:ObjectProperty ;
    rdfs:label "has stage" ;
    rdfs:domain xeo:Framework ; rdfs:range xeo:Stage ;
    xeo:xeoLayer "norm" ;
    dct:description "A Stage of this Framework. A Stage belongs to exactly one Framework." .

xeo:nextStage a owl:ObjectProperty ;
    rdfs:label "next stage" ;
    rdfs:domain xeo:Stage ; rdfs:range xeo:Stage ;
    xeo:xeoLayer "norm" ;
    dct:description "The stage that follows this one in an ordered Framework. Both stages belong to the same Framework. Says the same as stageOrder, as an edge a traversal can walk; where both are present they must agree." .

xeo:atStage a owl:ObjectProperty ;
    rdfs:label "at stage" ;
    rdfs:range xeo:Stage ;
    xeo:xeoLayer "norm" ;
    xeo:domainIncludes xeo:Diagnostic , xeo:Tactic , xeo:Gap ;
    dct:description "Places a Diagnostic, a Tactic or a Gap at a Stage of a Framework. For a Diagnostic or a Tactic the placement is the method author's standing claim about where it belongs. For a Gap it is inherited from the Diagnostic that revealed it and carries method. Domain left open across the three terms listed." .

xeo:frameworkKind a owl:ObjectProperty ;
    rdfs:label "framework kind" ;
    rdfs:domain xeo:Framework ; rdfs:range skos:Concept ;
    xeo:xeoLayer "norm" ;
    dct:description "What shape of method a Framework is, as a slotted-in concept (diagnostic, tactic_matrix, checklist, playbook — xeos:frameworkKind is a published reference filling). One per Framework. The kind says how the stages are read: in order with a test at each, as cells of a grid, as items to tick, or as a bundle." .

xeo:learnedFrom a owl:ObjectProperty ;
    rdfs:label "learned from" ;
    rdfs:domain xeo:Practice ;
    xeo:xeoLayer "derivation" ;
    xeo:rangeIncludes xeo:Experiment , xeo:Outcome ;
    dct:description "The Experiments or Outcomes a Practice was earned from. Expected on every Practice whose source is 'learned', and it is what makes that word checkable: a learned rule with no learnedFrom is a claimed one. Carries method (who or what drew the lesson) and confidence. Range left open across Experiment and Outcome." .

xeo:appliesTo a owl:ObjectProperty ;
    rdfs:label "applies to" ;
    rdfs:domain xeo:Practice ;
    xeo:xeoLayer "norm" ;
    xeo:rangeIncludes xeo:Tactic , xeo:Intervention , xeo:URL , skos:Concept ;
    dct:description "What a Practice is scoped to: a Tactic, an Intervention, a single URL, or any slotted-in concept. The Practice fires only where a candidate matches. appliesToConcept is its narrower form, for the case where the target is a concept; this is the general edge, for a rule about one tactic or one page. Range left open across the terms listed." .

xeo:evaluatedPractice a owl:ObjectProperty ;
    rdfs:label "evaluated practice" ;
    rdfs:domain xeo:Recommendation ; rdfs:range xeo:Practice ;
    xeo:xeoLayer "derivation" ;
    dct:description "Audit edge: this Practice was evaluated against this recommendation, whether or not it fired. Carries fired, method and confidence, and should carry what the evaluation matched on. The whole record, of which appliedPractice is the fired half: without the negative half, a rule that never fires cannot be told from a rule that was never checked." .

# --- v0.6.0 datatype properties ---------------------------------------------------

xeo:stageOrder a owl:DatatypeProperty ;
    rdfs:label "stage order" ;
    rdfs:domain xeo:Stage ; rdfs:range xsd:integer ;
    xeo:xeoLayer "norm" ;
    dct:description "The position of a Stage within its Framework, as an integer, lower first. Unique within a Framework. Absent in an unordered Framework." .

xeo:test a owl:DatatypeProperty ;
    rdfs:label "test" ;
    rdfs:domain xeo:Stage ; rdfs:range xsd:string ;
    xeo:xeoLayer "norm" ;
    dct:description "The question a subject must pass at this Stage, in plain language ('Is the page indexed?'). The human-facing form; the Diagnostics placed atStage are what make it executable." .

xeo:fired a owl:DatatypeProperty ;
    rdfs:label "fired" ;
    rdfs:range xsd:boolean ;
    xeo:xeoLayer "derivation" ;
    dct:description "Carried on an evaluatedPractice edge: true when the Practice matched the candidate and acted (and an appliedPractice edge records what it did), false when it was evaluated and did not match. Domain left open because it rides on the edge, not on a node." .

# --- v0.6.0 additions to existing terms -------------------------------------------
# New triples about terms declared above; nothing is redefined.

xeo:appliesToConcept rdfs:subPropertyOf xeo:appliesTo .

xeo:appliedPractice rdfs:subPropertyOf xeo:evaluatedPractice .

xeo:includes xeo:domainIncludes xeo:Playbook , xeo:Framework ;
    xeo:rangeIncludes xeo:Diagnostic , xeo:Tactic , xeo:Practice .

xeo:activates xeo:domainIncludes xeo:Organization , xeo:Project , xeo:Campaign ;
    xeo:rangeIncludes xeo:Playbook , xeo:Framework .

xeo:statement xeo:domainIncludes xeo:Practice , xeo:Gap , xeo:Recommendation , xeo:Objective , xeo:Feedback .

# Labels for the properties declared above, which carried none.

xeo:constrains rdfs:label "constrains" .
xeo:appliesToConcept rdfs:label "applies to concept" .
xeo:appliedPractice rdfs:label "applied practice" .
xeo:supersedes rdfs:label "supersedes" .
xeo:includes rdfs:label "includes" .
xeo:activates rdfs:label "activates" .
xeo:hasRole rdfs:label "has role" .
xeo:authoredBy rdfs:label "authored by" .
xeo:appliesAtScope rdfs:label "applies at scope" .
xeo:statement rdfs:label "statement" .
xeo:practiceKind rdfs:label "practice kind" .
xeo:source rdfs:label "source" .
xeo:status rdfs:label "status" .
xeo:rationale rdfs:label "rationale" .
xeo:halfLife rdfs:label "half life" .
xeo:practiceOutcome rdfs:label "practice outcome" .

# --- v0.7.0 (how a reference came about, 2026-11-12) ----------------------------------
# C6: an InboundReference (core) is observed; how it came about is a Tactic.

xeo:acquiredByTactic a owl:ObjectProperty ;
    rdfs:label "acquired by tactic" ;
    rdfs:domain xeo:InboundReference ; rdfs:range xeo:Tactic ;
    xeo:xeoLayer "interpretation" ;
    dct:description "The Tactic that produced an InboundReference: a placement, a pitch, a link magnet. A claim about how it came about, so an interpretation, and absent for an organic reference. Where an Experiment paid for it, the Experiment tests that Tactic." .
