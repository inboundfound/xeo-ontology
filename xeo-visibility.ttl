@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix xeo:  <https://xeoontology.org/xeo#> .

# XEO Visibility module — the xEO layer.
#
# Extends XEO Core with the terms needed once "the engine" stops being a
# results page and starts being an answer: generative overviews, answer
# engines, conversational agents. Same discipline as core — entities are
# durable, episodes (captured responses) are immutable, observations are
# extracted from what the engine actually returned, and anything a model
# produced carries provenance. Field-tested against a working
# tracker + response-capture + Neo4j implementation before publication.

xeo:visibility-module a owl:Ontology ;
    dct:title "XEO Visibility (the xEO layer)" ;
    dct:description "Extends XEO Core with the terms needed once the engine stops being a results page and starts being an answer: engines, prompts, captured responses, citations, mentions, and the visibility rollups over them." ;
    dct:creator "Inbound Found" ;
    owl:versionInfo "0.6.0" .

# --- Classes ----------------------------------------------------------------

# Removed in 0.7: xeo:GenerativeEngine. Use GenerativeOverview.



xeo:AnswerEngine a owl:Class ; rdfs:subClassOf xeo:Engine ;
    rdfs:label "Answer Engine" ;
    dct:description "An assistant that answers a person in its own interface, with or without web search and citations: ChatGPT, Perplexity, Claude, and multi-turn agents and voice surfaces acting for a user (ConversationalAgent until 0.7). The AEO surface." .

# Removed in 0.7: xeo:ConversationalAgent. Use AnswerEngine.



xeo:Brand a owl:Class ;
    rdfs:label "Brand" ;
    xeo:xeoLayer "entity" ;
    dct:description "A named market identity that engines may mention, cite, or recommend. Distinct from Website: a brand can be visible on the whole web, not only its own origin." .

xeo:Prompt a owl:Class ;
    rdfs:label "Prompt" ;
    xeo:xeoLayer "entity" ;
    dct:description "A tracked natural-language question posed to engines. Distinct from Term: a prompt is what a person asks; the engine's retrieval fans out into Terms." .

xeo:LLMResponse a owl:Class ;
    rdfs:label "LLM Response" ;
    xeo:xeoLayer "episode" ;
    dct:description "One captured response from one engine/model for one Prompt at a moment: time-bounded, source-attributed, immutable once captured. The visibility sibling of SerpSnapshot." .

# --- Object properties -------------------------------------------------------

xeo:tracksPrompt a owl:ObjectProperty ;
    rdfs:domain xeo:Website ; rdfs:range xeo:Prompt ;
    xeo:xeoLayer "entity" ;
    dct:description "This tenant tracks this prompt. Tenancy is data, not schema." .

xeo:hasResponse a owl:ObjectProperty ;
    rdfs:domain xeo:Prompt ; rdfs:range xeo:LLMResponse ;
    xeo:xeoLayer "episode" .

xeo:cites a owl:ObjectProperty ;
    rdfs:domain xeo:LLMResponse ; rdfs:range xeo:URL ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "Engine response citation annotations (per-provider API contract)" ;
    dct:description "The response grounded on this URL, per the engine's own citation annotations. Carries citationRank where the engine orders its sources. The visibility sibling of hasResult." .

xeo:mentions a owl:ObjectProperty ;
    rdfs:domain xeo:LLMResponse ; rdfs:range xeo:Brand ;
    xeo:xeoLayer "observation" ;
    dct:description "The brand's name appears in the response text. Carries mentionRank (order of first appearance) — high mention counts at poor ranks are the 'named among twelve, championed never' pattern. Extraction method (string match, NER model) must be recorded; model-extracted mentions are derivations, not observations." .

xeo:fansOutTo a owl:ObjectProperty ;
    rdfs:domain xeo:Prompt ; rdfs:range xeo:Term ;
    xeo:xeoLayer "observation" ;
    xeo:groundedIn "Engine-reported retrieval queries (per-provider API contract)" ;
    dct:description "A retrieval query the engine reported issuing while answering this prompt. Fan-out queries ARE Terms — the join between the xEO layer and classic rank data. Carries the reporting engine and capture episode." .

xeo:visibilityFor a owl:ObjectProperty ;
    rdfs:domain xeo:Prompt ; rdfs:range xeo:Brand ;
    xeo:xeoLayer "observation" ;
    xeo:canonicalStore "neo4j" ;
    dct:description "Windowed rollup of response-level observations for a (prompt, brand) pair: mentionRate, citationRate, responses, periodStart, periodEnd, source, datasetUri. Mirrors the ranksFor rollup pattern — raw responses are the authoritative record; this is the traversal-friendly projection." .

# --- Datatype properties ------------------------------------------------------

xeo:webSearchEnabled a owl:DatatypeProperty ;
    rdfs:domain xeo:LLMResponse ; rdfs:range xsd:boolean ;
    xeo:xeoLayer "episode" ;
    dct:description "Whether the engine could search the web for this response. Citation behavior differs sharply with this flag; never pool across it silently." .

xeo:mentionRank a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    xeo:xeoLayer "observation" ;
    dct:description "1-based order of the brand's first appearance in the response text. Carried on mentions edges." .

xeo:mentionRate a owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    xeo:xeoLayer "derivation" ;
    dct:description "Share of captured responses in the window that mention the brand. Carried on visibilityFor rollups." .

xeo:citationRate a owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    xeo:xeoLayer "derivation" ;
    dct:description "Share of captured responses in the window that cite the brand's owned URLs. Cited and mentioned diverge — a page can ground an answer that names someone else." .

# --- Relationship-carried properties -----------------------------------------
# Declared for the same reason as core's: context.jsonld already publishes them.

xeo:text a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    xeo:xeoLayer "entity" ;
    dct:description "The natural-language body of a Prompt as posed to the engine. Part of a Prompt's identity together with websiteId." .

# modelVersion moved to core in 0.7, redefined as the dated build of a Model.




xeo:citationRank a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    xeo:xeoLayer "observation" ;
    dct:description "1-based order of a cited source where the engine orders its citations. Carried on cites; absent where the engine reports an unordered set." .

xeo:responses a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    xeo:xeoLayer "observation" ;
    dct:description "How many captured responses the rollup window covers — the denominator behind mentionRate and citationRate. Carried on visibilityFor; a rate without it cannot be weighted." .

# --- v0.6.0 (kit sync) ---------------------------------------------------------
# Appended at the foot, so no line above moves.
#
# ADDED. hasWebsite, without which citationRate ("cites the brand's owned URLs")
# could not be computed from the graph: nothing said which URLs a Brand owns.
# competesWith, the claim a share-of-voice comparison rests on. sentiment, the
# polarity of a mention.
#
# WIDENED / FIXED (in place, above). onEngine lost `rdfs:domain xeo:LLMResponse`:
# a SerpSnapshot is "for a stated engine" by core's own definition and had no
# edge to say which. capturedAt and model lost the same domain, which was a bug
# rather than a narrowing: core's SerpSnapshot is captured at a time and
# inTopic carries a model, and rdfs:domain being an entailment rule, every
# snapshot and every topic assignment was being typed as an LLMResponse.
#
# sentiment is a controlled string with a published scheme, not a skos:Concept
# range: this module stands alone on primary web standards and takes no SKOS
# dependency, the same choice core makes for resultType.

xeo:hasWebsite a owl:ObjectProperty ;
    rdfs:label "has website" ;
    rdfs:domain xeo:Brand ; rdfs:range xeo:Website ;
    xeo:xeoLayer "entity" ;
    dct:description "A Website this Brand owns or publishes. The join citationRate depends on: a response cites the brand when it cites a URL that is partOf one of the brand's Websites. A Brand may have several (regional sites, a documentation site); a tracked competitor Brand may have none in the graph, and its cited URLs are then matched by onDomain." .

xeo:competesWith a owl:ObjectProperty ;
    rdfs:label "competes with" ;
    xeo:xeoLayer "interpretation" ;
    xeo:domainIncludes xeo:Brand , xeo:Website , xeo:Domain ;
    xeo:rangeIncludes xeo:Brand , xeo:Website , xeo:Domain ;
    dct:description "The claim that two parties contest the same audience: Brand against Brand in engine answers, Website or Domain against Domain on results pages. An interpretation, and it must carry method: named by the client, inferred from shared Terms, or inferred from co-mention in responses are three different claims. Stated from the tenant's side and tenant-scoped; it is not asserted to be symmetric." .

xeo:sentiment a owl:DatatypeProperty ;
    rdfs:label "sentiment" ;
    rdfs:range xsd:string ;
    xeo:xeoLayer "derivation" ;
    dct:description "The polarity with which a response speaks of a brand, as a code from a slotted-in scheme (positive, neutral, negative, mixed — xeos:sentiment is a published reference filling). Carried on mentions. Always a derivation: a model or a rule read the text, so the edge carries method, and confidence where the method reports one. A tool's proprietary sentiment score is a different derivation with that tool as its method, and does not belong in this slot." .

# --- v0.6.0 annotation completeness -----------------------------------------------
# The triples below add what the declarations above lacked; nothing is redefined.


xeo:AnswerEngine xeo:xeoLayer "entity" .


xeo:hasResponse dct:description "A captured response to this Prompt." .

# Labels for the properties declared above, which carried none.

xeo:tracksPrompt rdfs:label "tracks prompt" .
xeo:hasResponse rdfs:label "has response" .
xeo:cites rdfs:label "cites" .
xeo:mentions rdfs:label "mentions" .
xeo:fansOutTo rdfs:label "fans out to" .
xeo:visibilityFor rdfs:label "visibility for" .
xeo:webSearchEnabled rdfs:label "web search enabled" .
xeo:mentionRank rdfs:label "mention rank" .
xeo:mentionRate rdfs:label "mention rate" .
xeo:citationRate rdfs:label "citation rate" .
xeo:text rdfs:label "text" .

xeo:citationRank rdfs:label "citation rank" .
xeo:responses rdfs:label "responses" .

# --- v0.6.0 (metrics, 2026-11-10) --------------------------------------------------
# Appended at the foot. No new terms in this module.
#
# FIXED (layer, in place above). mentionRate and citationRate were marked
# observation. Each is a share somebody computed over a sample of responses,
# from mentions a method extracted, and by XEO's own rule a computed rate is a
# derivation. They are now marked so. Nothing about their type, range or
# meaning changed; a consumer that filters by layer will find them one layer up.
# The Metrics they are values of are xeos:metric-ai_mention_rate and
# xeos:metric-ai_citation_rate, which state the numerator and the denominator.

# --- v0.7.0 (modules, 2026-11-12) ---------------------------------------------------
# Engine, SearchEngine, onEngine, capturedAt and model moved to core, which a
# SerpSnapshot needs without this module. attributedResponse moved here from
# xeo-engagement.ttl: it points at an LLMResponse, so it belongs with it.

xeo:attributedResponse a owl:ObjectProperty ;
    rdfs:domain xeo:ConversionEvent ; rdfs:range xeo:LLMResponse ;
    xeo:xeoLayer "interpretation" ;
    dct:description "The claim that this conversion traces to engine visibility captured in this response episode. Multi-engine attribution is inherently inferential: this edge MUST carry method and confidence, and honest implementations will leave it sparse. Assert it only when the event's session, or the linked record's first or latest touch, has channel ai_assistant (or a declared assisted-path method applies), and the response cites a URL of the same website within a declared lookback window. Method is referral-match, citation-window or model." ;
    rdfs:label "attributed response" .

# --- v0.7.0 (grounding, 2026-11-12) ---------------------------------------------
# Appended at the foot, so no line above moves. Every observation names what it
# is grounded in; these 5 did not. Nothing else about them changes.

xeo:mentions xeo:groundedIn "The response text as captured (per-provider API contract), read by the recorded extraction method" .
xeo:mentionRank xeo:groundedIn "The response text as captured (per-provider API contract), read by the recorded extraction method" .
xeo:citationRank xeo:groundedIn "Engine response citation annotations (per-provider API contract)" .
xeo:responses xeo:groundedIn "The captured LLMResponses the rollup window covers (per-provider API contract)" .
xeo:visibilityFor xeo:groundedIn "The captured LLMResponses the rollup window covers: their text and citation annotations (per-provider API contract)" .

# --- v0.7.0 (engines, 2026-11-12) ---------------------------------------------------
# C3: GenerativeOverview renames GenerativeEngine (the generated answer on a
# results page, tied to its search engine); ConversationalAgent folded into
# AnswerEngine. Both old names are removed.

xeo:GenerativeOverview a owl:Class ;
    rdfs:label "Generative Overview" ;
    rdfs:subClassOf xeo:Engine ;
    xeo:xeoLayer "entity" ;
    dct:description "A search engine's generated answer on its own results page: Google's AI Overviews and AI Mode, Bing's generated answers. Tied to the SearchEngine it appears on (shownOnSearchEngine). The GEO surface. Was GenerativeEngine until 0.7." .

xeo:shownOnSearchEngine a owl:ObjectProperty ;
    rdfs:label "shown on search engine" ;
    rdfs:domain xeo:GenerativeOverview ; rdfs:range xeo:SearchEngine ;
    xeo:xeoLayer "entity" ;
    dct:description "The SearchEngine whose results pages a GenerativeOverview appears on. One per GenerativeOverview." .
