@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix xeo:    <https://xeoontology.org/xeo#> .

# XEO Alignment module — optional bridges to foundational web vocabularies.
#
# XEO stands alone: core, visibility, and engagement load and reason with none
# of the vocabularies referenced here present. These are ALIGNMENTS, not
# dependencies — a crosswalk for anyone who already speaks schema.org, PROV-O,
# or SKOS and wants to connect their data to XEO (or export XEO as their terms).
#
# Two deliberate stances, so the bridges never assert something false:
#   * SKOS mapping relations (skos:closeMatch) express APPROXIMATE cross-vocab
#     correspondence WITHOUT forcing logical entailment — used wherever the
#     concepts rhyme but are not provably identical (e.g. xeo:URL ~ schema:WebPage).
#   * rdfs:subClassOf / rdfs:subPropertyOf are used ONLY where an XEO term is a
#     genuine specialization of the target (e.g. xeo:Crawl is-a prov:Activity).
#
# None of this depends on any third-party SEO vocabulary; schema.org, PROV-O and
# SKOS are neutral web standards, not competitors in the SEO, GEO and AEO space.

xeo:align-module a owl:Ontology ;
    dct:title "XEO Alignment (schema.org · PROV-O · SKOS)" ;
    dct:description "Optional crosswalk from XEO terms to foundational web vocabularies. Alignments, not imports: XEO is self-contained without them." ;
    dct:creator "Inbound Found" ;
    owl:versionInfo "0.8.1" ;
    rdfs:seeAlso <https://schema.org/> , <http://www.w3.org/ns/prov#> ,
                 <http://www.w3.org/2004/02/skos/core#> .

# ===========================================================================
# schema.org — the neutral base for web entities. Consumers who already publish
# schema.org markup can join their WebSite/WebPage/Brand graph straight to XEO.
# ===========================================================================

xeo:Website skos:closeMatch schema:WebSite ;
    rdfs:comment "An XEO Website is identified by origin and carries tenancy; schema:WebSite is the closest published class." .

xeo:URL skos:closeMatch schema:WebPage ;
    rdfs:comment "XEO models the URL as the durable address-identity; the page's rendered state at a time is a Fetch observation, not the identity. schema:WebPage is the closest published class for 'the page at this address' — closeMatch, not equivalence, because XEO deliberately separates the address (entity) from the document state (observation)." .

xeo:address rdfs:subPropertyOf schema:url ;
    rdfs:comment "The serialized absolute URL is a schema:url value." .

xeo:Brand skos:closeMatch schema:Brand .

xeo:SearchPerformanceFact skos:closeMatch schema:Observation ;
    rdfs:comment "The atomic metric row is an observation with a measured property, value, and time — never a reified 'score' class. schema:Observation captures the same shape." .

xeo:inTopic skos:closeMatch schema:about ;
    rdfs:comment "A Term being in a Topic is a (provenance-carrying) 'aboutness' assertion." .

# ===========================================================================
# PROV-O — the provenance spine. XEO's layering (entity / episode /
# observation / derivation / interpretation / norm) maps onto PROV as follows:
#   episode      -> in PROV terms this splits into the Activity that ran
#                   (Crawl) and the Entity it produced (LLMResponse, SerpSnapshot)
#   observation  -> assertions attributable to an activity/agent
#   derivation   -> prov:wasDerivedFrom, qualified by method/model/confidence
#   interpretation -> a labeled claim; XEO-native, no PROV analog
#   norm         -> a standing rule over a class of cases; XEO-native, no PROV
#                   analog. Its APPLICATION is provenance (see appliedPractice).
# ===========================================================================

xeo:Crawl rdfs:subClassOf prov:Activity ;
    rdfs:comment "A crawl is a process that ran over a period, fetching URLs." .

xeo:Engine rdfs:subClassOf prov:SoftwareAgent ;
    rdfs:comment "An engine is a software agent that bears responsibility for the responses it produces." .

xeo:LLMResponse rdfs:subClassOf prov:Entity ;
    rdfs:comment "A captured response is an immutable record (entity) generated by, and attributed to, an engine." .

xeo:SerpSnapshot rdfs:subClassOf prov:Entity ;
    rdfs:comment "A SERP snapshot is an immutable captured record." .

xeo:ConversionEvent rdfs:subClassOf prov:Activity ;
    rdfs:comment "Engagement draft: a conversion is an event that occurred at a time." .

xeo:onEngine rdfs:subPropertyOf prov:wasAttributedTo ;
    rdfs:comment "The response is attributed to the engine (and, via model/modelVersion, the model) that produced it." .

xeo:capturedAt rdfs:subPropertyOf prov:generatedAtTime ;
    rdfs:comment "The response record was generated at capture time." .

# ===========================================================================
# SKOS — the taxonomy spine. XEO's Topic tree is a controlled vocabulary:
# a Topic is a concept, childOf is the broader/narrower relation. Users bring
# their OWN concept scheme of topics/gaps/stages and slot it into these terms
# without touching the ontology.
# ===========================================================================

xeo:Topic rdfs:subClassOf skos:Concept ;
    rdfs:comment "A Topic is a concept in a site-scoped scheme, plus derivation provenance (method, model, confidence)." .

xeo:childOf rdfs:subPropertyOf skos:broader ;
    rdfs:comment "Topic childOf Topic: the child points to its broader parent, matching skos:broader." .

xeo:scopedTo rdfs:seeAlso skos:inScheme ;
    rdfs:comment "Topics are scoped to a Website rather than a free-standing ConceptScheme; skos:inScheme is the analogous grouping." .

# ===========================================================================
# Decision layer (xeo-decision.ttl) — PROV-O bridges. The precedent chain is
# provenance: an Experiment is a process, its Outcome the entity it generated,
# and a Gap / Recommendation is derived from the evidence and experiments behind
# it. (The decision module also uses skos:Concept directly for its taxonomy
# slots — gapType, inIntervention, onDimension, atPriority — but that is a
# load-bearing primitive declared in the module itself, not an optional bridge.)
# ===========================================================================

xeo:Experiment rdfs:subClassOf prov:Activity ;
    rdfs:comment "An experiment is a process that ran over a period, testing a tactic." .

xeo:Outcome rdfs:subClassOf prov:Entity ;
    rdfs:comment "An outcome is the measured record an experiment generated." .

xeo:producedOutcome rdfs:subPropertyOf prov:generated ;
    rdfs:comment "The experiment (activity) generated this outcome (entity)." .

xeo:concludedAt rdfs:subPropertyOf prov:endedAtTime ;
    rdfs:comment "When the experiment activity ended." .

xeo:evidencedBy rdfs:subPropertyOf prov:wasDerivedFrom ;
    rdfs:comment "A gap is derived from the observations behind it." .

xeo:supportedBy rdfs:subPropertyOf prov:wasDerivedFrom ;
    rdfs:comment "A recommendation is derived from the precedent experiments that back it." .

# ===========================================================================
# Work module (xeo-work.ttl) — schema.org bridge. Only Project has a
# published counterpart; Campaign, Objective and MetricTarget are XEO-native.
# ===========================================================================

xeo:Project skos:closeMatch schema:Project ;
    rdfs:comment "An XEO Project is a bounded body of work, client or internal, often a contract on one website; schema:Project is the closest published class. closeMatch, not equivalence: XEO's may carry contract terms (a type, a quota, a scope) schema.org has no notion of." .

# ===========================================================================
# v0.6.0 (kit sync) — bridges for the terms added in 0.6.0, appended at the
# foot. Same two stances as above: closeMatch where the concepts rhyme,
# subClassOf / subPropertyOf only where the XEO term is a real specialization.
#
# xeo:Domain has no bridge, deliberately. No neutral vocabulary publishes
# "registrable domain" as a class: schema:WebSite is a site (already matched to
# xeo:Website), and a domain name is neither a site nor an organization.
# Asserting a near-match would say something false.
#
# xeo:similarTo has no bridge either. skos:related is defined between
# skos:Concepts and is symmetric; similarTo joins URLs, Terms and Experiments,
# runs one way, and carries a number. The two are not close enough to map.
# ===========================================================================

xeo:Entity skos:closeMatch schema:Thing ;
    rdfs:comment "An XEO Entity is a real-world thing or concept that content is about, identified by a knowledge-base reference. schema:Thing is the closest published class; closeMatch, not subclass, because schema:Thing is the root of everything schema.org describes, including the pages and sites XEO keeps apart from what they are about." .

xeo:entityRef skos:closeMatch schema:sameAs ;
    rdfs:comment "Both point from a thing to the record that identifies it elsewhere. closeMatch: entityRef is an identity key held as a string, schema:sameAs a URL-valued property." .

xeo:about skos:closeMatch schema:about ;
    rdfs:comment "The same aboutness claim, from content to its subject matter. closeMatch, not subPropertyOf: schema:about is expected on a CreativeWork, and XEO's about also runs from a Prompt or a Term, and always carries the method that made the assignment." .

xeo:owns skos:closeMatch schema:owns ;
    rdfs:comment "Working ownership of a Website or Brand; schema:owns is the general 'products owned by the organization or person'." .

xeo:hasWebsite skos:closeMatch schema:url ;
    rdfs:comment "A Brand's site. schema.org says this with a URL value on the brand; XEO points at the Website node so the brand's URLs can be traversed." .

xeo:ExternalEvent skos:closeMatch schema:Event ;
    rdfs:comment "Something that happened at a time. closeMatch: schema:Event is modelled for attended events (a venue, a performer); an XEO ExternalEvent is anything dated that could move a metric." .

xeo:ExternalEvent rdfs:subClassOf prov:Activity ;
    rdfs:comment "An external event is something that occurred over a period and acted on the things measured." .

xeo:AlgorithmRun rdfs:subClassOf prov:Activity ;
    rdfs:comment "An algorithm run is a process that ran at a time and generated the scores and edges attributed to it." .

xeo:DiagnosticRun rdfs:subClassOf prov:Activity ;
    rdfs:comment "A diagnostic run is a process that ran at a time and generated the gaps revealed in it." .

xeo:computedBy rdfs:subPropertyOf prov:wasGeneratedBy ;
    rdfs:comment "A derived value or edge was generated by the run that computed it." .

xeo:revealedIn rdfs:subPropertyOf prov:wasGeneratedBy ;
    rdfs:comment "A gap (the claim, as a record) was generated by the diagnostic run that found it." .

xeo:ranAt rdfs:subPropertyOf prov:endedAtTime ;
    rdfs:comment "When the run activity ended and its outputs were written." .

xeo:startedAt rdfs:subPropertyOf prov:startedAtTime ;
    rdfs:comment "When the episode (a crawl, an experiment) began." .

xeo:endedAt rdfs:subPropertyOf prov:endedAtTime ;
    rdfs:comment "When the episode ended." .

xeo:learnedFrom rdfs:subPropertyOf prov:wasDerivedFrom ;
    rdfs:comment "A learned practice is derived from the experiments and outcomes it was earned from." .

xeo:implementedAs rdfs:seeAlso prov:wasInformedBy ;
    rdfs:comment "The experiment was informed by the recommendation it implements. seeAlso only: prov:wasInformedBy relates two activities, and a Recommendation is a claim, not an activity." .

xeo:Framework skos:closeMatch schema:HowTo ;
    rdfs:comment "A named method with steps. closeMatch: schema:HowTo is instructions for a reader to follow; an XEO Framework is a structure that diagnostics, tactics and practices are placed on." .

xeo:Stage skos:closeMatch schema:HowToStep .

# ===========================================================================
# v0.6.0 (canonical parties, 2026-11-12) — appended at the foot.
#
# Person and Organization are the same things schema.org names, so they are
# skos:exactMatch: "the same as", stated as a SKOS mapping. That keeps the
# stance above. It asserts no owl:equivalentClass, imports nothing from
# schema.org, and forces no entailment; XEO still loads without schema.org.
# This replaces the closeMatch Organization carried earlier in 0.6.0, which was
# never published.
#
# xeo:refersTo has no bridge. schema:sameAs points from a thing to a page that
# identifies it; refersTo points from one system's record to the canonical
# node, and carries the method of the match.
# ===========================================================================

xeo:Organization skos:exactMatch schema:Organization ;
    rdfs:comment "The same thing: an organization. exactMatch, because the canonical XEO Organization is one node per real organization, which is what schema:Organization describes; no XEO restriction narrows it." .

xeo:Person skos:exactMatch schema:Person ;
    rdfs:comment "The same thing: a person. exactMatch, because the canonical XEO Person is one node per real person, which is what schema:Person describes. XEO declares none of schema.org's person properties; a consumer may add them from schema.org." .

# ===========================================================================
# Consent (core, 0.7) — W3C Data Privacy Vocabulary (DPV).
# Close matches only: DPV models consent as a legal basis with its own status
# lifecycle; XEO records one captured choice and makes no legal judgement.
# ===========================================================================

@prefix dpv: <https://w3id.org/dpv#> .

xeo:Consent skos:closeMatch dpv:Consent ;
    rdfs:comment "Close, not exact: dpv:Consent is consent as a legal basis, with validity and withdrawal; xeo:Consent is one choice as a system recorded it, and validity is left to an interpretation." .

xeo:consentSubject skos:closeMatch dpv:hasDataSubject .
xeo:consentPurpose skos:closeMatch dpv:hasPurpose .
xeo:consentStatus skos:closeMatch dpv:hasConsentStatus .

# Model (core, 0.7) — schema.org has no model class; ML-Schema is aligned with the
# agentic engineering module after 0.7.

# ===========================================================================
# Draft: the experiments and company knowledge modules (0.8), appended
# at the foot. Their terms are draft, and so are these bridges. Same two stances
# as above. ML-Schema is the W3C community group's vocabulary for machine-learning
# experiments; the W3C Organization Ontology (2014) is where memberOf and unitOf
# come from. Message, Conversation and DigitalDocument need no bridge: XEO mints
# no class for them and a graph uses schema.org's own.
# ===========================================================================

@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix org: <http://www.w3.org/ns/org#> .

xeo:Experiment skos:closeMatch mls:Experiment ;
    rdfs:comment "Both are a test made of runs. closeMatch: an ML-Schema experiment is a collection of runs of machine-learning implementations; an XEO Experiment tests a tactic, on pages, terms or benchmark tasks." .

xeo:Trial skos:closeMatch mls:Run ;
    rdfs:comment "One execution of one condition. closeMatch: an ML-Schema run executes an implementation on data; an XEO Trial runs one arm on one task." .

xeo:Trial rdfs:subClassOf prov:Activity ;
    rdfs:comment "A trial ran over a period and generated the score attributed to it." .

xeo:Claim skos:closeMatch schema:Claim ;
    rdfs:comment "An assertion someone made. closeMatch: schema:Claim is a factual claim as fact-checkers record it; an XEO Claim is about an effect and states the number, metric and baseline it implies." .

xeo:ClaimCheck skos:closeMatch schema:ClaimReview ;
    rdfs:comment "A review of a claim with a verdict. closeMatch: a schema:ClaimReview rates a claim; an XEO ClaimCheck must rest on an Experiment." .

xeo:drawnFrom rdfs:subPropertyOf prov:wasDerivedFrom ;
    rdfs:comment "A lesson is derived from the experiments, outcomes and checks it was drawn from." .

xeo:Meeting skos:closeMatch schema:Event ;
    rdfs:comment "Something that happened at a time with people at it. closeMatch: schema.org has no meeting class, and schema:Event is modelled for attended events (a venue, a performer)." .

xeo:Recording skos:closeMatch schema:MediaObject ;
    rdfs:comment "An audio or video file. schema:AudioObject and schema:VideoObject are its two kinds; XEO keeps one class and the file's address." .

xeo:Transcript skos:closeMatch schema:TextDigitalDocument ;
    rdfs:comment "Text kept as a file of its own. schema.org has no transcript class: its transcript is a text property on an AudioObject or VideoObject, which XEO keeps out of the graph." .

xeo:attendee skos:closeMatch schema:attendee ;
    rdfs:comment "A person at an event. closeMatch: schema:attendee also allows an Organization." .

xeo:recordingOf skos:closeMatch schema:recordedAt ;
    rdfs:comment "The event a recording was made at." .

xeo:transcriptOf rdfs:subPropertyOf prov:wasDerivedFrom ;
    rdfs:comment "A transcript is derived from the recording it was made from." .

xeo:summarizes rdfs:subPropertyOf prov:wasDerivedFrom ;
    rdfs:comment "A summary is derived from the record it summarizes." .

xeo:memberOf skos:closeMatch org:memberOf ;
    rdfs:comment "A person belongs to an organization; schema:memberOf says the same. closeMatch: W3C ORG reifies the membership as org:Membership when it needs dates and a role; XEO carries the dates on the edge." .

xeo:unitOf skos:closeMatch org:unitOf ;
    rdfs:comment "A unit and the organization it is part of; schema:parentOrganization says the same. closeMatch: org:unitOf points from an OrganizationalUnit to a FormalOrganization; an XEO unit is an Organization of its own." .

# ===========================================================================
# Draft: the design module (0.8), appended at the foot. Its terms are draft, and
# so are these bridges. Same two stances as above. The W3C Design Tokens Format
# is a JSON format, not an RDF vocabulary, so there is nothing to bridge to: the
# module follows its type names (xeos:tokenType) and its alias instead.
# ===========================================================================

xeo:DesignAsset skos:closeMatch schema:MediaObject ;
    rdfs:comment "A file used in a design. closeMatch: schema:ImageObject, schema:VideoObject and schema:AudioObject are its kinds there; schema.org has no class for a font file, and XEO keeps one class with an assetKind." .

xeo:DesignConcept skos:closeMatch schema:CreativeWork ;
    rdfs:comment "A made picture of a proposal. closeMatch: schema:CreativeWork is any made work; a DesignConcept is one proposal for one piece of interface, under one direction." .

xeo:DesignDecision skos:closeMatch schema:Review ;
    rdfs:comment "A person's judgment of an item, with their reason. closeMatch: a schema:Review rates an item; a DesignDecision makes a call (keep, replace, approve) and may hold under one direction only." .

xeo:usesAsset skos:closeMatch schema:associatedMedia ;
    rdfs:comment "A media file a work or page uses. closeMatch: schema:associatedMedia is on any CreativeWork." .
