    skos:prefLabel "Value periods"@en ;
    xeo:fillsSlot xeo:valuePeriod ;
    xeo:termStatus "extension" ;
    dct:source "XEO CRM pipeline research report, 2026-11-10 (three of seven CRMs record a recurring value). The three codes are inferred for XEO from the fields those CRMs expose (a one-time value, a monthly and an annual recurring value); no vendor's list is adopted" ;
    dct:description "The period a recurringValue recurs over." .

xeos:valuePeriod-one_time a skos:Concept ;
    skos:inScheme xeos:valuePeriod ;
    skos:topConceptOf xeos:valuePeriod ;
    skos:notation "one_time" ;
    skos:prefLabel "One-time"@en ;
    skos:definition "Not recurring"@en .

xeos:valuePeriod-monthly a skos:Concept ;
    skos:inScheme xeos:valuePeriod ;
    skos:topConceptOf xeos:valuePeriod ;
    skos:notation "monthly" ;
    skos:prefLabel "Monthly"@en ;
    skos:definition "Recurs each month"@en .

xeos:valuePeriod-annual a skos:Concept ;
    skos:inScheme xeos:valuePeriod ;
    skos:topConceptOf xeos:valuePeriod ;
    skos:notation "annual" ;
