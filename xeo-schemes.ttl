@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xeo:  <https://xeoontology.org/xeo#> .
@prefix xeos: <https://xeoontology.org/schemes#> .

# XEO Reference Schemes — the values, published.
#
# XEO ships CLASSES, never VALUES. xeo:Gap is in the ontology; "thin content" is
# not — xeo:gapType is a skos:Concept slot and the ontology tells you to bring
# your own scheme. That is the right rule for a public standard, and it has a
# consequence: a slot nobody fills gets filled locally, once per consumer, in
# prose. Nine MCP servers describing the same recommendation status five
# different ways is what that looks like.
#
# This module fills the slots. Every scheme here is the vocabulary one agency —
# Inbound Found — actually runs in production, lifted verbatim from the repo named
# in its dct:source, and published under its own namespace (xeos:) so it stays
# separable from the ontology proper. Adopt a scheme as-is, extend it, or replace
# it wholesale: the SLOT is what XEO defines; a scheme is one answer.
#
# Two conventions make these consumable by software rather than only by people:
#   * skos:notation on every concept is the exact string a system stores or sends
#     ('missing_page', 'P0'). It is the code. prefLabel is what an operator reads.
#   * schemes.json is a generated projection of this file (tools/gen_schemes.py):
#     the same schemes as plain JSON, so a Python catalog or a JSON Schema enum
#     can read them at boot without parsing Turtle. Never edit it by hand.
#
# Ordered schemes carry a skos:OrderedCollection; the order is meaningful (a
# lifecycle, a priority ladder, the stated priority of gap types).

xeo:schemes-module a owl:Ontology ;
    dct:title "XEO Reference Schemes" ;
    dct:description "SKOS concept schemes filling the slots the XEO ontology leaves open — gap types, verdicts, priorities, the intervention catalogue, lifecycles, metrics. Published reference values, not part of the ontology's class vocabulary; adopt, extend, or replace." ;
    dct:creator "Inbound Found" ;
    rdfs:seeAlso <https://xeoontology.org/schemes.json> ;
    owl:versionInfo "0.6.0" .

xeo:fillsSlot a owl:AnnotationProperty ;
    rdfs:comment "Names the XEO property whose skos:Concept range (or controlled-string value) this scheme is a reference filling for — xeo:gapType, xeo:atPriority, xeo:inIntervention, xeo:status. A consumer reading a slot property can follow this to a published default; nothing in the ontology requires it." .

# --- Gap types -----------------------------------------------------------------

xeos:gapType a skos:ConceptScheme ;
    skos:prefLabel "Gap types"@en ;
    xeo:fillsSlot xeo:gapType ;
    dct:source "if-control-center packages/contracts/src/gap.ts (GAP_TYPES, GAP_TYPE_LABELS, GAP_TYPE_HINTS) · launch-guardian LG_GAP_TYPES" ;
    dct:description "The kinds of Gap a Diagnostic can reveal, in the priority order the structural comparison states them. Five structural findings, four deep-content axes (a missing FAQ block, a missing spec table, a missing certification and a page written for the wrong buyer stage are four different interventions drawn from different tactic categories), four non-structural findings, and one site-level finding. There is deliberately no backlink value: the referring-domain profile is a separate remit. domain_authority_deficit is not that — it is the finding that the page fight is already winnable and the SITE is what is losing." .

xeos:gapType-missing_page a skos:Concept ;
    skos:inScheme xeos:gapType ;
    skos:topConceptOf xeos:gapType ;
    skos:notation "missing_page" ;
    skos:prefLabel "No page for this topic"@en ;
    skos:definition "They hold a page for this topic and we have none"@en .

xeos:gapType-orphaned a skos:Concept ;
    skos:inScheme xeos:gapType ;
    skos:topConceptOf xeos:gapType ;
    skos:notation "orphaned" ;
    skos:prefLabel "Orphaned page"@en ;
    skos:definition "Strong content almost nothing links to — a promotion problem, not a content one"@en .

xeos:gapType-buried a skos:Concept ;
    skos:inScheme xeos:gapType ;
    skos:topConceptOf xeos:gapType ;
    skos:notation "buried" ;
    skos:prefLabel "Buried in the architecture"@en ;
    skos:definition "Served from too deep in the site against a top-level page"@en .

xeos:gapType-thin_content a skos:Concept ;
    skos:inScheme xeos:gapType ;
    skos:topConceptOf xeos:gapType ;
    skos:notation "thin_content" ;
    skos:prefLabel "Thin page"@en ;
    skos:definition "Comparable page, materially less on it"@en .

xeos:gapType-split a skos:Concept ;
    skos:inScheme xeos:gapType ;
    skos:topConceptOf xeos:gapType ;
    skos:notation "split" ;
    skos:prefLabel "Split across pages"@en ;
    skos:definition "Several of our pages share this topic and compete with each other"@en .

xeos:gapType-content_subtopic a skos:Concept ;
    skos:inScheme xeos:gapType ;
    skos:topConceptOf xeos:gapType ;
    skos:notation "content_subtopic" ;
    skos:prefLabel "Missing subtopic"@en ;
    skos:definition "Questions their page answers and ours does not"@en .

xeos:gapType-content_format_asset a skos:Concept ;
    skos:inScheme xeos:gapType ;
    skos:topConceptOf xeos:gapType ;
    skos:notation "content_format_asset" ;
    skos:prefLabel "Missing format asset"@en ;
    skos:definition "Specs, comparison tables, calculators, downloads or schema we lack"@en .

xeos:gapType-content_proof a skos:Concept ;
    skos:inScheme xeos:gapType ;
    skos:topConceptOf xeos:gapType ;
    skos:notation "content_proof" ;
    skos:prefLabel "Missing proof"@en ;
    skos:definition "Named projects, data or certifications we do not show"@en .

xeos:gapType-content_intent_fit a skos:Concept ;
    skos:inScheme xeos:gapType ;
    skos:topConceptOf xeos:gapType ;
    skos:notation "content_intent_fit" ;
    skos:prefLabel "Buyer-stage mismatch"@en ;
    skos:definition "Theirs is written for a different stage of the buyer journey"@en .

xeos:gapType-visibility_deficit a skos:Concept ;
    skos:inScheme xeos:gapType ;
    skos:topConceptOf xeos:gapType ;
    skos:notation "visibility_deficit" ;
    skos:prefLabel "Visibility shortfall"@en ;
    skos:definition "Estimated traffic we are losing on this topic"@en .

xeos:gapType-position_climb a skos:Concept ;
    skos:inScheme xeos:gapType ;
    skos:topConceptOf xeos:gapType ;
    skos:notation "position_climb" ;
    skos:prefLabel "Position climb"@en ;
    skos:definition "We already rank here — this is a climb on an asset we own"@en .

xeos:gapType-zero_click a skos:Concept ;
    skos:inScheme xeos:gapType ;
    skos:topConceptOf xeos:gapType ;
    skos:notation "zero_click" ;
    skos:prefLabel "Ranking without clicks"@en ;
    skos:definition "On page one, drawing impressions and no clicks — snippet and intent work"@en .

xeos:gapType-project_footprint a skos:Concept ;
    skos:inScheme xeos:gapType ;
    skos:topConceptOf xeos:gapType ;
    skos:notation "project_footprint" ;
    skos:prefLabel "Project footprint"@en ;
    skos:definition "They rank for named projects that represent a portfolio asset"@en .

xeos:gapType-domain_authority_deficit a skos:Concept ;
    skos:inScheme xeos:gapType ;
    skos:topConceptOf xeos:gapType ;
    skos:notation "domain_authority_deficit" ;
    skos:prefLabel "Outranked by the site, not the page"@en ;
    skos:definition "Our page holds up, but their domain outranks ours — a satellite, not a page edit"@en .

xeos:gapType-order a skos:OrderedCollection ;
    skos:prefLabel "Gap types (ordered)"@en ;
    skos:inScheme xeos:gapType ;
    skos:memberList ( xeos:gapType-missing_page xeos:gapType-orphaned xeos:gapType-buried xeos:gapType-thin_content xeos:gapType-split xeos:gapType-content_subtopic xeos:gapType-content_format_asset xeos:gapType-content_proof xeos:gapType-content_intent_fit xeos:gapType-visibility_deficit xeos:gapType-position_climb xeos:gapType-zero_click xeos:gapType-project_footprint xeos:gapType-domain_authority_deficit ) .

# --- Gap verdicts --------------------------------------------------------------

xeos:gapVerdict a skos:ConceptScheme ;
    skos:prefLabel "Gap verdicts"@en ;
    xeo:fillsSlot xeo:verdict ;
    dct:source "if-control-center packages/contracts/src/gap.ts (GAP_VERDICTS) · launch-guardian LG_GAP_VERDICTS" ;
    dct:description "A topic's disposition on the scoreboard — the operator-facing decision about a Gap. Carried by exactly one finding per topic per analysis: a verdict is a property of the topic, and a topic's other findings carry none rather than repeating a disposition the analysis did not reach for them." .

xeos:gapVerdict-attack a skos:Concept ;
    skos:inScheme xeos:gapVerdict ;
    skos:topConceptOf xeos:gapVerdict ;
    skos:notation "attack" ;
    skos:prefLabel "Attack"@en ;
    skos:definition "They hold a strong page and we have none or a weak one"@en .

xeos:gapVerdict-fix_first a skos:Concept ;
    skos:inScheme xeos:gapVerdict ;
    skos:topConceptOf xeos:gapVerdict ;
    skos:notation "fix_first" ;
    skos:prefLabel "Fix first"@en ;
    skos:definition "Our content is strong but orphaned, split or buried"@en .

xeos:gapVerdict-defend a skos:Concept ;
    skos:inScheme xeos:gapVerdict ;
    skos:topConceptOf xeos:gapVerdict ;
    skos:notation "defend" ;
    skos:prefLabel "Defend"@en ;
    skos:definition "Comparable, and our own trend is falling"@en .

xeos:gapVerdict-hold a skos:Concept ;
    skos:inScheme xeos:gapVerdict ;
    skos:topConceptOf xeos:gapVerdict ;
    skos:notation "hold" ;
    skos:prefLabel "Hold"@en ;
    skos:definition "Ours is the stronger page"@en .

xeos:gapVerdict-ignore a skos:Concept ;
    skos:inScheme xeos:gapVerdict ;
    skos:topConceptOf xeos:gapVerdict ;
    skos:notation "ignore" ;
    skos:prefLabel "Ignore"@en ;
    skos:definition "Off-ICP or unwinnable"@en .

# --- Magnitude units -----------------------------------------------------------

xeos:magnitudeUnit a skos:ConceptScheme ;
    skos:prefLabel "Magnitude units"@en ;
    xeo:fillsSlot xeo:magnitudeUnit ;
    dct:source "if-control-center packages/contracts/src/gap.ts (MAGNITUDE_UNITS) · launch-guardian LG_MAGNITUDE_UNITS" ;
    dct:description "The unit of a Gap's size, where the finding IS a size. A magnitude is never rendered bare. sessions_estimated names the CTR-model provenance in the unit itself, so a derived session figure can never render as a measured one. referring_domains counts domains pointing at a site and is deliberately a separate unit from inlinks, which counts a crawl's internal links — one unit for both would invite a comparison between them." .

xeos:magnitudeUnit-sessions_estimated a skos:Concept ;
    skos:inScheme xeos:magnitudeUnit ;
    skos:topConceptOf xeos:magnitudeUnit ;
    skos:notation "sessions_estimated" ;
    skos:prefLabel "Sessions (estimated)"@en ;
    skos:definition "≈{n} sessions/mo, derived by a CTR model — never a measured figure"@en .

xeos:magnitudeUnit-impressions a skos:Concept ;
    skos:inScheme xeos:magnitudeUnit ;
    skos:topConceptOf xeos:magnitudeUnit ;
    skos:notation "impressions" ;
    skos:prefLabel "Impressions"@en ;
    skos:definition "{n} impressions"@en .

xeos:magnitudeUnit-clicks a skos:Concept ;
    skos:inScheme xeos:magnitudeUnit ;
    skos:topConceptOf xeos:magnitudeUnit ;
    skos:notation "clicks" ;
    skos:prefLabel "Clicks"@en ;
    skos:definition "{n} clicks"@en .

xeos:magnitudeUnit-inlinks a skos:Concept ;
    skos:inScheme xeos:magnitudeUnit ;
    skos:topConceptOf xeos:magnitudeUnit ;
    skos:notation "inlinks" ;
    skos:prefLabel "Internal links"@en ;
    skos:definition "{n} internal links, counted by a crawl"@en .

xeos:magnitudeUnit-referring_domains a skos:Concept ;
    skos:inScheme xeos:magnitudeUnit ;
    skos:topConceptOf xeos:magnitudeUnit ;
    skos:notation "referring_domains" ;
    skos:prefLabel "Referring domains"@en ;
    skos:definition "{n} referring domains pointing at the site"@en .

xeos:magnitudeUnit-words a skos:Concept ;
    skos:inScheme xeos:magnitudeUnit ;
    skos:topConceptOf xeos:magnitudeUnit ;
    skos:notation "words" ;
    skos:prefLabel "Words"@en ;
    skos:definition "{n} words"@en .

xeos:magnitudeUnit-positions a skos:Concept ;
    skos:inScheme xeos:magnitudeUnit ;
    skos:topConceptOf xeos:magnitudeUnit ;
    skos:notation "positions" ;
    skos:prefLabel "Positions"@en ;
    skos:definition "{n} positions"@en .

xeos:magnitudeUnit-keywords a skos:Concept ;
    skos:inScheme xeos:magnitudeUnit ;
    skos:topConceptOf xeos:magnitudeUnit ;
    skos:notation "keywords" ;
    skos:prefLabel "Keywords"@en ;
    skos:definition "{n} keywords"@en .

# --- Priority tiers ------------------------------------------------------------

xeos:priority a skos:ConceptScheme ;
    skos:prefLabel "Priority tiers"@en ;
    xeo:fillsSlot xeo:atPriority ;
    dct:source "if-control-center packages/contracts/src/recommendation.ts (RECOMMENDATION_PRIORITY_TIERS) · launch-guardian" ;
    dct:description "The priority a Recommendation is issued at. Three tiers, read as a horizon rather than a severity: now, next, later. Where another system speaks critical/high/medium/low, map critical and high to P0, medium to P1, low to P2 — the mapping is documented here so it is not re-decided per consumer." .

xeos:priority-P0 a skos:Concept ;
    skos:inScheme xeos:priority ;
    skos:topConceptOf xeos:priority ;
    skos:notation "P0" ;
    skos:prefLabel "Now"@en ;
    skos:definition "Do this in the current cycle"@en .

xeos:priority-P1 a skos:Concept ;
    skos:inScheme xeos:priority ;
    skos:topConceptOf xeos:priority ;
    skos:notation "P1" ;
    skos:prefLabel "Next"@en ;
    skos:definition "Queued behind the current cycle"@en .

xeos:priority-P2 a skos:Concept ;
    skos:inScheme xeos:priority ;
    skos:topConceptOf xeos:priority ;
    skos:notation "P2" ;
    skos:prefLabel "Later"@en ;
    skos:definition "Worth doing; not yet scheduled"@en .

xeos:priority-order a skos:OrderedCollection ;
    skos:prefLabel "Priority tiers (ordered)"@en ;
    skos:inScheme xeos:priority ;
    skos:memberList ( xeos:priority-P0 xeos:priority-P1 xeos:priority-P2 ) .

# --- Interventions — the service catalogue -------------------------------------

xeos:intervention a skos:ConceptScheme ;
    skos:prefLabel "Interventions — the service catalogue"@en ;
    xeo:fillsSlot xeo:inIntervention ;
    dct:source "xeo-graph-kit seed/framework.cypher (InterventionType) · if-event-ledger tactic_category (numeric codes, served by the ledger's catalog endpoint)" ;
    dct:description "The categories of work an agency can deploy — its service catalogue, as XEO's Intervention taxonomy. A Tactic is inIntervention exactly one of these; a Project's contract scope is expressed over them. Each carries who controls the work (agency, client, or the community) and a typical lead time, because both decide whether a recommendation is deliverable or advisory. The experiment ledger keys the same categories by numeric code; that crosswalk is the ledger's own catalogue, not restated here." .

xeos:intervention-editorial-placement a skos:Concept , xeo:Intervention ;
    skos:inScheme xeos:intervention ;
    skos:topConceptOf xeos:intervention ;
    skos:notation "editorial-placement" ;
    skos:prefLabel "Third-party editorial placement"@en ;
    skos:definition "Earned media: a placement on a third-party editorial surface"@en ;
    skos:note "category earned media · controlled by agency · lead time 2–4 weeks"@en .

xeos:intervention-local-placement a skos:Concept , xeo:Intervention ;
    skos:inScheme xeos:intervention ;
    skos:topConceptOf xeos:intervention ;
    skos:notation "local-placement" ;
    skos:prefLabel "Local / community placement"@en ;
    skos:definition "Earned media: a placement on a local or community surface"@en ;
    skos:note "category earned media · controlled by agency · lead time 2–4 weeks"@en .

xeos:intervention-owned-content-creation a skos:Concept , xeo:Intervention ;
    skos:inScheme xeos:intervention ;
    skos:topConceptOf xeos:intervention ;
    skos:notation "owned-content-creation" ;
    skos:prefLabel "Owned content creation"@en ;
    skos:definition "New pages or assets on the client's own site"@en ;
    skos:note "category content creation · controlled by agency · lead time 4–8 weeks"@en .

xeos:intervention-content-optimization a skos:Concept , xeo:Intervention ;
    skos:inScheme xeos:intervention ;
    skos:topConceptOf xeos:intervention ;
    skos:notation "content-optimization" ;
    skos:prefLabel "Content optimization / refresh"@en ;
    skos:definition "Revising pages the client already holds"@en ;
    skos:note "category content optimization · controlled by agency · lead time 1–2 weeks"@en .

xeos:intervention-technical-onsite a skos:Concept , xeo:Intervention ;
    skos:inScheme xeos:intervention ;
    skos:topConceptOf xeos:intervention ;
    skos:notation "technical-onsite" ;
    skos:prefLabel "Technical onsite work"@en ;
    skos:definition "Site infrastructure, rendering, schema, performance — executed by the client's engineers"@en ;
    skos:note "category consulting · controlled by client · lead time variable"@en .

xeos:intervention-onsite-content-advisory a skos:Concept , xeo:Intervention ;
    skos:inScheme xeos:intervention ;
    skos:topConceptOf xeos:intervention ;
    skos:notation "onsite-content-advisory" ;
    skos:prefLabel "Onsite content advisory"@en ;
    skos:definition "Content direction the client's own team executes"@en ;
    skos:note "category consulting · controlled by client · lead time variable"@en .

xeos:intervention-brand-entity-ops a skos:Concept , xeo:Intervention ;
    skos:inScheme xeos:intervention ;
    skos:topConceptOf xeos:intervention ;
    skos:notation "brand-entity-ops" ;
    skos:prefLabel "Brand / entity operations"@en ;
    skos:definition "Entity truth, author entities, brand accuracy across the web"@en ;
    skos:note "category consulting · controlled by client · lead time variable"@en .

xeos:intervention-community-mobilization a skos:Concept , xeo:Intervention ;
    skos:inScheme xeos:intervention ;
    skos:topConceptOf xeos:intervention ;
    skos:notation "community-mobilization" ;
    skos:prefLabel "Community mobilization"@en ;
    skos:definition "The floor beneath the floor — only works if the counter-narrative already exists unprompted"@en ;
    skos:note "category community · controlled by community · lead time 8+ weeks"@en .

# --- Recommendation execution lifecycle ----------------------------------------

xeos:recommendationStatus a skos:ConceptScheme ;
    skos:prefLabel "Recommendation execution lifecycle"@en ;
    xeo:fillsSlot xeo:status ;
    dct:source "if-control-center packages/contracts/src/recommendation.ts (RECOMMENDATION_STATUSES) · launch-guardian LG_RECOMMENDATION_STATUSES" ;
    dct:description "The execution lifecycle of a Recommendation, as xeo:status on that node. pending, in_progress and blocked are the OPEN states — they still consume an engagement's intervention quota. The delivery board buckets these five into recommended / active / blocked / measuring / completed, where measuring is a completed recommendation still inside its results window; that bucketing is a derived view, not a second vocabulary. A system with a skipped state maps it to cancelled." .

xeos:recommendationStatus-pending a skos:Concept ;
    skos:inScheme xeos:recommendationStatus ;
    skos:topConceptOf xeos:recommendationStatus ;
    skos:notation "pending" ;
    skos:prefLabel "Proposed"@en ;
    skos:definition "Issued and not yet started; counts as open work"@en .

xeos:recommendationStatus-in_progress a skos:Concept ;
    skos:inScheme xeos:recommendationStatus ;
    skos:topConceptOf xeos:recommendationStatus ;
    skos:notation "in_progress" ;
    skos:prefLabel "In progress"@en ;
    skos:definition "Being executed; counts as open work"@en .

xeos:recommendationStatus-blocked a skos:Concept ;
    skos:inScheme xeos:recommendationStatus ;
    skos:topConceptOf xeos:recommendationStatus ;
    skos:notation "blocked" ;
    skos:prefLabel "Blocked"@en ;
    skos:definition "Cannot proceed — a dependency, an approval, or a client direction; still counts as open work"@en .

xeos:recommendationStatus-cancelled a skos:Concept ;
    skos:inScheme xeos:recommendationStatus ;
    skos:topConceptOf xeos:recommendationStatus ;
    skos:notation "cancelled" ;
    skos:prefLabel "Cancelled"@en ;
    skos:definition "Withdrawn with a recorded reason; never silently dropped"@en .

xeos:recommendationStatus-completed a skos:Concept ;
    skos:inScheme xeos:recommendationStatus ;
    skos:topConceptOf xeos:recommendationStatus ;
    skos:notation "completed" ;
    skos:prefLabel "Done"@en ;
    skos:definition "Shipped; measuring until its results window closes"@en .

xeos:recommendationStatus-order a skos:OrderedCollection ;
    skos:prefLabel "Recommendation execution lifecycle (ordered)"@en ;
    skos:inScheme xeos:recommendationStatus ;
    skos:memberList ( xeos:recommendationStatus-pending xeos:recommendationStatus-in_progress xeos:recommendationStatus-blocked xeos:recommendationStatus-cancelled xeos:recommendationStatus-completed ) .

# --- Effort estimates ----------------------------------------------------------

xeos:effort a skos:ConceptScheme ;
    skos:prefLabel "Effort estimates"@en ;
    xeo:fillsSlot xeo:effortEstimate ;
    dct:source "if-control-center packages/contracts/src/recommendation.ts (RECOMMENDATION_EFFORTS)" ;
    dct:description "How long a Recommendation is expected to take to execute — a categorical horizon, not a score. Scored dimensions (impact, risk, time-to-value) belong on a TacticAssessment via onDimension; this is the delivery-side estimate an operator plans a cycle around." .

xeos:effort-hours a skos:Concept ;
    skos:inScheme xeos:effort ;
    skos:topConceptOf xeos:effort ;
    skos:notation "hours" ;
    skos:prefLabel "Hours"@en ;
    skos:definition "Done inside a working day"@en .

xeos:effort-days a skos:Concept ;
    skos:inScheme xeos:effort ;
    skos:topConceptOf xeos:effort ;
    skos:notation "days" ;
    skos:prefLabel "A day or two"@en ;
    skos:definition "A short, bounded piece of work"@en .

xeos:effort-weeks a skos:Concept ;
    skos:inScheme xeos:effort ;
    skos:topConceptOf xeos:effort ;
    skos:notation "weeks" ;
    skos:prefLabel "Weeks"@en ;
    skos:definition "A multi-week deliverable"@en .

xeos:effort-quarter a skos:Concept ;
    skos:inScheme xeos:effort ;
    skos:topConceptOf xeos:effort ;
    skos:notation "quarter" ;
    skos:prefLabel "A quarter"@en ;
    skos:definition "A programme, not a task"@en .

xeos:effort-order a skos:OrderedCollection ;
    skos:prefLabel "Effort estimates (ordered)"@en ;
    skos:inScheme xeos:effort ;
    skos:memberList ( xeos:effort-hours xeos:effort-days xeos:effort-weeks xeos:effort-quarter ) .

# --- Who executes --------------------------------------------------------------

xeos:execution a skos:ConceptScheme ;
    skos:prefLabel "Who executes"@en ;
    xeo:fillsSlot xeo:execution ;
    dct:source "if-control-center packages/contracts/src/recommendation.ts (RECOMMENDATION_EXECUTIONS)" ;
    dct:description "Who does the work a Recommendation calls for. ours spends the engagement's intervention allowance; advised does not, because advisory work is not agency capacity. This is the delivery-side half of the scope gate: requiresCapability says whether the work is possible, execution says whose hours it costs." .

xeos:execution-ours a skos:Concept ;
    skos:inScheme xeos:execution ;
    skos:topConceptOf xeos:execution ;
    skos:notation "ours" ;
    skos:prefLabel "We do it"@en ;
    skos:definition "Spends the engagement allowance"@en .

xeos:execution-advised a skos:Concept ;
    skos:inScheme xeos:execution ;
    skos:topConceptOf xeos:execution ;
    skos:notation "advised" ;
    skos:prefLabel "Client does it"@en ;
    skos:definition "Advisory — outside the allowance; the client executes"@en .

# --- What a Practice did -------------------------------------------------------

xeos:practiceOutcome a skos:ConceptScheme ;
    skos:prefLabel "What a Practice did"@en ;
    xeo:fillsSlot xeo:practiceOutcome ;
    dct:source "if-control-center packages/contracts/src/recommendation.ts (PRACTICE_OUTCOMES) · launch-guardian LG_PRACTICE_OUTCOMES" ;
    dct:description "What a Practice did to a candidate when it fired — the value carried on the appliedPractice audit edge. One outcome per practiceKind: a guardrail vetoes, a preference reranks, guidance caveats." .

xeos:practiceOutcome-vetoed a skos:Concept ;
    skos:inScheme xeos:practiceOutcome ;
    skos:topConceptOf xeos:practiceOutcome ;
    skos:notation "vetoed" ;
    skos:prefLabel "Blocked"@en ;
    skos:definition "A guardrail removed the candidate"@en .

xeos:practiceOutcome-reranked a skos:Concept ;
    skos:inScheme xeos:practiceOutcome ;
    skos:topConceptOf xeos:practiceOutcome ;
    skos:notation "reranked" ;
    skos:prefLabel "Reordered"@en ;
    skos:definition "A preference moved the candidate up or down"@en .

xeos:practiceOutcome-caveated a skos:Concept ;
    skos:inScheme xeos:practiceOutcome ;
    skos:topConceptOf xeos:practiceOutcome ;
    skos:notation "caveated" ;
    skos:prefLabel "Flagged"@en ;
    skos:definition "Guidance attached a caveat and changed nothing else"@en .

# --- Practice kinds ------------------------------------------------------------

xeos:practiceKind a skos:ConceptScheme ;
    skos:prefLabel "Practice kinds"@en ;
    xeo:fillsSlot xeo:practiceKind ;
    dct:source "xeo-strategy.ttl (xeo:practiceKind) · if-control-center PRACTICE_KINDS" ;
    dct:description "How a Practice acts on a candidate recommendation. Kept as a small controlled value rather than a subclass." .

xeos:practiceKind-guardrail a skos:Concept ;
    skos:inScheme xeos:practiceKind ;
    skos:topConceptOf xeos:practiceKind ;
    skos:notation "guardrail" ;
    skos:prefLabel "Guardrail"@en ;
    skos:definition "Veto a matching candidate"@en .

xeos:practiceKind-preference a skos:Concept ;
    skos:inScheme xeos:practiceKind ;
    skos:topConceptOf xeos:practiceKind ;
    skos:notation "preference" ;
    skos:prefLabel "Preference"@en ;
    skos:definition "Reorder a matching candidate"@en .

xeos:practiceKind-guidance a skos:Concept ;
    skos:inScheme xeos:practiceKind ;
    skos:topConceptOf xeos:practiceKind ;
    skos:notation "guidance" ;
    skos:prefLabel "Guidance"@en ;
    skos:definition "Attach a caveat; change nothing"@en .

# --- Practice provenance -------------------------------------------------------

xeos:practiceSource a skos:ConceptScheme ;
    skos:prefLabel "Practice provenance"@en ;
    xeo:fillsSlot xeo:source ;
    dct:source "xeo-strategy.ttl (xeo:source, on a Practice) · if-control-center PRACTICE_SOURCES" ;
    dct:description "Where a Practice came from — the confidence ratchet. authored stands on a human's authority; claimed ships low-confidence with a halfLife and decays unless experiments promote it; learned is earned from the experiment ledger, and its confidence ratchets with Outcomes. One class holds a firm SOP and a fragile claim without conflating their trust." .

xeos:practiceSource-authored a skos:Concept ;
    skos:inScheme xeos:practiceSource ;
    skos:topConceptOf xeos:practiceSource ;
    skos:notation "authored" ;
    skos:prefLabel "Authored"@en ;
    skos:definition "A human SOP or best-practice — high standing, durable"@en .

xeos:practiceSource-learned a skos:Concept ;
    skos:inScheme xeos:practiceSource ;
    skos:topConceptOf xeos:practiceSource ;
    skos:notation "learned" ;
    skos:prefLabel "Learned"@en ;
    skos:definition "Earned from the experiment ledger; confidence ratchets with Outcomes"@en .

xeos:practiceSource-claimed a skos:Concept ;
    skos:inScheme xeos:practiceSource ;
    skos:topConceptOf xeos:practiceSource ;
    skos:notation "claimed" ;
    skos:prefLabel "Claimed"@en ;
    skos:definition "An unproven assertion — ships low-confidence, decays over its halfLife unless promoted"@en .

# --- Practice lifecycle --------------------------------------------------------

xeos:practiceStatus a skos:ConceptScheme ;
    skos:prefLabel "Practice lifecycle"@en ;
    xeo:fillsSlot xeo:status ;
    dct:source "xeo-strategy.ttl (xeo:status, on a Practice) · if-control-center PRACTICE_STATUSES" ;
    dct:description "Lifecycle of a Practice, as xeo:status on that node. A proposed Practice is visible but does not fire; superseding one deprecates it — retired, never deleted, so the record of what it vetoed survives." .

xeos:practiceStatus-proposed a skos:Concept ;
    skos:inScheme xeos:practiceStatus ;
    skos:topConceptOf xeos:practiceStatus ;
    skos:notation "proposed" ;
    skos:prefLabel "Proposed"@en ;
    skos:definition "Visible; does not fire"@en .

xeos:practiceStatus-active a skos:Concept ;
    skos:inScheme xeos:practiceStatus ;
    skos:topConceptOf xeos:practiceStatus ;
    skos:notation "active" ;
    skos:prefLabel "Active"@en ;
    skos:definition "Fires on matching candidates"@en .

xeos:practiceStatus-deprecated a skos:Concept ;
    skos:inScheme xeos:practiceStatus ;
    skos:topConceptOf xeos:practiceStatus ;
    skos:notation "deprecated" ;
    skos:prefLabel "Deprecated"@en ;
    skos:definition "Superseded; retained for the audit trail"@en .

xeos:practiceStatus-order a skos:OrderedCollection ;
    skos:prefLabel "Practice lifecycle (ordered)"@en ;
    skos:inScheme xeos:practiceStatus ;
    skos:memberList ( xeos:practiceStatus-proposed xeos:practiceStatus-active xeos:practiceStatus-deprecated ) .

# --- Experiment lifecycle ------------------------------------------------------

xeos:experimentStatus a skos:ConceptScheme ;
    skos:prefLabel "Experiment lifecycle"@en ;
    xeo:fillsSlot xeo:status ;
    dct:source "if-control-center packages/contracts/src/recommendation.ts (EXPERIMENT_STATUSES)" ;
    dct:description "Lifecycle of an Experiment, as xeo:status on that node. unmeasurable covers two arrivals with one word — an operator cleared the measured set, or the website has no search-performance history to measure against; the record says which." .

xeos:experimentStatus-measuring a skos:Concept ;
    skos:inScheme xeos:experimentStatus ;
    skos:topConceptOf xeos:experimentStatus ;
    skos:notation "measuring" ;
    skos:prefLabel "Measuring"@en ;
    skos:definition "Inside its results window; observations still arriving"@en .

xeos:experimentStatus-concluded a skos:Concept ;
    skos:inScheme xeos:experimentStatus ;
    skos:topConceptOf xeos:experimentStatus ;
    skos:notation "concluded" ;
    skos:prefLabel "Concluded"@en ;
    skos:definition "Window closed; an Outcome is recorded and immutable"@en .

xeos:experimentStatus-cancelled a skos:Concept ;
    skos:inScheme xeos:experimentStatus ;
    skos:topConceptOf xeos:experimentStatus ;
    skos:notation "cancelled" ;
    skos:prefLabel "Cancelled"@en ;
    skos:definition "Stopped before conclusion, with a reason"@en .

xeos:experimentStatus-unmeasurable a skos:Concept ;
    skos:inScheme xeos:experimentStatus ;
    skos:topConceptOf xeos:experimentStatus ;
    skos:notation "unmeasurable" ;
    skos:prefLabel "Not measurable"@en ;
    skos:definition "No usable baseline or observation stream"@en .

xeos:experimentStatus-order a skos:OrderedCollection ;
    skos:prefLabel "Experiment lifecycle (ordered)"@en ;
    skos:inScheme xeos:experimentStatus ;
    skos:memberList ( xeos:experimentStatus-measuring xeos:experimentStatus-concluded xeos:experimentStatus-cancelled xeos:experimentStatus-unmeasurable ) .

# --- Outcome results -----------------------------------------------------------

xeos:outcomeResult a skos:ConceptScheme ;
    skos:prefLabel "Outcome results"@en ;
    xeo:fillsSlot xeo:result ;
    dct:source "if-control-center packages/contracts/src/recommendation.ts (OUTCOME_RESULTS)" ;
    dct:description "Whether an Outcome moved. A regression IS significant: result answers did this move, and the lift's sign answers which way. The labels must not smuggle a direction in." .

xeos:outcomeResult-significant a skos:Concept ;
    skos:inScheme xeos:outcomeResult ;
    skos:topConceptOf xeos:outcomeResult ;
    skos:notation "significant" ;
    skos:prefLabel "Moved"@en ;
    skos:definition "The measured change clears the significance bar, in either direction"@en .

xeos:outcomeResult-no_change a skos:Concept ;
    skos:inScheme xeos:outcomeResult ;
    skos:topConceptOf xeos:outcomeResult ;
    skos:notation "no_change" ;
    skos:prefLabel "No change"@en ;
    skos:definition "Measured, and it did not move"@en .

xeos:outcomeResult-inconclusive a skos:Concept ;
    skos:inScheme xeos:outcomeResult ;
    skos:topConceptOf xeos:outcomeResult ;
    skos:notation "inconclusive" ;
    skos:prefLabel "Inconclusive"@en ;
    skos:definition "Could not be judged — see resultReason"@en .

# --- Why an outcome was inconclusive -------------------------------------------

xeos:outcomeResultReason a skos:ConceptScheme ;
    skos:prefLabel "Why an outcome was inconclusive"@en ;
    xeo:fillsSlot xeo:resultReason ;
    dct:source "if-control-center packages/contracts/src/recommendation.ts (OUTCOME_RESULT_REASONS)" ;
    dct:description "Why an Outcome could not be read cleanly. The two confounder reasons read differently on purpose: co_intervention keeps its lift and names the rows it shares attribution with; confounded_external records none. below_volume_floor and no_page_data are not the same sentence — the second asserts an absence, the first says there is data and not yet enough of it." .

xeos:outcomeResultReason-no_qualifying_snapshot a skos:Concept ;
    skos:inScheme xeos:outcomeResultReason ;
    skos:topConceptOf xeos:outcomeResultReason ;
    skos:notation "no_qualifying_snapshot" ;
    skos:prefLabel "Waiting on a reading"@en ;
    skos:definition "No qualifying rank snapshot has arrived yet"@en .

xeos:outcomeResultReason-window_incomplete a skos:Concept ;
    skos:inScheme xeos:outcomeResultReason ;
    skos:topConceptOf xeos:outcomeResultReason ;
    skos:notation "window_incomplete" ;
    skos:prefLabel "Window still filling"@en ;
    skos:definition "The results window has not closed"@en .

xeos:outcomeResultReason-co_intervention a skos:Concept ;
    skos:inScheme xeos:outcomeResultReason ;
    skos:topConceptOf xeos:outcomeResultReason ;
    skos:notation "co_intervention" ;
    skos:prefLabel "Shared with other work of ours"@en ;
    skos:definition "Another of our interventions touched the same pages in the window; lift is kept and attribution is shared"@en .

xeos:outcomeResultReason-confounded_external a skos:Concept ;
    skos:inScheme xeos:outcomeResultReason ;
    skos:topConceptOf xeos:outcomeResultReason ;
    skos:notation "confounded_external" ;
    skos:prefLabel "Something outside our work changed the page"@en ;
    skos:definition "An external event confounds the window; no lift is recorded"@en .

xeos:outcomeResultReason-baseline_unavailable a skos:Concept ;
    skos:inScheme xeos:outcomeResultReason ;
    skos:topConceptOf xeos:outcomeResultReason ;
    skos:notation "baseline_unavailable" ;
    skos:prefLabel "No search history before this shipped"@en ;
    skos:definition "Nothing to compare against"@en .

xeos:outcomeResultReason-no_page_data a skos:Concept ;
    skos:inScheme xeos:outcomeResultReason ;
    skos:topConceptOf xeos:outcomeResultReason ;
    skos:notation "no_page_data" ;
    skos:prefLabel "No search data for this page"@en ;
    skos:definition "A complete window with no rows at all on the address"@en .

xeos:outcomeResultReason-below_volume_floor a skos:Concept ;
    skos:inScheme xeos:outcomeResultReason ;
    skos:topConceptOf xeos:outcomeResultReason ;
    skos:notation "below_volume_floor" ;
    skos:prefLabel "Not enough traffic to judge"@en ;
    skos:definition "There is data, and not yet enough for a rate to mean anything: a reading's denominatorValue is below its Metric's minDenominator"@en .

# --- Objective metrics ---------------------------------------------------------

xeos:objectiveMetric a skos:ConceptScheme ;
    skos:prefLabel "Objective metrics"@en ;
    xeo:fillsSlot xeo:metric ;
    dct:source "if-control-center packages/contracts/src/objective-metric.ts (OBJECTIVE_METRICS, METRIC_DIRECTIONS, METRIC_UNIT_OF) · launch-guardian LG_OBJECTIVE_METRICS" ;
    dct:description "The metrics a MetricTarget can be set on. Half the vocabulary is lower-is-better — position and rank_absolute are 1-based ranks — so a target's direction is DERIVED from the metric, never client input; a shared +20% across metrics would silently ask for a rank 20% worse. The note on each concept records direction and unit. Since 0.6.0 this is the compatibility list: the six codes published before xeo:Metric existed, plus ai_mention_rate and ai_citation_rate added in 0.6.0, each an exactMatch of its Metric in xeos:metric, which is the full reference scheme and where a target's code resolves." .

xeos:objectiveMetric-clicks a skos:Concept ;
    skos:inScheme xeos:objectiveMetric ;
    skos:topConceptOf xeos:objectiveMetric ;
    skos:notation "clicks" ;
    skos:prefLabel "Clicks"@en ;
    skos:definition "Search clicks over the window"@en ;
    skos:note "direction up · unit count · source GSC"@en .

xeos:objectiveMetric-impressions a skos:Concept ;
    skos:inScheme xeos:objectiveMetric ;
    skos:topConceptOf xeos:objectiveMetric ;
    skos:notation "impressions" ;
    skos:prefLabel "Impressions"@en ;
    skos:definition "Search impressions over the window"@en ;
    skos:note "direction up · unit count · source GSC"@en .

xeos:objectiveMetric-ctr a skos:Concept ;
    skos:inScheme xeos:objectiveMetric ;
    skos:topConceptOf xeos:objectiveMetric ;
    skos:notation "ctr" ;
    skos:prefLabel "CTR"@en ;
    skos:definition "Clickthrough rate over the window"@en ;
    skos:note "direction up · unit ratio · source GSC"@en .

xeos:objectiveMetric-position a skos:Concept ;
    skos:inScheme xeos:objectiveMetric ;
    skos:topConceptOf xeos:objectiveMetric ;
    skos:notation "position" ;
    skos:prefLabel "Avg position"@en ;
    skos:definition "Average SERP position over the window"@en ;
    skos:note "direction down · unit rank · source GSC"@en .

xeos:objectiveMetric-rank_absolute a skos:Concept ;
    skos:inScheme xeos:objectiveMetric ;
    skos:topConceptOf xeos:objectiveMetric ;
    skos:notation "rank_absolute" ;
    skos:prefLabel "Rank"@en ;
    skos:definition "Absolute rank from a rank tracker"@en ;
    skos:note "direction down · unit rank · source DataForSEO"@en .

xeos:objectiveMetric-etv a skos:Concept ;
    skos:inScheme xeos:objectiveMetric ;
    skos:topConceptOf xeos:objectiveMetric ;
    skos:notation "etv" ;
    skos:prefLabel "Est. traffic value"@en ;
    skos:definition "Estimated traffic value"@en ;
    skos:note "direction up · unit currency · source DataForSEO"@en .

# --- Engagement types ----------------------------------------------------------

xeos:engagementType a skos:ConceptScheme ;
    skos:prefLabel "Engagement types"@en ;
    xeo:fillsSlot xeo:engagementType ;
    dct:source "if-control-center packages/contracts/src/objective-metric.ts (ENGAGEMENT_TYPES) · launch-guardian LG_ENGAGEMENT_TYPES" ;
    dct:description "The shape of a Project's contract — the discriminator for how its scope is expressed. A retainer caps interventions per recurring period (cadence); a one-off caps them over a fixed run (durationDays). The intervention quota is common to both and always required: a scope of work with no ceiling is not a scope." .

xeos:engagementType-retainer a skos:Concept ;
    skos:inScheme xeos:engagementType ;
    skos:topConceptOf xeos:engagementType ;
    skos:notation "retainer" ;
    skos:prefLabel "Retainer"@en ;
    skos:definition "Recurring; the quota resets every cadence period"@en .

xeos:engagementType-oneoff a skos:Concept ;
    skos:inScheme xeos:engagementType ;
    skos:topConceptOf xeos:engagementType ;
    skos:notation "oneoff" ;
    skos:prefLabel "One-off"@en ;
    skos:definition "Fixed run; the quota covers durationDays"@en .

# --- Retainer cadences ---------------------------------------------------------

xeos:cadence a skos:ConceptScheme ;
    skos:prefLabel "Retainer cadences"@en ;
    xeo:fillsSlot xeo:cadence ;
    dct:source "if-control-center packages/contracts/src/objective-metric.ts (PROJECT_CADENCES) · launch-guardian LG_PROJECT_CADENCES" ;
    dct:description "The recurring period a retainer's intervention quota resets over. Applies to retainer Projects only." .

xeos:cadence-monthly a skos:Concept ;
    skos:inScheme xeos:cadence ;
    skos:topConceptOf xeos:cadence ;
    skos:notation "monthly" ;
    skos:prefLabel "Monthly"@en ;
    skos:definition "Quota resets each month"@en .

xeos:cadence-quarterly a skos:Concept ;
    skos:inScheme xeos:cadence ;
    skos:topConceptOf xeos:cadence ;
    skos:notation "quarterly" ;
    skos:prefLabel "Quarterly"@en ;
    skos:definition "Quota resets each quarter"@en .

xeos:cadence-order a skos:OrderedCollection ;
    skos:prefLabel "Retainer cadences (ordered)"@en ;
    skos:inScheme xeos:cadence ;
    skos:memberList ( xeos:cadence-monthly xeos:cadence-quarterly ) .

# --- Target kinds --------------------------------------------------------------

xeos:targetKind a skos:ConceptScheme ;
    skos:prefLabel "Target kinds"@en ;
    xeo:fillsSlot xeo:targetKind ;
    dct:source "if-control-center packages/contracts/src/objective-metric.ts (OBJECTIVE_TARGET_KINDS) · launch-guardian LG_OBJECTIVE_TARGET_KINDS" ;
    dct:description "How a MetricTarget's targetValue is read: as an absolute value of the metric, or as a percent change from the captured baseline. Since 0.6.0 also as a relative change written as a quotient, or as an absolute change from baseline in the metric's unit." .

xeos:targetKind-absolute a skos:Concept ;
    skos:inScheme xeos:targetKind ;
    skos:topConceptOf xeos:targetKind ;
    skos:notation "absolute" ;
    skos:prefLabel "Absolute"@en ;
    skos:definition "targetValue is a value of the metric itself"@en .

xeos:targetKind-percent a skos:Concept ;
    skos:inScheme xeos:targetKind ;
    skos:topConceptOf xeos:targetKind ;
    skos:notation "percent" ;
    skos:prefLabel "Percent lift"@en ;
    skos:definition "targetValue is a relative change from baseline, in the metric's better direction"@en .

# --- Layers (xeoLayer) ----------------------------------------------------------

xeos:xeoLayer a skos:ConceptScheme ;
    skos:prefLabel "Layers"@en ;
    xeo:fillsSlot xeo:xeoLayer ;
    dct:source "xeo-core.ttl (xeo:xeoLayer)" ;
    dct:description "The six kinds of claim an XEO term can make, in order from bedrock to governance. The annotation property types TERMS; publishing the six here as a scheme gives a consumer tagging INSTANCES the same six values under one IRI each. A graph that stamps instances with their layer uses the same name, xeoLayer, and these six values. Named epistemicLayer until 0.7." .

xeos:xeoLayer-entity a skos:Concept ;
    skos:inScheme xeos:xeoLayer ;
    skos:topConceptOf xeos:xeoLayer ;
    skos:notation "entity" ;
    skos:prefLabel "Entity"@en ;
    skos:definition "A durable identity — a website, a page, a term, a brand"@en .

xeos:xeoLayer-episode a skos:Concept ;
    skos:inScheme xeos:xeoLayer ;
    skos:topConceptOf xeos:xeoLayer ;
    skos:notation "episode" ;
    skos:prefLabel "Episode"@en ;
    skos:definition "Something that happened at a time; immutable once finished — a crawl, a captured response, an experiment"@en .

xeos:xeoLayer-observation a skos:Concept ;
    skos:inScheme xeos:xeoLayer ;
    skos:topConceptOf xeos:xeoLayer ;
    skos:notation "observation" ;
    skos:prefLabel "Observation"@en ;
    skos:definition "A measured fact, grounded in a standard or an API contract"@en .

xeos:xeoLayer-derivation a skos:Concept ;
    skos:inScheme xeos:xeoLayer ;
    skos:topConceptOf xeos:xeoLayer ;
    skos:notation "derivation" ;
    skos:prefLabel "Derivation"@en ;
    skos:definition "Model or algorithm output; carries method, model and confidence"@en .

xeos:xeoLayer-interpretation a skos:Concept ;
    skos:inScheme xeos:xeoLayer ;
    skos:topConceptOf xeos:xeoLayer ;
    skos:notation "interpretation" ;
    skos:prefLabel "Interpretation"@en ;
    skos:definition "A labeled claim — a diagnosed gap, a recommendation, an objective"@en .

xeos:xeoLayer-norm a skos:Concept ;
    skos:inScheme xeos:xeoLayer ;
    skos:topConceptOf xeos:xeoLayer ;
    skos:notation "norm" ;
    skos:prefLabel "Norm"@en ;
    skos:definition "A standing rule about a class of cases — a Practice"@en .

xeos:xeoLayer-order a skos:OrderedCollection ;
    skos:prefLabel "Layers (ordered)"@en ;
    skos:inScheme xeos:xeoLayer ;
    skos:memberList ( xeos:xeoLayer-entity xeos:xeoLayer-episode xeos:xeoLayer-observation xeos:xeoLayer-derivation xeos:xeoLayer-interpretation xeos:xeoLayer-norm ) .

# --- v0.6.0 (kit sync) ---------------------------------------------------------
# Appended at the foot. Nine new schemes for the slots v0.6.0 adds, and two new
# concepts in objectiveMetric. Unlike the schemes above, most of these are not
# lifted from a production repo: they are the reference fillings the
# xeo-graph-kit courses teach with, and each dct:source says so. Same standing
# as every other scheme: adopt, extend, or replace.

# --- SERP result types ---------------------------------------------------------

xeos:serpResultType a skos:ConceptScheme ;
    skos:prefLabel "SERP result types"@en ;
    xeo:fillsSlot xeo:resultType ;
    dct:source "xeo-graph-kit docs/learn/GRAPH-MODEL.md §2 (the kit's SERP loader) · result kinds reported in common by SERP data providers" ;
    dct:description "The kinds of result a results page can carry, as stored on hasResult and relatedTerm. The first is the classic ranked listing; the rest are the features that sit around or above it. Two of them (people_also_ask, related_search) are suggested queries and so ride on relatedTerm, pointing at a Term; the others point at a URL. Engines add and retire features, and each provider names them its own way: map a provider's value to one of these, or extend the scheme. A value here says what kind of block the result was shown in, never how prominent it was." .

xeos:serpResultType-organic a skos:Concept ;
    skos:inScheme xeos:serpResultType ;
    skos:topConceptOf xeos:serpResultType ;
    skos:notation "organic" ;
    skos:prefLabel "Organic result"@en ;
    skos:definition "A standard ranked web result"@en .

xeos:serpResultType-ai_overview a skos:Concept ;
    skos:inScheme xeos:serpResultType ;
    skos:topConceptOf xeos:serpResultType ;
    skos:notation "ai_overview" ;
    skos:prefLabel "AI overview"@en ;
    skos:definition "A generated answer shown on the results page; its cited pages are the results"@en .

xeos:serpResultType-featured_snippet a skos:Concept ;
    skos:inScheme xeos:serpResultType ;
    skos:topConceptOf xeos:serpResultType ;
    skos:notation "featured_snippet" ;
    skos:prefLabel "Featured snippet"@en ;
    skos:definition "An extracted answer shown above the organic results, credited to one page"@en .

xeos:serpResultType-people_also_ask a skos:Concept ;
    skos:inScheme xeos:serpResultType ;
    skos:topConceptOf xeos:serpResultType ;
    skos:notation "people_also_ask" ;
    skos:prefLabel "People also ask"@en ;
    skos:definition "A related question shown in an expandable question box"@en .

xeos:serpResultType-related_search a skos:Concept ;
    skos:inScheme xeos:serpResultType ;
    skos:topConceptOf xeos:serpResultType ;
    skos:notation "related_search" ;
    skos:prefLabel "Related search"@en ;
    skos:definition "A query the engine suggests alongside the results"@en .

xeos:serpResultType-local_pack a skos:Concept ;
    skos:inScheme xeos:serpResultType ;
    skos:topConceptOf xeos:serpResultType ;
    skos:notation "local_pack" ;
    skos:prefLabel "Local pack"@en ;
    skos:definition "A map-backed block of local business listings"@en .

xeos:serpResultType-video a skos:Concept ;
    skos:inScheme xeos:serpResultType ;
    skos:topConceptOf xeos:serpResultType ;
    skos:notation "video" ;
    skos:prefLabel "Video"@en ;
    skos:definition "A result shown in a video block or carousel"@en .

xeos:serpResultType-image a skos:Concept ;
    skos:inScheme xeos:serpResultType ;
    skos:topConceptOf xeos:serpResultType ;
    skos:notation "image" ;
    skos:prefLabel "Image"@en ;
    skos:definition "A result shown in an image block"@en .

xeos:serpResultType-shopping a skos:Concept ;
    skos:inScheme xeos:serpResultType ;
    skos:topConceptOf xeos:serpResultType ;
    skos:notation "shopping" ;
    skos:prefLabel "Shopping"@en ;
    skos:definition "A product listing shown in a shopping block"@en .

xeos:serpResultType-knowledge_panel a skos:Concept ;
    skos:inScheme xeos:serpResultType ;
    skos:topConceptOf xeos:serpResultType ;
    skos:notation "knowledge_panel" ;
    skos:prefLabel "Knowledge panel"@en ;
    skos:definition "A panel about one entity, drawn from the engine's knowledge base"@en .

xeos:serpResultType-top_stories a skos:Concept ;
    skos:inScheme xeos:serpResultType ;
    skos:topConceptOf xeos:serpResultType ;
    skos:notation "top_stories" ;
    skos:prefLabel "Top stories"@en ;
    skos:definition "A result shown in a news block"@en .

xeos:serpResultType-paid a skos:Concept ;
    skos:inScheme xeos:serpResultType ;
    skos:topConceptOf xeos:serpResultType ;
    skos:notation "paid" ;
    skos:prefLabel "Paid"@en ;
    skos:definition "An advertisement"@en .

# --- Link positions ------------------------------------------------------------

xeos:linkPosition a skos:ConceptScheme ;
    skos:prefLabel "Link positions"@en ;
    xeo:fillsSlot xeo:linkPosition ;
    dct:source "Crawler link-position classification (one source: the 'Link Position' column of a Screaming Frog SEO Spider link export) · xeo-graph-kit docs/learn/GRAPH-MODEL.md §1" ;
    dct:description "Where on the source page a hyperlink sits. The slot means the region of the page the link was found in; any one crawler's column is a source of that, mapped onto these codes, and is not the meaning. The split that matters most is content against everything else: a link in the main content was placed by an editor, a link in navigation, header, footer or sidebar comes with the template and appears on every page that uses it." .

xeos:linkPosition-content a skos:Concept ;
    skos:inScheme xeos:linkPosition ;
    skos:topConceptOf xeos:linkPosition ;
    skos:notation "content" ;
    skos:prefLabel "Content"@en ;
    skos:definition "In the main content of the page"@en .

xeos:linkPosition-navigation a skos:Concept ;
    skos:inScheme xeos:linkPosition ;
    skos:topConceptOf xeos:linkPosition ;
    skos:notation "navigation" ;
    skos:prefLabel "Navigation"@en ;
    skos:definition "In a navigation menu"@en .

xeos:linkPosition-header a skos:Concept ;
    skos:inScheme xeos:linkPosition ;
    skos:topConceptOf xeos:linkPosition ;
    skos:notation "header" ;
    skos:prefLabel "Header"@en ;
    skos:definition "In the page header, outside the main navigation"@en .

xeos:linkPosition-footer a skos:Concept ;
    skos:inScheme xeos:linkPosition ;
    skos:topConceptOf xeos:linkPosition ;
    skos:notation "footer" ;
    skos:prefLabel "Footer"@en ;
    skos:definition "In the page footer"@en .

xeos:linkPosition-sidebar a skos:Concept ;
    skos:inScheme xeos:linkPosition ;
    skos:topConceptOf xeos:linkPosition ;
    skos:notation "sidebar" ;
    skos:prefLabel "Sidebar"@en ;
    skos:definition "In a sidebar or aside"@en .

xeos:linkPosition-other a skos:Concept ;
    skos:inScheme xeos:linkPosition ;
    skos:topConceptOf xeos:linkPosition ;
    skos:notation "other" ;
    skos:prefLabel "Other"@en ;
    skos:definition "Somewhere else, or the crawler could not tell"@en .

# --- Similarity bases ----------------------------------------------------------

xeos:similarityBasis a skos:ConceptScheme ;
    skos:prefLabel "Similarity bases"@en ;
    xeo:fillsSlot xeo:basis ;
    dct:source "xeo-graph-kit docs/learn/GRAPH-MODEL.md §4" ;
    dct:description "What was compared to produce a similarity. Carried on every similarTo edge, because two pages can be near on one basis and far on another, and a similarity that does not name its basis cannot be read. Similarities on different bases are not comparable." .

xeos:similarityBasis-shared_terms a skos:Concept ;
    skos:inScheme xeos:similarityBasis ;
    skos:topConceptOf xeos:similarityBasis ;
    skos:notation "shared_terms" ;
    skos:prefLabel "Shared terms"@en ;
    skos:definition "Overlap in the Terms the two rank for or belong to"@en .

xeos:similarityBasis-links a skos:Concept ;
    skos:inScheme xeos:similarityBasis ;
    skos:topConceptOf xeos:similarityBasis ;
    skos:notation "links" ;
    skos:prefLabel "Links"@en ;
    skos:definition "Overlap in what the two link to or are linked from"@en .

xeos:similarityBasis-text_embedding a skos:Concept ;
    skos:inScheme xeos:similarityBasis ;
    skos:topConceptOf xeos:similarityBasis ;
    skos:notation "text_embedding" ;
    skos:prefLabel "Text embedding"@en ;
    skos:definition "Distance between embeddings of the two texts"@en .

xeos:similarityBasis-structural_embedding a skos:Concept ;
    skos:inScheme xeos:similarityBasis ;
    skos:topConceptOf xeos:similarityBasis ;
    skos:notation "structural_embedding" ;
    skos:prefLabel "Structural embedding"@en ;
    skos:definition "Distance between node embeddings computed from graph structure"@en .

xeos:similarityBasis-lexical a skos:Concept ;
    skos:inScheme xeos:similarityBasis ;
    skos:topConceptOf xeos:similarityBasis ;
    skos:notation "lexical" ;
    skos:prefLabel "Lexical"@en ;
    skos:definition "Overlap in surface strings: tokens, n-grams, edit distance"@en .

# --- Algorithms ----------------------------------------------------------------

xeos:algorithm a skos:ConceptScheme ;
    skos:prefLabel "Algorithms"@en ;
    xeo:fillsSlot xeo:algorithm ;
    dct:source "xeo-graph-kit docs/learn/GRAPH-MODEL.md §5 · the published algorithms named in each definition" ;
    dct:description "The methods an AlgorithmRun can execute. Each concept names the published algorithm, not a library's procedure: the implementing library and its version are parameters of the run. Three families: centrality (pagerank, betweenness, degree), community detection (louvain, leiden, label_propagation), and similarity or embedding (node_similarity, fastrp, knn, cosine), plus shortest_path. Extend it with whatever else you run." .

xeos:algorithm-pagerank a skos:Concept ;
    skos:inScheme xeos:algorithm ;
    skos:topConceptOf xeos:algorithm ;
    skos:notation "pagerank" ;
    skos:prefLabel "PageRank"@en ;
    skos:definition "Stationary distribution of a damped random walk over the edges (Brin and Page, 1998)"@en .

xeos:algorithm-betweenness a skos:Concept ;
    skos:inScheme xeos:algorithm ;
    skos:topConceptOf xeos:algorithm ;
    skos:notation "betweenness" ;
    skos:prefLabel "Betweenness centrality"@en ;
    skos:definition "Share of shortest paths between other nodes that pass through a node (Freeman, 1977)"@en .

xeos:algorithm-degree a skos:Concept ;
    skos:inScheme xeos:algorithm ;
    skos:topConceptOf xeos:algorithm ;
    skos:notation "degree" ;
    skos:prefLabel "Degree centrality"@en ;
    skos:definition "Count of edges touching a node, in a stated orientation"@en .

xeos:algorithm-louvain a skos:Concept ;
    skos:inScheme xeos:algorithm ;
    skos:topConceptOf xeos:algorithm ;
    skos:notation "louvain" ;
    skos:prefLabel "Louvain"@en ;
    skos:definition "Community detection by greedy modularity optimisation (Blondel et al., 2008)"@en .

xeos:algorithm-leiden a skos:Concept ;
    skos:inScheme xeos:algorithm ;
    skos:topConceptOf xeos:algorithm ;
    skos:notation "leiden" ;
    skos:prefLabel "Leiden"@en ;
    skos:definition "Community detection that refines Louvain to guarantee connected communities (Traag et al., 2019)"@en .

xeos:algorithm-label_propagation a skos:Concept ;
    skos:inScheme xeos:algorithm ;
    skos:topConceptOf xeos:algorithm ;
    skos:notation "label_propagation" ;
    skos:prefLabel "Label propagation"@en ;
    skos:definition "Community detection by iterated neighbour-majority labelling (Raghavan et al., 2007)"@en .

xeos:algorithm-node_similarity a skos:Concept ;
    skos:inScheme xeos:algorithm ;
    skos:topConceptOf xeos:algorithm ;
    skos:notation "node_similarity" ;
    skos:prefLabel "Node similarity"@en ;
    skos:definition "Pairwise similarity from shared neighbours (Jaccard or overlap)"@en .

xeos:algorithm-fastrp a skos:Concept ;
    skos:inScheme xeos:algorithm ;
    skos:topConceptOf xeos:algorithm ;
    skos:notation "fastrp" ;
    skos:prefLabel "FastRP"@en ;
    skos:definition "Node embeddings by fast random projection of the adjacency structure (Chen et al., 2019)"@en .

xeos:algorithm-knn a skos:Concept ;
    skos:inScheme xeos:algorithm ;
    skos:topConceptOf xeos:algorithm ;
    skos:notation "knn" ;
    skos:prefLabel "k-nearest neighbours"@en ;
    skos:definition "For each node, the k most similar nodes on a stated property or embedding"@en .

xeos:algorithm-cosine a skos:Concept ;
    skos:inScheme xeos:algorithm ;
    skos:topConceptOf xeos:algorithm ;
    skos:notation "cosine" ;
    skos:prefLabel "Cosine similarity"@en ;
    skos:definition "Cosine of the angle between two vectors"@en .

xeos:algorithm-shortest_path a skos:Concept ;
    skos:inScheme xeos:algorithm ;
    skos:topConceptOf xeos:algorithm ;
    skos:notation "shortest_path" ;
    skos:prefLabel "Shortest path"@en ;
    skos:definition "Fewest-hop or least-weight path between two nodes (Dijkstra, 1959)"@en .

# --- Framework kinds -----------------------------------------------------------

xeos:frameworkKind a skos:ConceptScheme ;
    skos:prefLabel "Framework kinds"@en ;
    xeo:fillsSlot xeo:frameworkKind ;
    dct:source "xeo-graph-kit docs/learn/GRAPH-MODEL.md §6" ;
    dct:description "What shape of method a Framework is, which decides how its Stages are read." .

xeos:frameworkKind-diagnostic a skos:Concept ;
    skos:inScheme xeos:frameworkKind ;
    skos:topConceptOf xeos:frameworkKind ;
    skos:notation "diagnostic" ;
    skos:prefLabel "Diagnostic"@en ;
    skos:definition "Ordered stages, each with a test; a subject is placed at the first stage it fails"@en .

xeos:frameworkKind-tactic_matrix a skos:Concept ;
    skos:inScheme xeos:frameworkKind ;
    skos:topConceptOf xeos:frameworkKind ;
    skos:notation "tactic_matrix" ;
    skos:prefLabel "Tactic matrix"@en ;
    skos:definition "Stages are the cells of a grid that tactics are sorted into"@en .

xeos:frameworkKind-checklist a skos:Concept ;
    skos:inScheme xeos:frameworkKind ;
    skos:topConceptOf xeos:frameworkKind ;
    skos:notation "checklist" ;
    skos:prefLabel "Checklist"@en ;
    skos:definition "Stages are items to complete; order is a convenience, not a dependency"@en .

xeos:frameworkKind-playbook a skos:Concept ;
    skos:inScheme xeos:frameworkKind ;
    skos:topConceptOf xeos:frameworkKind ;
    skos:notation "playbook" ;
    skos:prefLabel "Playbook"@en ;
    skos:definition "Stages group the diagnostics, tactics and practices of one discipline"@en .

# --- Organization kinds --------------------------------------------------------

xeos:organizationKind a skos:ConceptScheme ;
    skos:prefLabel "Organization kinds"@en ;
    xeo:fillsSlot xeo:organizationKind ;
    dct:source "xeo-graph-kit docs/learn/GRAPH-MODEL.md §6" ;
    dct:description "What kind of party an Organization is." .

xeos:organizationKind-agency a skos:Concept ;
    skos:inScheme xeos:organizationKind ;
    skos:topConceptOf xeos:organizationKind ;
    skos:notation "agency" ;
    skos:prefLabel "Agency"@en ;
    skos:definition "Does the work for clients"@en .

xeos:organizationKind-brand a skos:Concept ;
    skos:inScheme xeos:organizationKind ;
    skos:topConceptOf xeos:organizationKind ;
    skos:notation "brand" ;
    skos:prefLabel "Brand"@en ;
    skos:definition "A company whose sites and brands are worked on, by an agency or by itself"@en .

xeos:organizationKind-in_house a skos:Concept ;
    skos:inScheme xeos:organizationKind ;
    skos:topConceptOf xeos:organizationKind ;
    skos:notation "in_house" ;
    skos:prefLabel "In-house team"@en ;
    skos:definition "A team inside a company, working on that company's own sites"@en .

# --- Mention sentiment ---------------------------------------------------------

xeos:sentiment a skos:ConceptScheme ;
    skos:prefLabel "Mention sentiment"@en ;
    xeo:fillsSlot xeo:sentiment ;
    dct:source "xeo-graph-kit docs/learn/GRAPH-MODEL.md §3 · the four-way polarity common to sentiment classifiers" ;
    dct:description "The polarity with which a response speaks of a brand. A small reference set, deliberately coarse: a finer scale or a numeric score is a different derivation with its own method. mixed is not the midpoint of the scale; it says the response is both for and against." .

xeos:sentiment-positive a skos:Concept ;
    skos:inScheme xeos:sentiment ;
    skos:topConceptOf xeos:sentiment ;
    skos:notation "positive" ;
    skos:prefLabel "Positive"@en ;
    skos:definition "The response speaks well of the brand"@en .

xeos:sentiment-neutral a skos:Concept ;
    skos:inScheme xeos:sentiment ;
    skos:topConceptOf xeos:sentiment ;
    skos:notation "neutral" ;
    skos:prefLabel "Neutral"@en ;
    skos:definition "The response names the brand without judging it"@en .

xeos:sentiment-negative a skos:Concept ;
    skos:inScheme xeos:sentiment ;
    skos:topConceptOf xeos:sentiment ;
    skos:notation "negative" ;
    skos:prefLabel "Negative"@en ;
    skos:definition "The response speaks badly of the brand"@en .

xeos:sentiment-mixed a skos:Concept ;
    skos:inScheme xeos:sentiment ;
    skos:topConceptOf xeos:sentiment ;
    skos:notation "mixed" ;
    skos:prefLabel "Mixed"@en ;
    skos:definition "The response is both favourable and unfavourable"@en .

# --- Devices -------------------------------------------------------------------

xeos:device a skos:ConceptScheme ;
    skos:prefLabel "Devices"@en ;
    xeo:fillsSlot xeo:device ;
    dct:source "GSC Search Analytics API (device dimension: DESKTOP, MOBILE, TABLET), lower-cased · xeo-graph-kit docs/learn/GRAPH-MODEL.md §2" ;
    dct:description "The device class a results page was captured for. The same three classes search performance data is segmented by, so a snapshot and a rollup can be compared on like terms." .

xeos:device-desktop a skos:Concept ;
    skos:inScheme xeos:device ;
    skos:topConceptOf xeos:device ;
    skos:notation "desktop" ;
    skos:prefLabel "Desktop"@en ;
    skos:definition "A desktop or laptop browser"@en .

xeos:device-mobile a skos:Concept ;
    skos:inScheme xeos:device ;
    skos:topConceptOf xeos:device ;
    skos:notation "mobile" ;
    skos:prefLabel "Mobile"@en ;
    skos:definition "A phone"@en .

xeos:device-tablet a skos:Concept ;
    skos:inScheme xeos:device ;
    skos:topConceptOf xeos:device ;
    skos:notation "tablet" ;
    skos:prefLabel "Tablet"@en ;
    skos:definition "A tablet"@en .

# --- Feedback verdicts ---------------------------------------------------------

xeos:feedbackVerdict a skos:ConceptScheme ;
    skos:prefLabel "Feedback verdicts"@en ;
    xeo:fillsSlot xeo:verdict ;
    dct:source "if-control-center packages/contracts/src/gap.ts (FEEDBACK_VERDICTS, FEEDBACK_VERDICT_LABELS, FEEDBACK_VERDICT_HINTS)" ;
    dct:description "An operator's judgment of one machine claim, carried on a Feedback. Fills the same slot as gapVerdict for a different subject: on a Gap the verdict says what to do about the deficit, on a Feedback it says whether the claim was right." .

xeos:feedbackVerdict-accepted a skos:Concept ;
    skos:inScheme xeos:feedbackVerdict ;
    skos:topConceptOf xeos:feedbackVerdict ;
    skos:notation "accepted" ;
    skos:prefLabel "Agree"@en ;
    skos:definition "The finding is right as stated"@en .

xeos:feedbackVerdict-rejected a skos:Concept ;
    skos:inScheme xeos:feedbackVerdict ;
    skos:topConceptOf xeos:feedbackVerdict ;
    skos:notation "rejected" ;
    skos:prefLabel "Wrong"@en ;
    skos:definition "The finding is wrong for this client"@en .

xeos:feedbackVerdict-needs_work a skos:Concept ;
    skos:inScheme xeos:feedbackVerdict ;
    skos:topConceptOf xeos:feedbackVerdict ;
    skos:notation "needs_work" ;
    skos:prefLabel "Needs work"@en ;
    skos:definition "Partly right — the detail is off"@en .

# --- Objective metrics: AI visibility ------------------------------------------
# Two more concepts in xeos:objectiveMetric (declared above), so a campaign can
# target AI visibility. Both are the rollup values carried on visibilityFor.
# Every AI visibility code carries the ai_ prefix (B4, decided 2026-11-12).

xeos:objectiveMetric-ai_mention_rate a skos:Concept ;
    skos:inScheme xeos:objectiveMetric ;
    skos:topConceptOf xeos:objectiveMetric ;
    skos:notation "ai_mention_rate" ;
    skos:prefLabel "AI mention rate"@en ;
    skos:definition "Share of captured responses in the window that mention the brand"@en ;
    skos:note "direction up · unit ratio · source visibilityFor rollup (xeo:mentionRate)"@en .

xeos:objectiveMetric-ai_citation_rate a skos:Concept ;
    skos:inScheme xeos:objectiveMetric ;
    skos:topConceptOf xeos:objectiveMetric ;
    skos:notation "ai_citation_rate" ;
    skos:prefLabel "AI citation rate"@en ;
    skos:definition "Share of captured responses in the window that cite the brand's owned URLs"@en ;
    skos:note "direction up · unit ratio · source visibilityFor rollup (xeo:citationRate)"@en .

# --- v0.6.0 (metrics and CRM pipeline, 2026-11-10) --------------------------------
# Appended at the foot. The reference fillings for the slots the two research
# reports add: what kind of thing a metric is, the Metrics themselves, and the
# few closed lists the CRM pipeline slots need. Vendor field names are not here:
# they are in mappings/ (one file per tool), each mapped to one of these.
#
# Unlike the schemes lifted from production above, these come from the reports,
# and each dct:source says so. Where a value set or a default is XEO's own
# inference and not something a vendor documents, the scheme or the concept
# says that too. Same standing as every other scheme: adopt, extend, or replace.
#
# TIGHTENED (in place, above). The descriptions of xeos:objectiveMetric and
# xeos:targetKind, and the definition of outcomeResultReason-below_volume_floor,
# one line each.

# --- Metric types -----------------------------------------------------------

xeos:metricType a skos:ConceptScheme ;
    skos:prefLabel "Metric types"@en ;
    xeo:fillsSlot xeo:metricType ;
    dct:source "XEO metrics and KPIs research report, 2026-11-10 · the five metric types of dbt MetricFlow, which Cube and LookML express through measure types" ;
    dct:description "How a Metric is computed. The type decides what else the definition must carry: a simple metric names one slot and how to aggregate it; a ratio names a numerator and a denominator; a derived metric names its inputs and the arithmetic over them. cumulative and conversion are here so the typing is complete; the properties they need are in the extension set." .

xeos:metricType-simple a skos:Concept ;
    skos:inScheme xeos:metricType ;
    skos:topConceptOf xeos:metricType ;
    skos:notation "simple" ;
    skos:prefLabel "Simple"@en ;
    skos:definition "One slot, aggregated over the window: a sum, a count, a mean"@en .

xeos:metricType-ratio a skos:Concept ;
    skos:inScheme xeos:metricType ;
    skos:topConceptOf xeos:metricType ;
    skos:notation "ratio" ;
    skos:prefLabel "Ratio"@en ;
    skos:definition "One metric divided by another. Rolled up as the sum of numerators over the sum of denominators, never as a mean of ratios"@en .

xeos:metricType-derived a skos:Concept ;
    skos:inScheme xeos:metricType ;
    skos:topConceptOf xeos:metricType ;
    skos:notation "derived" ;
    skos:prefLabel "Derived"@en ;
    skos:definition "Arithmetic over one or more other metrics, stated in expression"@en .

xeos:metricType-cumulative a skos:Concept ;
    skos:inScheme xeos:metricType ;
    skos:topConceptOf xeos:metricType ;
    skos:notation "cumulative" ;
    skos:prefLabel "Cumulative"@en ;
    skos:definition "A metric accumulated over a trailing window, or from the start of a grain to date"@en .

xeos:metricType-conversion a skos:Concept ;
    skos:inScheme xeos:metricType ;
    skos:topConceptOf xeos:metricType ;
    skos:notation "conversion" ;
    skos:prefLabel "Conversion"@en ;
    skos:definition "The share of an entity's base events that were followed by a conversion event within a window"@en .

# --- Aggregations -----------------------------------------------------------

xeos:aggregation a skos:ConceptScheme ;
    skos:prefLabel "Aggregations"@en ;
    xeo:fillsSlot xeo:aggregation ;
    dct:source "XEO metrics and KPIs research report, 2026-11-10 · the aggregation types common to dbt (agg), Cube and LookML (type) and Malloy" ;
    dct:description "How a simple Metric reduces the values of the slot it reads to one number over a window. Named for the operation, never for a library's function." .

xeos:aggregation-sum a skos:Concept ;
    skos:inScheme xeos:aggregation ;
    skos:topConceptOf xeos:aggregation ;
    skos:notation "sum" ;
    skos:prefLabel "Sum"@en ;
    skos:definition "The values added together"@en .

xeos:aggregation-count a skos:Concept ;
    skos:inScheme xeos:aggregation ;
    skos:topConceptOf xeos:aggregation ;
    skos:notation "count" ;
    skos:prefLabel "Count"@en ;
    skos:definition "The number of records"@en .

xeos:aggregation-count_distinct a skos:Concept ;
    skos:inScheme xeos:aggregation ;
    skos:topConceptOf xeos:aggregation ;
    skos:notation "count_distinct" ;
    skos:prefLabel "Distinct count"@en ;
    skos:definition "The number of different values. Not additive across windows: a visitor seen on two days is one visitor"@en .

xeos:aggregation-mean a skos:Concept ;
    skos:inScheme xeos:aggregation ;
    skos:topConceptOf xeos:aggregation ;
    skos:notation "mean" ;
    skos:prefLabel "Mean"@en ;
    skos:definition "The arithmetic mean of the values"@en .

xeos:aggregation-weighted_mean a skos:Concept ;
    skos:inScheme xeos:aggregation ;
    skos:topConceptOf xeos:aggregation ;
    skos:notation "weighted_mean" ;
    skos:prefLabel "Weighted mean"@en ;
    skos:definition "The mean of the values, each weighted by a stated quantity (an average position weighted by impressions)"@en .

xeos:aggregation-min a skos:Concept ;
    skos:inScheme xeos:aggregation ;
    skos:topConceptOf xeos:aggregation ;
    skos:notation "min" ;
    skos:prefLabel "Minimum"@en ;
    skos:definition "The smallest value"@en .

xeos:aggregation-max a skos:Concept ;
    skos:inScheme xeos:aggregation ;
    skos:topConceptOf xeos:aggregation ;
    skos:notation "max" ;
    skos:prefLabel "Maximum"@en ;
    skos:definition "The largest value"@en .

xeos:aggregation-median a skos:Concept ;
    skos:inScheme xeos:aggregation ;
    skos:topConceptOf xeos:aggregation ;
    skos:notation "median" ;
    skos:prefLabel "Median"@en ;
    skos:definition "The middle value"@en .

xeos:aggregation-percentile a skos:Concept ;
    skos:inScheme xeos:aggregation ;
    skos:topConceptOf xeos:aggregation ;
    skos:notation "percentile" ;
    skos:prefLabel "Percentile"@en ;
    skos:definition "The value below which a stated share of the values fall; the share is percentileValue"@en .

xeos:aggregation-last a skos:Concept ;
    skos:inScheme xeos:aggregation ;
    skos:topConceptOf xeos:aggregation ;
    skos:notation "last" ;
    skos:prefLabel "Last"@en ;
    skos:definition "The most recent value in the window, as for a rank read from the latest snapshot"@en .

# --- Metric units -----------------------------------------------------------

xeos:metricUnit a skos:ConceptScheme ;
    skos:prefLabel "Metric units"@en ;
    xeo:fillsSlot xeo:unit ;
    dct:source "XEO metrics and KPIs research report, 2026-11-10 · the value types of the GA4 Data API (MetricType) and Matomo (metricTypes) · 'days' from the CRM pipeline research report" ;
    dct:description "What a reading of a Metric is a number of. Deliberately few. A rate is a ratio and is stored as a 0 to 1 quotient: every source read returns rates that way, and a percentage is a display format. Distinct from xeos:magnitudeUnit, which names the unit of a Gap's size and includes things that are metrics rather than units." .

xeos:metricUnit-count a skos:Concept ;
    skos:inScheme xeos:metricUnit ;
    skos:topConceptOf xeos:metricUnit ;
    skos:notation "count" ;
    skos:prefLabel "Count"@en ;
    skos:definition "A whole number of things: clicks, sessions, deals"@en .

xeos:metricUnit-ratio a skos:Concept ;
    skos:inScheme xeos:metricUnit ;
    skos:topConceptOf xeos:metricUnit ;
    skos:notation "ratio" ;
    skos:prefLabel "Ratio"@en ;
    skos:definition "A quotient from 0 to 1. Never a percentage: 0.05, not 5"@en .

xeos:metricUnit-rank a skos:Concept ;
    skos:inScheme xeos:metricUnit ;
    skos:topConceptOf xeos:metricUnit ;
    skos:notation "rank" ;
    skos:prefLabel "Rank"@en ;
    skos:definition "A 1-based position, 1 best. An average of ranks is still a rank and may be fractional"@en .

xeos:metricUnit-currency a skos:Concept ;
    skos:inScheme xeos:metricUnit ;
    skos:topConceptOf xeos:metricUnit ;
    skos:notation "currency" ;
    skos:prefLabel "Currency"@en ;
    skos:definition "An amount of money. The reading or target states which, as an ISO 4217 code"@en .

xeos:metricUnit-seconds a skos:Concept ;
    skos:inScheme xeos:metricUnit ;
    skos:topConceptOf xeos:metricUnit ;
    skos:notation "seconds" ;
    skos:prefLabel "Seconds"@en ;
    skos:definition "A duration in seconds"@en .

xeos:metricUnit-days a skos:Concept ;
    skos:inScheme xeos:metricUnit ;
    skos:topConceptOf xeos:metricUnit ;
    skos:notation "days" ;
    skos:prefLabel "Days"@en ;
    skos:definition "A duration in days, as for the length of a sales cycle"@en .

xeos:metricUnit-score_0_100 a skos:Concept ;
    skos:inScheme xeos:metricUnit ;
    skos:topConceptOf xeos:metricUnit ;
    skos:notation "score_0_100" ;
    skos:prefLabel "Score, 0 to 100"@en ;
    skos:definition "A model's score on a 0 to 100 scale. Always a derivation, with the model as its method"@en .

# --- Better directions ------------------------------------------------------

xeos:betterDirection a skos:ConceptScheme ;
    skos:prefLabel "Better directions"@en ;
    xeo:fillsSlot xeo:betterDirection ;
    dct:source "XEO metrics and KPIs research report, 2026-11-10 · if-control-center packages/contracts/src/objective-metric.ts (METRIC_DIRECTIONS), which this generalises" ;
    dct:description "Which way a change in a Metric counts as improvement. Stated once, on the Metric. 'up' and 'down' are the two values xeo:direction took on a target; 'none' is new, for a quantity that is neither good nor bad to have more of." .

xeos:betterDirection-up a skos:Concept ;
    skos:inScheme xeos:betterDirection ;
    skos:topConceptOf xeos:betterDirection ;
    skos:notation "up" ;
    skos:prefLabel "Higher is better"@en ;
    skos:definition "An increase is an improvement"@en .

xeos:betterDirection-down a skos:Concept ;
    skos:inScheme xeos:betterDirection ;
    skos:topConceptOf xeos:betterDirection ;
    skos:notation "down" ;
    skos:prefLabel "Lower is better"@en ;
    skos:definition "A decrease is an improvement, as for a position or a rank, where 1 is best"@en .

xeos:betterDirection-none a skos:Concept ;
    skos:inScheme xeos:betterDirection ;
    skos:topConceptOf xeos:betterDirection ;
    skos:notation "none" ;
    skos:prefLabel "Neither"@en ;
    skos:definition "More is not better or worse: a sample size, a count of answers collected"@en .

# --- Additivity -------------------------------------------------------------

xeos:additivity a skos:ConceptScheme ;
    skos:prefLabel "Additivity"@en ;
    xeo:fillsSlot xeo:additivity ;
    dct:source "XEO metrics and KPIs research report, 2026-11-10 · dbt (non_additive_dimension), Cube (count_distinct_approx), LookML (sum_distinct), Matomo (sum_daily_nb_uniq_visitors), GSC (aggregationType)" ;
    dct:description "Whether readings of a Metric may be added together across windows, pages or terms. The rule that keeps an Objective from being read as the sum of its Outcomes." .

xeos:additivity-additive a skos:Concept ;
    skos:inScheme xeos:additivity ;
    skos:topConceptOf xeos:additivity ;
    skos:notation "additive" ;
    skos:prefLabel "Additive"@en ;
    skos:definition "Readings may be summed across any dimension, provided they share an aggregationBasis"@en .

xeos:additivity-semi_additive a skos:Concept ;
    skos:inScheme xeos:additivity ;
    skos:topConceptOf xeos:additivity ;
    skos:notation "semi_additive" ;
    skos:prefLabel "Semi-additive"@en ;
    skos:definition "Readings may be summed across some dimensions and not others; typically not across time"@en .

xeos:additivity-non_additive a skos:Concept ;
    skos:inScheme xeos:additivity ;
    skos:topConceptOf xeos:additivity ;
    skos:notation "non_additive" ;
    skos:prefLabel "Non-additive"@en ;
    skos:definition "Readings are never summed. A ratio, an average, a rank or a distinct count over a union is recomputed from its parts"@en .

# --- Time grains (extension) ------------------------------------------------

xeos:timeGrain a skos:ConceptScheme ;
    skos:prefLabel "Time grains"@en ;
    xeo:fillsSlot xeo:grainToDate ;
    xeo:termStatus "extension" ;
    dct:source "XEO metrics and KPIs research report, 2026-11-10 · dbt (grain_to_date, time_granularity), Cube (granularity)" ;
    dct:description "The calendar grains a cumulative Metric can reset at." .

xeos:timeGrain-day a skos:Concept ;
    skos:inScheme xeos:timeGrain ;
    skos:topConceptOf xeos:timeGrain ;
    skos:notation "day" ;
    skos:prefLabel "Day"@en ;
    skos:definition "Resets each day"@en .

xeos:timeGrain-week a skos:Concept ;
    skos:inScheme xeos:timeGrain ;
    skos:topConceptOf xeos:timeGrain ;
    skos:notation "week" ;
    skos:prefLabel "Week"@en ;
    skos:definition "Resets each week"@en .

xeos:timeGrain-month a skos:Concept ;
    skos:inScheme xeos:timeGrain ;
    skos:topConceptOf xeos:timeGrain ;
    skos:notation "month" ;
    skos:prefLabel "Month"@en ;
    skos:definition "Resets each month: a month-to-date total"@en .

xeos:timeGrain-quarter a skos:Concept ;
    skos:inScheme xeos:timeGrain ;
    skos:topConceptOf xeos:timeGrain ;
    skos:notation "quarter" ;
    skos:prefLabel "Quarter"@en ;
    skos:definition "Resets each quarter"@en .

xeos:timeGrain-year a skos:Concept ;
    skos:inScheme xeos:timeGrain ;
    skos:topConceptOf xeos:timeGrain ;
    skos:notation "year" ;
    skos:prefLabel "Year"@en ;
    skos:definition "Resets each year"@en .

# --- Aggregation bases (extension) ------------------------------------------

xeos:aggregationBasis a skos:ConceptScheme ;
    skos:prefLabel "Aggregation bases"@en ;
    xeo:fillsSlot xeo:aggregationBasis ;
    xeo:termStatus "extension" ;
    dct:source "XEO metrics and KPIs research report, 2026-11-10 · Google Search Console Search Analytics API (aggregationType: auto, byPage, byProperty), neutral spelling" ;
    dct:description "How a source deduplicated before it returned a value. One source documents the choice, and there the same field gives two different counts under the two bases." .

xeos:aggregationBasis-by_property a skos:Concept ;
    skos:inScheme xeos:aggregationBasis ;
    skos:topConceptOf xeos:aggregationBasis ;
    skos:notation "by_property" ;
    skos:prefLabel "By property"@en ;
    skos:definition "Counted once per site: several of the site's pages in one result count as one impression"@en .

xeos:aggregationBasis-by_page a skos:Concept ;
    skos:inScheme xeos:aggregationBasis ;
    skos:topConceptOf xeos:aggregationBasis ;
    skos:notation "by_page" ;
    skos:prefLabel "By page"@en ;
    skos:definition "Counted once per page: each of the site's pages in a result counts"@en .

xeos:aggregationBasis-auto a skos:Concept ;
    skos:inScheme xeos:aggregationBasis ;
    skos:topConceptOf xeos:aggregationBasis ;
    skos:notation "auto" ;
    skos:prefLabel "Source's choice"@en ;
    skos:definition "The source chose the basis from the request. Record which it chose where it says"@en .

# --- Data states (extension) ------------------------------------------------

xeos:dataState a skos:ConceptScheme ;
    skos:prefLabel "Data states"@en ;
    xeo:fillsSlot xeo:dataState ;
    xeo:termStatus "extension" ;
    dct:source "XEO metrics and KPIs research report, 2026-11-10 · Google Search Console Search Analytics API (dataState), reported by a secondary source and not read in the vendor's own documentation" ;
    dct:description "Whether the source considered a reading's window complete when it answered." .

xeos:dataState-final a skos:Concept ;
    skos:inScheme xeos:dataState ;
    skos:topConceptOf xeos:dataState ;
    skos:notation "final" ;
    skos:prefLabel "Final"@en ;
    skos:definition "The source considers the window complete; the value is not expected to change"@en .

xeos:dataState-partial a skos:Concept ;
    skos:inScheme xeos:dataState ;
    skos:topConceptOf xeos:dataState ;
    skos:notation "partial" ;
    skos:prefLabel "Partial"@en ;
    skos:definition "The window includes data the source is still processing; the value is expected to change"@en .

# --- Target kinds: two more -------------------------------------------------
# Two more concepts in xeos:targetKind (declared above). The report asks for
# 'percent' to be renamed 'relative'. A stored code is not renamed in place, so
# 'relative' is added beside it, and 'percent' stays valid.

xeos:targetKind-relative a skos:Concept ;
    skos:inScheme xeos:targetKind ;
    skos:topConceptOf xeos:targetKind ;
    skos:notation "relative" ;
    skos:prefLabel "Relative change"@en ;
    skos:definition "targetValue is a relative change from baseline in the metric's better direction, written as a quotient: 0.2 is a fifth more than baseline"@en ;
    skos:closeMatch xeos:targetKind-percent ;
    skos:editorialNote "closeMatch, not exactMatch, to percent: whether a stored percent target holds 20 or 0.2 for a fifth is each consumer's convention, and the ontology never said."@en .

xeos:targetKind-absolute_change a skos:Concept ;
    skos:inScheme xeos:targetKind ;
    skos:topConceptOf xeos:targetKind ;
    skos:notation "absolute_change" ;
    skos:prefLabel "Absolute change"@en ;
    skos:definition "targetValue is a change from baseline in the metric's own unit, in its better direction. For a ratio this is points: 0.02 on a clickthrough rate is two points"@en .

# --- Metrics ----------------------------------------------------------------
# Every concept here is also an xeo:Metric. The two research reports each
# published a metric table; this is the two reconciled into one list. Where
# they disagreed, the editorialNote on the concept says how it was settled.
# Eight component metrics (the numerators and denominators the ratios need)
# are in neither table and are marked as added.

xeos:metric a skos:ConceptScheme ;
    skos:prefLabel "Metrics"@en ;
    xeo:fillsSlot xeo:metric ;
    dct:source "XEO metrics and KPIs research report, 2026-11-10 (starter reference scheme) · XEO CRM pipeline research report, 2026-11-10 (pipeline metrics) · the codes of xeos:objectiveMetric, kept unchanged" ;
    dct:description "The reference scheme of XEO Metrics: each a definition with a type, a unit, a better direction and an additivity, and what it is computed from. Covers search, AI visibility, website analytics and CRM pipeline, so an Objective can target any of them and a reading means the same thing wherever it is computed. The code a MetricTarget stores in xeo:metric is the skos:notation of a concept here. The six codes published earlier in xeos:objectiveMetric are kept exactly, each with an exactMatch from its old concept, and the two AI rates added there in 0.6.0 match theirs the same way. Definitions are neutral: where vendors use one name for different ratios, the definition here states the denominator, and each vendor's field is mapped to it in mappings/. XEO ships no minDenominator values: it is a slot, and each implementation sets its own. A consumer adds its own Metrics as instances of xeo:Metric in a scheme of its own." .

# Search

xeos:metric-clicks a skos:Concept , xeo:Metric ;
    skos:inScheme xeos:metric ;
    skos:topConceptOf xeos:metric ;
    skos:notation "clicks" ;
    skos:prefLabel "Clicks"@en ;
    skos:definition "Search result clicks to the site over the window"@en ;
    xeo:metricType xeos:metricType-simple ;
    xeo:aggregation xeos:aggregation-sum ;
    xeo:readsSlot xeo:clicks ;
    xeo:unit xeos:metricUnit-count ;
    xeo:betterDirection xeos:betterDirection-up ;
    xeo:additivity xeos:additivity-additive ;
    skos:note "reading: an observation where Search Console returned it for exactly this window and scope; a derivation when rolled up or recomputed"@en ;
    skos:editorialNote "Additive only within one aggregationBasis: clicks counted by page and by property are different counts."@en .

xeos:metric-impressions a skos:Concept , xeo:Metric ;
    skos:inScheme xeos:metric ;
    skos:topConceptOf xeos:metric ;
    skos:notation "impressions" ;
    skos:prefLabel "Impressions"@en ;
    skos:definition "Times a result from the site was shown in search over the window"@en ;
    xeo:metricType xeos:metricType-simple ;
    xeo:aggregation xeos:aggregation-sum ;
    xeo:readsSlot xeo:impressions ;
    xeo:unit xeos:metricUnit-count ;
    xeo:betterDirection xeos:betterDirection-up ;
    xeo:additivity xeos:additivity-additive ;
    skos:note "reading: an observation where Search Console returned it for exactly this window and scope; a derivation when rolled up or recomputed"@en ;
    skos:editorialNote "Additive only within one aggregationBasis."@en .

xeos:metric-ctr a skos:Concept , xeo:Metric ;
    skos:inScheme xeos:metric ;
    skos:topConceptOf xeos:metric ;
    skos:notation "ctr" ;
    skos:prefLabel "Clickthrough rate"@en ;
    skos:definition "The share of impressions that were clicked: clicks divided by impressions, as a 0 to 1 quotient"@en ;
    xeo:metricType xeos:metricType-ratio ;
    xeo:numerator xeos:metric-clicks ;
    xeo:denominator xeos:metric-impressions ;
    xeo:unit xeos:metricUnit-ratio ;
    xeo:betterDirection xeos:betterDirection-up ;
    xeo:additivity xeos:additivity-non_additive ;
    skos:note "reading: an observation where Search Console returned it for exactly this window and scope; a derivation when rolled up or recomputed"@en ;
    skos:editorialNote "The unit is ratio. xeos:objectiveMetric-ctr, its earlier form, noted the unit as percent until 0.6.0 corrected it; Search Console returns a quotient (0.1078), and so does every other source read. The implementation sets its minDenominator; XEO ships no value."@en .

xeos:metric-position a skos:Concept , xeo:Metric ;
    skos:inScheme xeos:metric ;
    skos:topConceptOf xeos:metric ;
    skos:notation "position" ;
    skos:prefLabel "Average position"@en ;
    skos:definition "The average position of the site's results in search over the window, weighted by impressions. 1-based, 1 best"@en ;
    xeo:metricType xeos:metricType-simple ;
    xeo:aggregation xeos:aggregation-weighted_mean ;
    xeo:readsSlot xeo:avgPosition ;
    xeo:unit xeos:metricUnit-rank ;
    xeo:betterDirection xeos:betterDirection-down ;
    xeo:additivity xeos:additivity-non_additive ;
    skos:note "reading: an observation where Search Console returned it for exactly this window and scope; a derivation when rolled up or recomputed"@en ;
    skos:editorialNote "Depends on aggregationBasis: the source computes it differently by page and by property. The implementation sets its minDenominator; XEO ships no value."@en .

xeos:metric-rank_absolute a skos:Concept , xeo:Metric ;
    skos:inScheme xeos:metric ;
    skos:topConceptOf xeos:metric ;
    skos:notation "rank_absolute" ;
    skos:prefLabel "Rank"@en ;
    skos:definition "The rank of the site's result in a third-party results-page snapshot, read from the latest snapshot in the window. 1-based, 1 best"@en ;
    xeo:metricType xeos:metricType-simple ;
    xeo:aggregation xeos:aggregation-last ;
    xeo:readsSlot xeo:position ;
    xeo:unit xeos:metricUnit-rank ;
    xeo:betterDirection xeos:betterDirection-down ;
    xeo:additivity xeos:additivity-non_additive ;
    skos:note "reading: an observation, from a rank tracker's snapshot"@en .

xeos:metric-etv a skos:Concept , xeo:Metric ;
    skos:inScheme xeos:metric ;
    skos:topConceptOf xeos:metric ;
    skos:notation "etv" ;
    skos:prefLabel "Estimated traffic value"@en ;
    skos:definition "A vendor's modelled value of the site's search traffic over the window"@en ;
    xeo:metricType xeos:metricType-simple ;
    xeo:aggregation xeos:aggregation-sum ;
    xeo:readsSlot xeo:value ;
    xeo:unit xeos:metricUnit-currency ;
    xeo:betterDirection xeos:betterDirection-up ;
    xeo:additivity xeos:additivity-additive ;
    skos:note "reading: always a derivation, with the vendor's model as its method. It is a model's output, not a measurement"@en ;
    skos:editorialNote "Layer corrected in 0.6.0: the earlier concept gave it a source and no layer, and it read as a measurement. The currency is the vendor's; a target on it need not state targetCurrency."@en .

# AI visibility

xeos:metric-ai_answers_sampled a skos:Concept , xeo:Metric ;
    skos:inScheme xeos:metric ;
    skos:topConceptOf xeos:metric ;
    skos:notation "ai_answers_sampled" ;
    skos:prefLabel "AI answers sampled"@en ;
    skos:definition "The number of AI answers collected for the tracked prompts over the window. The denominator behind the AI visibility rates"@en ;
    xeo:metricType xeos:metricType-simple ;
    xeo:aggregation xeos:aggregation-sum ;
    xeo:readsSlot xeo:responses ;
    xeo:timeAnchor xeo:capturedAt ;
    xeo:unit xeos:metricUnit-count ;
    xeo:betterDirection xeos:betterDirection-none ;
    xeo:additivity xeos:additivity-additive ;
    skos:note "reading: an observation, from the tracker's own run log"@en .

xeos:metric-ai_answers_mentioning a skos:Concept , xeo:Metric ;
    skos:inScheme xeos:metric ;
    skos:topConceptOf xeos:metric ;
    skos:notation "ai_answers_mentioning" ;
    skos:prefLabel "AI answers mentioning the brand"@en ;
    skos:definition "The number of sampled answers that mention the brand at least once"@en ;
    xeo:metricType xeos:metricType-simple ;
    xeo:aggregation xeos:aggregation-count_distinct ;
    xeo:readsSlot xeo:mentions ;
    xeo:timeAnchor xeo:capturedAt ;
    xeo:unit xeos:metricUnit-count ;
    xeo:betterDirection xeos:betterDirection-up ;
    xeo:additivity xeos:additivity-additive ;
    skos:note "reading: a derivation. Whether an answer mentions or cites a brand is extracted from sampled answers, and the sample is a vendor's or a tracker's choice"@en ;
    skos:editorialNote "A component metric, in neither report's table: added so the ratio that divides by or into it can be computed and rolled up."@en .

xeos:metric-ai_mention_rate a skos:Concept , xeo:Metric ;
    skos:inScheme xeos:metric ;
    skos:topConceptOf xeos:metric ;
    skos:notation "ai_mention_rate" ;
    skos:prefLabel "AI mention rate"@en ;
    skos:definition "The share of sampled answers that mention the brand: answers mentioning the brand divided by all answers sampled. Every sampled answer is in the denominator, whether or not it names any brand"@en ;
    xeo:metricType xeos:metricType-ratio ;
    xeo:numerator xeos:metric-ai_answers_mentioning ;
    xeo:denominator xeos:metric-ai_answers_sampled ;
    xeo:unit xeos:metricUnit-ratio ;
    xeo:betterDirection xeos:betterDirection-up ;
    xeo:additivity xeos:additivity-non_additive ;
    skos:note "reading: a derivation. Whether an answer mentions or cites a brand is extracted from sampled answers, and the sample is a vendor's or a tracker's choice. The property that carries the rollup value is xeo:mentionRate"@en ;
    skos:editorialNote "The report's name, adopted in 0.6.0 (decided 2026-11-12) so every AI visibility code carries the ai_ prefix. What vendors call 'visibility' or 'visibility score' maps here, and not always exactly: see mappings/. The implementation sets its minDenominator; XEO ships no value."@en .

xeos:metric-ai_answers_citing_owned a skos:Concept , xeo:Metric ;
    skos:inScheme xeos:metric ;
    skos:topConceptOf xeos:metric ;
    skos:notation "ai_answers_citing_owned" ;
    skos:prefLabel "AI answers citing an owned URL"@en ;
    skos:definition "The number of sampled answers that cite at least one URL of a Website the brand owns"@en ;
    xeo:metricType xeos:metricType-simple ;
    xeo:aggregation xeos:aggregation-count_distinct ;
    xeo:readsSlot xeo:cites ;
    xeo:metricFilter "the cited URL is partOf a Website the brand hasWebsite" ;
    xeo:timeAnchor xeo:capturedAt ;
    xeo:unit xeos:metricUnit-count ;
    xeo:betterDirection xeos:betterDirection-up ;
    xeo:additivity xeos:additivity-additive ;
    skos:note "reading: a derivation. Whether an answer mentions or cites a brand is extracted from sampled answers, and the sample is a vendor's or a tracker's choice"@en ;
    skos:editorialNote "A component metric, in neither report's table: added so the ratio that divides by or into it can be computed and rolled up."@en .

xeos:metric-ai_citation_rate a skos:Concept , xeo:Metric ;
    skos:inScheme xeos:metric ;
    skos:topConceptOf xeos:metric ;
    skos:notation "ai_citation_rate" ;
    skos:prefLabel "AI citation rate"@en ;
    skos:definition "The share of sampled answers that cite at least one of the brand's owned URLs: answers citing an owned URL divided by all answers sampled"@en ;
    xeo:metricType xeos:metricType-ratio ;
    xeo:numerator xeos:metric-ai_answers_citing_owned ;
    xeo:denominator xeos:metric-ai_answers_sampled ;
    xeo:unit xeos:metricUnit-ratio ;
    xeo:betterDirection xeos:betterDirection-up ;
    xeo:additivity xeos:additivity-non_additive ;
    skos:altLabel "ai_owned_source_rate" ;
    skos:note "reading: a derivation. Whether an answer mentions or cites a brand is extracted from sampled answers, and the sample is a vendor's or a tracker's choice. The property that carries the rollup value is xeo:citationRate"@en ;
    skos:editorialNote "Adopted in 0.6.0 (decided 2026-11-12) so every AI visibility code carries the ai_ prefix. The report names this ai_owned_source_rate, kept as an altLabel. Not ai_citation_share, which divides by citations and not by answers. The implementation sets its minDenominator; XEO ships no value."@en .

xeos:metric-ai_brand_mentions a skos:Concept , xeo:Metric ;
    skos:inScheme xeos:metric ;
    skos:topConceptOf xeos:metric ;
    skos:notation "ai_brand_mentions" ;
    skos:prefLabel "Brand mentions in AI answers"@en ;
    skos:definition "The number of mentions of the brand across the sampled answers"@en ;
    xeo:metricType xeos:metricType-simple ;
    xeo:aggregation xeos:aggregation-count ;
    xeo:readsSlot xeo:mentions ;
    xeo:timeAnchor xeo:capturedAt ;
    xeo:unit xeos:metricUnit-count ;
    xeo:betterDirection xeos:betterDirection-up ;
    xeo:additivity xeos:additivity-additive ;
    skos:note "reading: a derivation. Whether an answer mentions or cites a brand is extracted from sampled answers, and the sample is a vendor's or a tracker's choice"@en ;
    skos:editorialNote "A component metric, in neither report's table: added so the ratio that divides by or into it can be computed and rolled up."@en .

xeos:metric-ai_tracked_brand_mentions a skos:Concept , xeo:Metric ;
    skos:inScheme xeos:metric ;
    skos:topConceptOf xeos:metric ;
    skos:notation "ai_tracked_brand_mentions" ;
    skos:prefLabel "Tracked-brand mentions in AI answers"@en ;
    skos:definition "The number of mentions of any tracked brand, the brand and its named competitors together, across the sampled answers"@en ;
    xeo:metricType xeos:metricType-simple ;
    xeo:aggregation xeos:aggregation-count ;
    xeo:readsSlot xeo:mentions ;
    xeo:metricFilter "the mentioned Brand is the brand or one it competesWith" ;
    xeo:timeAnchor xeo:capturedAt ;
    xeo:unit xeos:metricUnit-count ;
    xeo:betterDirection xeos:betterDirection-none ;
    xeo:additivity xeos:additivity-additive ;
    skos:note "reading: a derivation. Whether an answer mentions or cites a brand is extracted from sampled answers, and the sample is a vendor's or a tracker's choice"@en ;
    skos:editorialNote "A component metric, in neither report's table: added so the ratio that divides by or into it can be computed and rolled up. Depends on which brands are tracked: adding a competitor to the set lowers every share computed over it."@en .

xeos:metric-ai_share_of_voice a skos:Concept , xeo:Metric ;
    skos:inScheme xeos:metric ;
    skos:topConceptOf xeos:metric ;
    skos:notation "ai_share_of_voice" ;
    skos:prefLabel "AI share of voice"@en ;
    skos:definition "The brand's share of all tracked-brand mentions in the sampled answers: mentions of the brand divided by mentions of every tracked brand"@en ;
    xeo:metricType xeos:metricType-ratio ;
    xeo:numerator xeos:metric-ai_brand_mentions ;
    xeo:denominator xeos:metric-ai_tracked_brand_mentions ;
    xeo:unit xeos:metricUnit-ratio ;
    xeo:betterDirection xeos:betterDirection-up ;
    xeo:additivity xeos:additivity-non_additive ;
    skos:note "reading: a derivation. Whether an answer mentions or cites a brand is extracted from sampled answers, and the sample is a vendor's or a tracker's choice"@en ;
    skos:editorialNote "The implementation sets its minDenominator; XEO ships no value."@en .

xeos:metric-ai_owned_citations a skos:Concept , xeo:Metric ;
    skos:inScheme xeos:metric ;
    skos:topConceptOf xeos:metric ;
    skos:notation "ai_owned_citations" ;
    skos:prefLabel "Citations of owned domains"@en ;
    skos:definition "The number of citations in the sampled answers that point at the brand's owned domains"@en ;
    xeo:metricType xeos:metricType-simple ;
    xeo:aggregation xeos:aggregation-count ;
    xeo:readsSlot xeo:cites ;
    xeo:metricFilter "the cited URL is partOf a Website the brand hasWebsite" ;
    xeo:timeAnchor xeo:capturedAt ;
    xeo:unit xeos:metricUnit-count ;
    xeo:betterDirection xeos:betterDirection-up ;
    xeo:additivity xeos:additivity-additive ;
    skos:note "reading: a derivation. Whether an answer mentions or cites a brand is extracted from sampled answers, and the sample is a vendor's or a tracker's choice"@en ;
    skos:editorialNote "A component metric, in neither report's table: added so the ratio that divides by or into it can be computed and rolled up."@en .

xeos:metric-ai_citations a skos:Concept , xeo:Metric ;
    skos:inScheme xeos:metric ;
    skos:topConceptOf xeos:metric ;
    skos:notation "ai_citations" ;
    skos:prefLabel "Citations in AI answers"@en ;
    skos:definition "The number of citations of any URL across the sampled answers"@en ;
    xeo:metricType xeos:metricType-simple ;
    xeo:aggregation xeos:aggregation-count ;
    xeo:readsSlot xeo:cites ;
    xeo:timeAnchor xeo:capturedAt ;
    xeo:unit xeos:metricUnit-count ;
    xeo:betterDirection xeos:betterDirection-none ;
    xeo:additivity xeos:additivity-additive ;
    skos:note "reading: an observation where the engine annotates its own citations and the tracker counts them"@en ;
    skos:editorialNote "A component metric, in neither report's table: added so the ratio that divides by or into it can be computed and rolled up."@en .

xeos:metric-ai_citation_share a skos:Concept , xeo:Metric ;
    skos:inScheme xeos:metric ;
    skos:topConceptOf xeos:metric ;
    skos:notation "ai_citation_share" ;
    skos:prefLabel "AI citation share"@en ;
    skos:definition "The share of all citations in the sampled answers that point at the brand's owned domains: citations of owned domains divided by all citations"@en ;
    xeo:metricType xeos:metricType-ratio ;
    xeo:numerator xeos:metric-ai_owned_citations ;
    xeo:denominator xeos:metric-ai_citations ;
    xeo:unit xeos:metricUnit-ratio ;
    xeo:betterDirection xeos:betterDirection-up ;
    xeo:additivity xeos:additivity-non_additive ;
    skos:note "reading: a derivation. Whether an answer mentions or cites a brand is extracted from sampled answers, and the sample is a vendor's or a tracker's choice"@en ;
    skos:editorialNote "The implementation sets its minDenominator; XEO ships no value."@en .

xeos:metric-ai_average_position a skos:Concept , xeo:Metric ;
    skos:inScheme xeos:metric ;
    skos:topConceptOf xeos:metric ;
    skos:notation "ai_average_position" ;
    skos:prefLabel "AI average position"@en ;
    skos:definition "The average order in which the brand is first mentioned among the brands an answer names, over the answers that mention it. 1-based, 1 best"@en ;
    xeo:metricType xeos:metricType-simple ;
    xeo:aggregation xeos:aggregation-mean ;
    xeo:readsSlot xeo:mentionRank ;
    xeo:timeAnchor xeo:capturedAt ;
    xeo:unit xeos:metricUnit-rank ;
    xeo:betterDirection xeos:betterDirection-down ;
    xeo:additivity xeos:additivity-non_additive ;
    skos:note "reading: a derivation. Whether an answer mentions or cites a brand is extracted from sampled answers, and the sample is a vendor's or a tracker's choice"@en ;
    skos:editorialNote "Averaged only over answers that mention the brand, so it says nothing about how often that is. Not comparable with a search position, which averages over impressions. The implementation sets its minDenominator; XEO ships no value."@en .

xeos:metric-ai_sentiment a skos:Concept , xeo:Metric ;
    skos:inScheme xeos:metric ;
    skos:topConceptOf xeos:metric ;
    skos:notation "ai_sentiment" ;
    skos:prefLabel "AI sentiment score"@en ;
    skos:definition "A model's score of the tone in which the sampled answers speak of the brand, averaged over the answers that mention it, from 0 to 100"@en ;
    xeo:metricType xeos:metricType-simple ;
    xeo:aggregation xeos:aggregation-mean ;
    xeo:readsSlot xeo:value ;
    xeo:unit xeos:metricUnit-score_0_100 ;
    xeo:betterDirection xeos:betterDirection-up ;
    xeo:additivity xeos:additivity-non_additive ;
    xeo:termStatus "extension" ;
    skos:note "reading: always a derivation, with the scoring model as its method. Not xeo:sentiment, which is a four-way code on one mention"@en ;
    skos:editorialNote "The implementation sets its minDenominator; XEO ships no value."@en .

# Website analytics

xeos:metric-sessions a skos:Concept , xeo:Metric ;
    skos:inScheme xeos:metric ;
    skos:topConceptOf xeos:metric ;
    skos:notation "sessions" ;
    skos:prefLabel "Sessions"@en ;
    skos:definition "Visits to the site over the window, by the analytics tool's own session rule"@en ;
    xeo:metricType xeos:metricType-simple ;
    xeo:aggregation xeos:aggregation-sum ;
    xeo:readsSlot xeo:value ;
    xeo:unit xeos:metricUnit-count ;
    xeo:betterDirection xeos:betterDirection-up ;
    xeo:additivity xeos:additivity-additive ;
    skos:note "reading: an observation where the analytics tool returned it for exactly this window and scope; a derivation when rolled up, or when the tool's own channel rule had to be rebuilt"@en ;
    skos:editorialNote "Tools differ on what ends a session, so sessions from two tools are close and not equal."@en .

xeos:metric-engaged_sessions a skos:Concept , xeo:Metric ;
    skos:inScheme xeos:metric ;
    skos:topConceptOf xeos:metric ;
    skos:notation "engaged_sessions" ;
    skos:prefLabel "Engaged sessions"@en ;
    skos:definition "Sessions that met the analytics tool's engagement rule"@en ;
    xeo:metricType xeos:metricType-simple ;
    xeo:aggregation xeos:aggregation-sum ;
    xeo:readsSlot xeo:value ;
    xeo:metricFilter "the session meets the tool's engagement rule" ;
    xeo:unit xeos:metricUnit-count ;
    xeo:betterDirection xeos:betterDirection-up ;
    xeo:additivity xeos:additivity-additive ;
    skos:note "reading: an observation where the analytics tool returned it for exactly this window and scope; a derivation when rolled up, or when the tool's own channel rule had to be rebuilt"@en .

xeos:metric-engagement_rate a skos:Concept , xeo:Metric ;
    skos:inScheme xeos:metric ;
    skos:topConceptOf xeos:metric ;
    skos:notation "engagement_rate" ;
    skos:prefLabel "Engagement rate"@en ;
    skos:definition "The share of sessions that were engaged: engaged sessions divided by sessions"@en ;
    xeo:metricType xeos:metricType-ratio ;
    xeo:numerator xeos:metric-engaged_sessions ;
    xeo:denominator xeos:metric-sessions ;
    xeo:unit xeos:metricUnit-ratio ;
    xeo:betterDirection xeos:betterDirection-up ;
    xeo:additivity xeos:additivity-non_additive ;
    skos:note "reading: an observation where the analytics tool returned it for exactly this window and scope; a derivation when rolled up, or when the tool's own channel rule had to be rebuilt"@en ;
    skos:editorialNote "Not one minus a bounce rate: one tool's bounce is a single-pageview visit, another's is a session that was not engaged. The implementation sets its minDenominator; XEO ships no value."@en .

xeos:metric-ai_assistant_sessions a skos:Concept , xeo:Metric ;
    skos:inScheme xeos:metric ;
    skos:topConceptOf xeos:metric ;
    skos:notation "ai_assistant_sessions" ;
    skos:prefLabel "AI-assistant sessions"@en ;
    skos:definition "Sessions referred by AI assistants"@en ;
    xeo:metricType xeos:metricType-simple ;
    xeo:aggregation xeos:aggregation-sum ;
    xeo:readsSlot xeo:value ;
    xeo:metricFilter "channel = 'ai_assistant'" ;
    xeo:unit xeos:metricUnit-count ;
    xeo:betterDirection xeos:betterDirection-up ;
    xeo:additivity xeos:additivity-additive ;
    skos:note "reading: an observation where the tool classifies the channel natively; a derivation where a custom channel rule had to be built"@en .

xeos:metric-key_events a skos:Concept , xeo:Metric ;
    skos:inScheme xeos:metric ;
    skos:topConceptOf xeos:metric ;
    skos:notation "key_events" ;
    skos:prefLabel "Key events"@en ;
    skos:definition "Events the site has marked as conversions, counted over the window"@en ;
    xeo:metricType xeos:metricType-simple ;
    xeo:aggregation xeos:aggregation-sum ;
    xeo:readsSlot xeo:value ;
    xeo:unit xeos:metricUnit-count ;
    xeo:betterDirection xeos:betterDirection-up ;
    xeo:additivity xeos:additivity-additive ;
    skos:note "reading: an observation where the analytics tool returned it for exactly this window and scope; a derivation when rolled up, or when the tool's own channel rule had to be rebuilt"@en .

xeos:metric-converting_sessions a skos:Concept , xeo:Metric ;
    skos:inScheme xeos:metric ;
    skos:topConceptOf xeos:metric ;
    skos:notation "converting_sessions" ;
    skos:prefLabel "Converting sessions"@en ;
    skos:definition "Sessions in which at least one key event happened"@en ;
    xeo:metricType xeos:metricType-simple ;
    xeo:aggregation xeos:aggregation-sum ;
    xeo:readsSlot xeo:value ;
    xeo:metricFilter "the session has at least one key event" ;
    xeo:unit xeos:metricUnit-count ;
    xeo:betterDirection xeos:betterDirection-up ;
    xeo:additivity xeos:additivity-additive ;
    skos:note "reading: an observation where the analytics tool returned it for exactly this window and scope; a derivation when rolled up, or when the tool's own channel rule had to be rebuilt"@en ;
    skos:editorialNote "A component metric, in neither report's table: added so the ratio that divides by or into it can be computed and rolled up."@en .

xeos:metric-session_conversion_rate a skos:Concept , xeo:Metric ;
    skos:inScheme xeos:metric ;
    skos:topConceptOf xeos:metric ;
    skos:notation "session_conversion_rate" ;
    skos:prefLabel "Session conversion rate"@en ;
    skos:definition "The share of sessions in which at least one key event happened: converting sessions divided by sessions"@en ;
    xeo:metricType xeos:metricType-ratio ;
    xeo:numerator xeos:metric-converting_sessions ;
    xeo:denominator xeos:metric-sessions ;
    xeo:unit xeos:metricUnit-ratio ;
    xeo:betterDirection xeos:betterDirection-up ;
    xeo:additivity xeos:additivity-non_additive ;
    skos:note "reading: an observation where the analytics tool returned it for exactly this window and scope; a derivation when rolled up, or when the tool's own channel rule had to be rebuilt"@en ;
    skos:editorialNote "The implementation sets its minDenominator; XEO ships no value."@en .

# CRM pipeline

xeos:metric-leads_created a skos:Concept , xeo:Metric ;
    skos:inScheme xeos:metric ;
    skos:topConceptOf xeos:metric ;
    skos:notation "leads_created" ;
    skos:prefLabel "Leads created"@en ;
    skos:definition "Lead or person records the CRM recorded as created in the window"@en ;
    xeo:metricType xeos:metricType-simple ;
    xeo:aggregation xeos:aggregation-count ;
    xeo:readsSlot xeo:crmRecordRef ;
    xeo:metricFilter "crmObjectType in ('lead', 'person')" ;
    xeo:timeAnchor xeo:recordCreatedAt ;
    xeo:unit xeos:metricUnit-count ;
    xeo:betterDirection xeos:betterDirection-up ;
    xeo:additivity xeos:additivity-additive ;
    skos:note "reading: a derivation. The records are observed in the CRM; the windowed number is computed over them"@en ;
    skos:editorialNote "The metrics report gives the reading layer as observation; the CRM report says every pipeline number is a derivation over observed records. The second is followed: a count XEO computes over a window is a derivation."@en .

xeos:metric-ai_referred_leads a skos:Concept , xeo:Metric ;
    skos:inScheme xeos:metric ;
    skos:topConceptOf xeos:metric ;
    skos:notation "ai_referred_leads" ;
    skos:prefLabel "AI-referred leads"@en ;
    skos:definition "Leads created in the window whose first-touch channel is an AI assistant"@en ;
    xeo:metricType xeos:metricType-simple ;
    xeo:aggregation xeos:aggregation-count ;
    xeo:readsSlot xeo:crmRecordRef ;
    xeo:metricFilter "crmObjectType in ('lead', 'person') and firstTouchChannel = 'ai_assistant'" ;
    xeo:timeAnchor xeo:recordCreatedAt ;
    xeo:unit xeos:metricUnit-count ;
    xeo:betterDirection xeos:betterDirection-up ;
    xeo:additivity xeos:additivity-additive ;
    skos:note "reading: a derivation. The records are observed in the CRM; the windowed number is computed over them"@en ;
    skos:editorialNote "From the CRM report only."@en .

xeos:metric-deals_created a skos:Concept , xeo:Metric ;
    skos:inScheme xeos:metric ;
    skos:topConceptOf xeos:metric ;
    skos:notation "deals_created" ;
    skos:prefLabel "Deals created"@en ;
    skos:definition "Deals the CRM recorded as created in the window"@en ;
    xeo:metricType xeos:metricType-simple ;
    xeo:aggregation xeos:aggregation-count ;
    xeo:readsSlot xeo:crmRecordRef ;
    xeo:metricFilter "crmObjectType = 'deal'" ;
    xeo:timeAnchor xeo:recordCreatedAt ;
    xeo:unit xeos:metricUnit-count ;
    xeo:betterDirection xeos:betterDirection-up ;
    xeo:additivity xeos:additivity-additive ;
    skos:note "reading: a derivation. The records are observed in the CRM; the windowed number is computed over them"@en ;
    skos:editorialNote "From the CRM report only."@en .

xeos:metric-pipeline_created a skos:Concept , xeo:Metric ;
    skos:inScheme xeos:metric ;
    skos:topConceptOf xeos:metric ;
    skos:notation "pipeline_created" ;
    skos:prefLabel "Pipeline created"@en ;
    skos:definition "The summed amount of deals created in the window, in one stated currency"@en ;
    xeo:metricType xeos:metricType-simple ;
    xeo:aggregation xeos:aggregation-sum ;
    xeo:readsSlot xeo:dealAmount ;
    xeo:metricFilter "crmObjectType = 'deal'" ;
    xeo:timeAnchor xeo:recordCreatedAt ;
    xeo:unit xeos:metricUnit-currency ;
    xeo:betterDirection xeos:betterDirection-up ;
    xeo:additivity xeos:additivity-additive ;
    skos:note "reading: a derivation. The records are observed in the CRM; the windowed number is computed over them"@en ;
    skos:editorialNote "The metrics report gives the reading layer as observation; the CRM report says every pipeline number is a derivation over observed records. The second is followed: a count XEO computes over a window is a derivation. A target on it states targetCurrency."@en .

xeos:metric-deals_won a skos:Concept , xeo:Metric ;
    skos:inScheme xeos:metric ;
    skos:topConceptOf xeos:metric ;
    skos:notation "deals_won" ;
    skos:prefLabel "Deals won"@en ;
    skos:definition "Deals whose outcome is won and which closed in the window"@en ;
    xeo:metricType xeos:metricType-simple ;
    xeo:aggregation xeos:aggregation-count ;
    xeo:readsSlot xeo:crmRecordRef ;
    xeo:metricFilter "dealOutcome = 'won'" ;
    xeo:timeAnchor xeo:dealClosedAt ;
    xeo:unit xeos:metricUnit-count ;
    xeo:betterDirection xeos:betterDirection-up ;
    xeo:additivity xeos:additivity-additive ;
    skos:note "reading: a derivation. The records are observed in the CRM; the windowed number is computed over them"@en ;
    skos:editorialNote "The metrics report gives the reading layer as observation; the CRM report says every pipeline number is a derivation over observed records. The second is followed: a count XEO computes over a window is a derivation."@en .

xeos:metric-deals_closed a skos:Concept , xeo:Metric ;
    skos:inScheme xeos:metric ;
    skos:topConceptOf xeos:metric ;
    skos:notation "deals_closed" ;
    skos:prefLabel "Deals closed"@en ;
    skos:definition "Deals whose outcome is won or lost and which closed in the window"@en ;
    xeo:metricType xeos:metricType-simple ;
    xeo:aggregation xeos:aggregation-count ;
    xeo:readsSlot xeo:crmRecordRef ;
    xeo:metricFilter "dealOutcome in ('won', 'lost')" ;
    xeo:timeAnchor xeo:dealClosedAt ;
    xeo:unit xeos:metricUnit-count ;
    xeo:betterDirection xeos:betterDirection-none ;
    xeo:additivity xeos:additivity-additive ;
    skos:note "reading: a derivation. The records are observed in the CRM; the windowed number is computed over them"@en ;
    skos:editorialNote "A component metric, in neither report's table: added so the ratio that divides by or into it can be computed and rolled up."@en .

xeos:metric-revenue_won a skos:Concept , xeo:Metric ;
    skos:inScheme xeos:metric ;
    skos:topConceptOf xeos:metric ;
    skos:notation "revenue_won" ;
    skos:prefLabel "Revenue won"@en ;
    skos:definition "The summed amount of deals won that closed in the window, in one stated currency"@en ;
    xeo:metricType xeos:metricType-simple ;
    xeo:aggregation xeos:aggregation-sum ;
    xeo:readsSlot xeo:dealAmount ;
    xeo:metricFilter "dealOutcome = 'won'" ;
    xeo:timeAnchor xeo:dealClosedAt ;
    xeo:unit xeos:metricUnit-currency ;
    xeo:betterDirection xeos:betterDirection-up ;
    xeo:additivity xeos:additivity-additive ;
    skos:note "reading: a derivation. The records are observed in the CRM; the windowed number is computed over them"@en ;
    skos:editorialNote "The metrics report gives the reading layer as observation; the CRM report says every pipeline number is a derivation over observed records. The second is followed: a count XEO computes over a window is a derivation. A target on it states targetCurrency."@en .

xeos:metric-win_rate a skos:Concept , xeo:Metric ;
    skos:inScheme xeos:metric ;
    skos:topConceptOf xeos:metric ;
    skos:notation "win_rate" ;
    skos:prefLabel "Win rate"@en ;
    skos:definition "The share of deals closed in the window that were won: deals won divided by deals won or lost"@en ;
    xeo:metricType xeos:metricType-ratio ;
    xeo:numerator xeos:metric-deals_won ;
    xeo:denominator xeos:metric-deals_closed ;
    xeo:unit xeos:metricUnit-ratio ;
    xeo:betterDirection xeos:betterDirection-up ;
    xeo:additivity xeos:additivity-non_additive ;
    skos:note "reading: a derivation. The records are observed in the CRM; the windowed number is computed over them"@en ;
    skos:editorialNote "From the CRM report only, which gives its unit as percent. Stored as a 0 to 1 quotient like every other ratio. Neither report gives a minimum denominator, so none is stated."@en .

xeos:metric-sales_cycle_days a skos:Concept , xeo:Metric ;
    skos:inScheme xeos:metric ;
    skos:topConceptOf xeos:metric ;
    skos:notation "sales_cycle_days" ;
    skos:prefLabel "Sales cycle"@en ;
    skos:definition "The median number of days from a deal's creation to its close, over deals won that closed in the window"@en ;
    xeo:metricType xeos:metricType-simple ;
    xeo:aggregation xeos:aggregation-median ;
    xeo:readsSlot xeo:dealClosedAt ;
    xeo:metricFilter "dealOutcome = 'won'" ;
    xeo:expression "days from recordCreatedAt to dealClosedAt" ;
    xeo:timeAnchor xeo:dealClosedAt ;
    xeo:unit xeos:metricUnit-days ;
    xeo:betterDirection xeos:betterDirection-down ;
    xeo:additivity xeos:additivity-non_additive ;
    skos:note "reading: a derivation. The records are observed in the CRM; the windowed number is computed over them"@en ;
    skos:editorialNote "From the CRM report only."@en .

# The earlier objectiveMetric concepts, each tied to its Metric. Extra triples
# about concepts declared above; none is changed.

xeos:objectiveMetric-clicks skos:exactMatch xeos:metric-clicks .
xeos:objectiveMetric-impressions skos:exactMatch xeos:metric-impressions .
xeos:objectiveMetric-position skos:exactMatch xeos:metric-position .
xeos:objectiveMetric-rank_absolute skos:exactMatch xeos:metric-rank_absolute .
xeos:objectiveMetric-ai_mention_rate skos:exactMatch xeos:metric-ai_mention_rate .
xeos:objectiveMetric-ai_citation_rate skos:exactMatch xeos:metric-ai_citation_rate .
xeos:objectiveMetric-ctr skos:exactMatch xeos:metric-ctr ;
    skos:editorialNote "Until 0.6.0 the note above gave the unit as percent. The sources return a 0 to 1 quotient and xeos:metric-ctr states the unit as ratio, so the note was corrected. A consumer that built on the old note may hold 5 where this means 0.05: check stored ctr targets and baselines before reading them as ratios."@en .
xeos:objectiveMetric-etv skos:exactMatch xeos:metric-etv ;
    skos:editorialNote "A vendor's model output, so every reading of it is a derivation. xeos:metric-etv says so; this concept's note names only the source."@en .

# --- CRM systems ------------------------------------------------------------

xeos:crmSystem a skos:ConceptScheme ;
    skos:prefLabel "CRM systems"@en ;
    xeo:fillsSlot xeo:crmSystem ;
    dct:source "XEO CRM pipeline research report, 2026-11-10 (the seven CRMs read)" ;
    dct:description "Which CRM product holds a record: the first part of a crmRecordRef. The seven the report read. A code names the product, never a field of it. Another CRM is another code; three more (Freshsales, Copper, monday CRM) were named and not read." .

xeos:crmSystem-hubspot a skos:Concept ;
    skos:inScheme xeos:crmSystem ;
    skos:topConceptOf xeos:crmSystem ;
    skos:notation "hubspot" ;
    skos:prefLabel "HubSpot"@en ;
    skos:definition "HubSpot Smart CRM"@en .

xeos:crmSystem-salesforce a skos:Concept ;
    skos:inScheme xeos:crmSystem ;
    skos:topConceptOf xeos:crmSystem ;
    skos:notation "salesforce" ;
    skos:prefLabel "Salesforce"@en ;
    skos:definition "Salesforce Sales Cloud"@en .

xeos:crmSystem-pipedrive a skos:Concept ;
    skos:inScheme xeos:crmSystem ;
    skos:topConceptOf xeos:crmSystem ;
    skos:notation "pipedrive" ;
    skos:prefLabel "Pipedrive"@en ;
    skos:definition "Pipedrive"@en .

xeos:crmSystem-dynamics365 a skos:Concept ;
    skos:inScheme xeos:crmSystem ;
    skos:topConceptOf xeos:crmSystem ;
    skos:notation "dynamics365" ;
    skos:prefLabel "Dynamics 365"@en ;
    skos:definition "Microsoft Dynamics 365 Sales"@en .

xeos:crmSystem-zoho a skos:Concept ;
    skos:inScheme xeos:crmSystem ;
    skos:topConceptOf xeos:crmSystem ;
    skos:notation "zoho" ;
    skos:prefLabel "Zoho CRM"@en ;
    skos:definition "Zoho CRM"@en .

xeos:crmSystem-close a skos:Concept ;
    skos:inScheme xeos:crmSystem ;
    skos:topConceptOf xeos:crmSystem ;
    skos:notation "close" ;
    skos:prefLabel "Close"@en ;
    skos:definition "Close"@en .

xeos:crmSystem-attio a skos:Concept ;
    skos:inScheme xeos:crmSystem ;
    skos:topConceptOf xeos:crmSystem ;
    skos:notation "attio" ;
    skos:prefLabel "Attio"@en ;
    skos:definition "Attio"@en .

# --- CRM object types -------------------------------------------------------

xeos:crmObjectType a skos:ConceptScheme ;
    skos:prefLabel "CRM object types"@en ;
    xeo:fillsSlot xeo:crmObjectType ;
    dct:source "XEO CRM pipeline research report, 2026-11-10 (crosswalk: all seven CRMs expose a person, an organization and a deal; five a pre-qualification lead)" ;
    dct:description "The neutral kind of record a crmRecordRef points at. Assigned from the record's structure, not from the vendor's word for it: 'lead' is a prospect record in one CRM, a company in another and a deal stage in a third." .

xeos:crmObjectType-person a skos:Concept ;
    skos:inScheme xeos:crmObjectType ;
    skos:topConceptOf xeos:crmObjectType ;
    skos:notation "person" ;
    skos:prefLabel "Person"@en ;
    skos:definition "A record of one human: a contact"@en .

xeos:crmObjectType-organization a skos:Concept ;
    skos:inScheme xeos:crmObjectType ;
    skos:topConceptOf xeos:crmObjectType ;
    skos:notation "organization" ;
    skos:prefLabel "Organization"@en ;
    skos:definition "A record of a company or account"@en .

xeos:crmObjectType-lead a skos:Concept ;
    skos:inScheme xeos:crmObjectType ;
    skos:topConceptOf xeos:crmObjectType ;
    skos:notation "lead" ;
    skos:prefLabel "Lead"@en ;
    skos:definition "A record of an unqualified prospect, kept apart from persons and deals until it is converted or dropped"@en .

xeos:crmObjectType-deal a skos:Concept ;
    skos:inScheme xeos:crmObjectType ;
    skos:topConceptOf xeos:crmObjectType ;
    skos:notation "deal" ;
    skos:prefLabel "Deal"@en ;
    skos:definition "A record of one potential sale, with a stage and an amount: a deal or an opportunity"@en .

# --- Deal outcomes ----------------------------------------------------------

xeos:dealOutcome a skos:ConceptScheme ;
    skos:prefLabel "Deal outcomes"@en ;
    xeo:fillsSlot xeo:dealOutcome ;
    dct:source "XEO CRM pipeline research report, 2026-11-10 (five of seven CRMs state it as a field; in the other two it follows from the stage)" ;
    dct:description "Whether a deal is still in play, and if not, how it ended. Three values, and no fourth for deleted: a deleted deal has no outcome and is left out of every count." .

xeos:dealOutcome-open a skos:Concept ;
    skos:inScheme xeos:dealOutcome ;
    skos:topConceptOf xeos:dealOutcome ;
    skos:notation "open" ;
    skos:prefLabel "Open"@en ;
    skos:definition "The deal has not closed"@en .

xeos:dealOutcome-won a skos:Concept ;
    skos:inScheme xeos:dealOutcome ;
    skos:topConceptOf xeos:dealOutcome ;
    skos:notation "won" ;
    skos:prefLabel "Won"@en ;
    skos:definition "The deal closed and was won"@en .

xeos:dealOutcome-lost a skos:Concept ;
    skos:inScheme xeos:dealOutcome ;
    skos:topConceptOf xeos:dealOutcome ;
    skos:notation "lost" ;
    skos:prefLabel "Lost"@en ;
    skos:definition "The deal closed and was lost"@en .

# --- Deal stage classes -----------------------------------------------------

xeos:dealStageClass a skos:ConceptScheme ;
    skos:prefLabel "Deal stage classes"@en ;
    xeo:fillsSlot xeo:stageClass ;
    dct:source "XEO CRM pipeline research report, 2026-11-10 (the closed and won flags CRMs keep on a stage's configuration)" ;
    dct:description "What a tenant's deal stage means, whatever it is called. The class a per-tenant mapping assigns to each stageRef, and what dealOutcome is read through where the CRM states no outcome of its own." .

xeos:dealStageClass-open a skos:Concept ;
    skos:inScheme xeos:dealStageClass ;
    skos:topConceptOf xeos:dealStageClass ;
    skos:notation "open" ;
    skos:prefLabel "Open"@en ;
    skos:definition "A stage a deal is still being worked in"@en .

xeos:dealStageClass-won a skos:Concept ;
    skos:inScheme xeos:dealStageClass ;
    skos:topConceptOf xeos:dealStageClass ;
    skos:notation "won" ;
    skos:prefLabel "Won"@en ;
    skos:definition "A stage that closes a deal as won"@en .

xeos:dealStageClass-lost a skos:Concept ;
    skos:inScheme xeos:dealStageClass ;
    skos:topConceptOf xeos:dealStageClass ;
    skos:notation "lost" ;
    skos:prefLabel "Lost"@en ;
    skos:definition "A stage that closes a deal as lost"@en .

# --- Lifecycle stage classes (extension) ------------------------------------

xeos:lifecycleStageClass a skos:ConceptScheme ;
    skos:prefLabel "Lifecycle stage classes"@en ;
    xeo:fillsSlot xeo:lifecycleStage ;
    xeo:termStatus "extension" ;
    dct:source "XEO CRM pipeline research report, 2026-11-10 (one CRM's default lifecycle, neutral spelling; the only CRM of the seven that carries a lifecycle stage natively)" ;
    dct:description "The funnel position of a person or organization. Fills lifecycleStage, and is what stageClass takes on a lifecycle StageTransition. An extension: the stages are one vendor's default ladder, and what qualifies a lead for each is every tenant's own rule. 'other' is where a tenant's custom stage goes." .

xeos:lifecycleStageClass-subscriber a skos:Concept ;
    skos:inScheme xeos:lifecycleStageClass ;
    skos:topConceptOf xeos:lifecycleStageClass ;
    skos:notation "subscriber" ;
    skos:prefLabel "Subscriber"@en ;
    skos:definition "Has opted in to hear from the business and nothing more"@en .

xeos:lifecycleStageClass-lead a skos:Concept ;
    skos:inScheme xeos:lifecycleStageClass ;
    skos:topConceptOf xeos:lifecycleStageClass ;
    skos:notation "lead" ;
    skos:prefLabel "Lead"@en ;
    skos:definition "Has shown interest beyond subscribing"@en .

xeos:lifecycleStageClass-mql a skos:Concept ;
    skos:inScheme xeos:lifecycleStageClass ;
    skos:topConceptOf xeos:lifecycleStageClass ;
    skos:notation "mql" ;
    skos:prefLabel "Marketing-qualified lead"@en ;
    skos:definition "Marketing judges the lead ready to hand to sales, by the tenant's own criteria"@en .

xeos:lifecycleStageClass-sql a skos:Concept ;
    skos:inScheme xeos:lifecycleStageClass ;
    skos:topConceptOf xeos:lifecycleStageClass ;
    skos:notation "sql" ;
    skos:prefLabel "Sales-qualified lead"@en ;
    skos:definition "Sales has accepted the lead as worth pursuing, by the tenant's own criteria"@en .

xeos:lifecycleStageClass-opportunity a skos:Concept ;
    skos:inScheme xeos:lifecycleStageClass ;
    skos:topConceptOf xeos:lifecycleStageClass ;
    skos:notation "opportunity" ;
    skos:prefLabel "Opportunity"@en ;
    skos:definition "Associated with an open deal"@en .

xeos:lifecycleStageClass-customer a skos:Concept ;
    skos:inScheme xeos:lifecycleStageClass ;
    skos:topConceptOf xeos:lifecycleStageClass ;
    skos:notation "customer" ;
    skos:prefLabel "Customer"@en ;
    skos:definition "Has at least one deal won"@en .

xeos:lifecycleStageClass-evangelist a skos:Concept ;
    skos:inScheme xeos:lifecycleStageClass ;
    skos:topConceptOf xeos:lifecycleStageClass ;
    skos:notation "evangelist" ;
    skos:prefLabel "Evangelist"@en ;
    skos:definition "A customer who advocates for the business"@en .

xeos:lifecycleStageClass-other a skos:Concept ;
    skos:inScheme xeos:lifecycleStageClass ;
    skos:topConceptOf xeos:lifecycleStageClass ;
    skos:notation "other" ;
    skos:prefLabel "Other"@en ;
    skos:definition "A tenant-specific stage with no neutral class"@en .

# --- Stage slots ------------------------------------------------------------

xeos:stageSlot a skos:ConceptScheme ;
    skos:prefLabel "Stage slots"@en ;
    xeo:fillsSlot xeo:stageSlot ;
    dct:source "XEO CRM pipeline research report, 2026-11-10 (StageTransition term card; codes in snake_case to match every other XEO code)" ;
    dct:description "Which of a record's staged properties a StageTransition records a move in." .

xeos:stageSlot-deal_stage a skos:Concept ;
    skos:inScheme xeos:stageSlot ;
    skos:topConceptOf xeos:stageSlot ;
    skos:notation "deal_stage" ;
    skos:prefLabel "Deal stage"@en ;
    skos:definition "The stage of a deal in its pipeline"@en .

xeos:stageSlot-lifecycle a skos:Concept ;
    skos:inScheme xeos:stageSlot ;
    skos:topConceptOf xeos:stageSlot ;
    skos:notation "lifecycle" ;
    skos:prefLabel "Lifecycle stage"@en ;
    skos:definition "The funnel position of a person or organization"@en .

xeos:stageSlot-lead_status a skos:Concept ;
    skos:inScheme xeos:stageSlot ;
    skos:topConceptOf xeos:stageSlot ;
    skos:notation "lead_status" ;
    skos:prefLabel "Lead status"@en ;
    skos:definition "The sales working state of a lead"@en .

# --- Acquisition channels ---------------------------------------------------

xeos:acquisitionChannel a skos:ConceptScheme ;
    skos:prefLabel "Acquisition channels"@en ;
    xeo:fillsSlot xeo:firstTouchChannel ;
    dct:source "XEO CRM pipeline research report, 2026-11-10 · ai_assistant is evidenced by two vendors' classifiers (one CRM's traffic-source value, one analytics tool's default channel). The other values are a neutral set inferred for XEO from the channel lists those classifiers publish; no vendor's list is adopted" ;
    dct:description "Where a person came from, as a classifier or a person recorded it. Fills firstTouchChannel and latestTouchChannel, and is the set a session-grain channel should reuse. Deliberately coarse. ai_assistant is the value the set exists for: a visit referred by an AI assistant's own domain. A search engine's AI overview is not one either: the visit comes from a results page, so it has its own value, ai_overview, which no source fills yet. Every vendor draws these lines its own way, so a mapped value is a derivation and says whose rule made it." .

xeos:acquisitionChannel-organic_search a skos:Concept ;
    skos:inScheme xeos:acquisitionChannel ;
    skos:topConceptOf xeos:acquisitionChannel ;
    skos:notation "organic_search" ;
    skos:prefLabel "Organic search"@en ;
    skos:definition "Arrived from an unpaid search result"@en .

xeos:acquisitionChannel-paid_search a skos:Concept ;
    skos:inScheme xeos:acquisitionChannel ;
    skos:topConceptOf xeos:acquisitionChannel ;
    skos:notation "paid_search" ;
    skos:prefLabel "Paid search"@en ;
    skos:definition "Arrived from a search advertisement"@en .

xeos:acquisitionChannel-ai_assistant a skos:Concept ;
    skos:inScheme xeos:acquisitionChannel ;
    skos:topConceptOf xeos:acquisitionChannel ;
    skos:notation "ai_assistant" ;
    skos:prefLabel "AI assistant"@en ;
    skos:definition "Arrived from an AI assistant's own domain or app: a chat or answer product, not a search engine's results page"@en .

xeos:acquisitionChannel-ai_overview a skos:Concept ;
    skos:inScheme xeos:acquisitionChannel ;
    skos:topConceptOf xeos:acquisitionChannel ;
    skos:notation "ai_overview" ;
    skos:prefLabel "AI overview"@en ;
    skos:definition "Arrived from an AI-generated overview on a search engine's results page"@en ;
    xeo:termStatus "extension" ;
    skos:editorialNote "Kept apart from ai_assistant and from organic_search by decision (2026-11-11): the visit comes from a results page, so it is not an assistant's, and it was sent by a generated answer, so it is not an ordinary result. No source read reports it separately, and no vendor field in mappings/ carries it, so the value has no filling yet. It is declared so that it has a home when a tool reports it."@en .

xeos:acquisitionChannel-referral a skos:Concept ;
    skos:inScheme xeos:acquisitionChannel ;
    skos:topConceptOf xeos:acquisitionChannel ;
    skos:notation "referral" ;
    skos:prefLabel "Referral"@en ;
    skos:definition "Arrived from a link on another site that is not search, social or an AI assistant"@en .

xeos:acquisitionChannel-organic_social a skos:Concept ;
    skos:inScheme xeos:acquisitionChannel ;
    skos:topConceptOf xeos:acquisitionChannel ;
    skos:notation "organic_social" ;
    skos:prefLabel "Organic social"@en ;
    skos:definition "Arrived from an unpaid social post or profile"@en .

xeos:acquisitionChannel-paid_social a skos:Concept ;
    skos:inScheme xeos:acquisitionChannel ;
    skos:topConceptOf xeos:acquisitionChannel ;
    skos:notation "paid_social" ;
    skos:prefLabel "Paid social"@en ;
    skos:definition "Arrived from a social advertisement"@en .

xeos:acquisitionChannel-email a skos:Concept ;
    skos:inScheme xeos:acquisitionChannel ;
    skos:topConceptOf xeos:acquisitionChannel ;
    skos:notation "email" ;
    skos:prefLabel "Email"@en ;
    skos:definition "Arrived from a link in an email"@en .

xeos:acquisitionChannel-direct a skos:Concept ;
    skos:inScheme xeos:acquisitionChannel ;
    skos:topConceptOf xeos:acquisitionChannel ;
    skos:notation "direct" ;
    skos:prefLabel "Direct"@en ;
    skos:definition "Arrived with no referrer: typed, bookmarked, or stripped"@en .

xeos:acquisitionChannel-offline a skos:Concept ;
    skos:inScheme xeos:acquisitionChannel ;
    skos:topConceptOf xeos:acquisitionChannel ;
    skos:notation "offline" ;
    skos:prefLabel "Offline"@en ;
    skos:definition "Entered other than by a tracked visit: an import, an event, a call, manual entry"@en .

xeos:acquisitionChannel-other a skos:Concept ;
    skos:inScheme xeos:acquisitionChannel ;
    skos:topConceptOf xeos:acquisitionChannel ;
    skos:notation "other" ;
    skos:prefLabel "Other"@en ;
    skos:definition "Tracked, and matching none of the above: an untyped campaign"@en .

# --- Conversion point types -------------------------------------------------

xeos:conversionPointType a skos:ConceptScheme ;
    skos:prefLabel "Conversion point types"@en ;
    xeo:fillsSlot xeo:conversionPointType ;
    dct:source "XEO CRM pipeline research report, 2026-11-10 · the three ConversionPoint subclasses (xeo-engagement until 0.7, now core), as codes, with two kinds the report adds" ;
    dct:description "The kind of mechanism a ConversionPoint is. The first three say with a code what the CallToAction, LeadCaptureForm and GatedAsset subclasses say with a class; the list was growing, and a growing list is a scheme." .

xeos:conversionPointType-cta a skos:Concept ;
    skos:inScheme xeos:conversionPointType ;
    skos:topConceptOf xeos:conversionPointType ;
    skos:notation "cta" ;
    skos:prefLabel "Call to action"@en ;
    skos:definition "A button or link that asks the visitor to take the next step"@en ;
    skos:exactMatch xeo:CallToAction .

xeos:conversionPointType-lead_form a skos:Concept ;
    skos:inScheme xeos:conversionPointType ;
    skos:topConceptOf xeos:conversionPointType ;
    skos:notation "lead_form" ;
    skos:prefLabel "Lead capture form"@en ;
    skos:definition "A form that exchanges contact details for a response, a quote or a booking"@en ;
    skos:exactMatch xeo:LeadCaptureForm .

xeos:conversionPointType-gated_asset a skos:Concept ;
    skos:inScheme xeos:conversionPointType ;
    skos:topConceptOf xeos:conversionPointType ;
    skos:notation "gated_asset" ;
    skos:prefLabel "Gated asset"@en ;
    skos:definition "Content exchanged for contact information"@en ;
    skos:exactMatch xeo:GatedAsset .

xeos:conversionPointType-meeting_booker a skos:Concept ;
    skos:inScheme xeos:conversionPointType ;
    skos:topConceptOf xeos:conversionPointType ;
    skos:notation "meeting_booker" ;
    skos:prefLabel "Meeting booker"@en ;
    skos:definition "An embedded scheduler that books a meeting"@en .

xeos:conversionPointType-chat a skos:Concept ;
    skos:inScheme xeos:conversionPointType ;
    skos:topConceptOf xeos:conversionPointType ;
    skos:notation "chat" ;
    skos:prefLabel "Chat"@en ;
    skos:definition "A live chat or chatbot that can capture a contact"@en .

# --- Search intents ---------------------------------------------------------

xeos:searchIntent a skos:ConceptScheme ;
    skos:prefLabel "Search intents"@en ;
    xeo:fillsSlot xeo:targetsIntent ;
    dct:source "Broder (2002), 'A taxonomy of web search', as extended in common practice · the four SearchIntent individuals (xeo-engagement until 0.7, now core), as concepts" ;
    dct:description "Why the person is asking. The same four values core declares as named individuals, published as concepts so that a value is a code and not a term. Each concept is also an xeo:SearchIntent, so targetsIntent may point at it without any change to that property." .

xeos:searchIntent-informational a skos:Concept , xeo:SearchIntent ;
    skos:inScheme xeos:searchIntent ;
    skos:topConceptOf xeos:searchIntent ;
    skos:notation "informational" ;
    skos:prefLabel "Informational"@en ;
    skos:definition "The person wants to learn something"@en ;
    skos:exactMatch xeo:Informational .

xeos:searchIntent-navigational a skos:Concept , xeo:SearchIntent ;
    skos:inScheme xeos:searchIntent ;
    skos:topConceptOf xeos:searchIntent ;
    skos:notation "navigational" ;
    skos:prefLabel "Navigational"@en ;
    skos:definition "The person wants to reach a particular site or page"@en ;
    skos:exactMatch xeo:Navigational .

xeos:searchIntent-commercial_investigation a skos:Concept , xeo:SearchIntent ;
    skos:inScheme xeos:searchIntent ;
    skos:topConceptOf xeos:searchIntent ;
    skos:notation "commercial_investigation" ;
    skos:prefLabel "Commercial investigation"@en ;
    skos:definition "The person is comparing options before a purchase"@en ;
    skos:exactMatch xeo:CommercialInvestigation .

xeos:searchIntent-transactional a skos:Concept , xeo:SearchIntent ;
    skos:inScheme xeos:searchIntent ;
    skos:topConceptOf xeos:searchIntent ;
    skos:notation "transactional" ;
    skos:prefLabel "Transactional"@en ;
    skos:definition "The person wants to do something now: buy, book, sign up"@en ;
    skos:exactMatch xeo:Transactional .

