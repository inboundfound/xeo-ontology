      "benchmarkVersion": "1.0", "graderKind": "verifier"
    },
    { "id": "ex:task-1", "type": "BenchmarkTask", "taskRef": "audit-001", "inBenchmark": "ex:benchmark" },
    { "id": "ex:task-2", "type": "BenchmarkTask", "taskRef": "audit-002", "inBenchmark": "ex:benchmark" },

    { "id": "ex:tactic-audit-skill", "type": "Tactic", "name": "Give the agent a content-audit skill" },
    {
      "id": "ex:experiment", "type": "Experiment",
