      "status": "concluded",
      "startedAt": "2026-11-02T09:00:00Z", "concludedAt": "2026-11-04T17:00:00Z",
      "preRegistrationRef": "https://example.com/repo/releases/tag/experiment-0007-plan",
      "primaryMetric": "ex:metric-task-pass-rate",
      "guardrailMetric": "ex:metric-cost-per-task",
