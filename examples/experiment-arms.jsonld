      "id": "ex:metric-cost-per-task", "type": "Metric",
      "notation": "cost_per_task",
      "prefLabel": "Cost per task",
      "definition": "The mean cost of one trial, from the cost of the session it ran in.",
      "metricType": "xeos:metricType-simple",
      "aggregation": "xeos:aggregation-mean",
      "readsSlot": "xeo:costAmount",
      "unit": "xeos:metricUnit-currency",
      "betterDirection": "xeos:betterDirection-down",
      "additivity": "xeos:additivity-non_additive"
    },

