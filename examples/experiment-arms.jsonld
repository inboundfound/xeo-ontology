    { "id": "ex:vendor", "type": "Organization", "name": "Example Tools" },
    {
      "id": "ex:claim", "type": "Claim", "claimedBy": "ex:vendor",
      "statement": "Our content-audit skill lifts an agent's pass rate on audit tasks by 40 points.",
      "claimMetric": "ex:metric-task-pass-rate", "claimedValue": "0.40",
      "counterfactual": "The same agent and harness without the skill",
      "claimSourceUri": "https://example.org/blog/audit-skill-launch", "claimedAt": "2026-10-20"
    },
    {
      "id": "ex:claim-check", "type": "ClaimCheck", "checksClaim": "ex:claim",
      "checkedBy": "ex:experiment", "claimVerdict": "real_but_small",
      "method": "Read the claimed 0.40 against the outcome's interval, 0.04 to 0.26"
    },

    {
      "id": "ex:lesson", "type": "Lesson",
      "statement": "On audit tasks, the content-audit skill raises the pass rate by about 15 points, well short of the 40 its maker claims.",
      "drawnFrom": ["ex:outcome-skill", "ex:claim-check"],
      "method": "Reviewed by the team after the experiment concluded", "confidence": "0.7",
      "adoptedAs": "ex:practice-use-skill"
    },
