    },
    {
      "id": "ex:outcome-skill", "type": "Outcome", "forArm": "ex:arm-skill",
      "absoluteChange": "0.15", "relativeChange": "0.25", "result": "significant",
      "ciLower": "0.04", "ciUpper": "0.26", "ciMethod": "task-clustered bootstrap, 95%",
