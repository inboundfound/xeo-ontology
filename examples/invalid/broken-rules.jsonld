{
  "@context": [
    "../../context.jsonld",
    {
      "ex": "https://example.com/graph/",
      "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
      "Edge": "rdf:Statement",
      "start": { "@id": "rdf:subject", "@type": "@id" },
      "edge": { "@id": "rdf:predicate", "@type": "@vocab" },
      "end": { "@id": "rdf:object", "@type": "@id" },
      "expect": "https://xeoontology.org/shapes#expectedViolation"
    }
  ],
  "@graph": [
    { "id": "ex:bad-url", "type": "URL", "websiteId": "example-com", "expect": "URLShape" },
    { "id": "ex:bad-domain", "type": "Domain", "expect": "DomainShape" },
    { "id": "ex:bad-serp", "type": "SerpSnapshot", "locale": "en-GB", "expect": "SerpSnapshotShape" },
    { "id": "ex:bad-response", "type": "LLMResponse", "capturedAt": "2026-06-03T09:05:00Z", "expect": "LLMResponseShape" },
    { "id": "ex:bad-target", "type": "MetricTarget", "targetValue": "0.40", "expect": "MetricTargetShape" },
    { "id": "ex:bad-outcome", "type": "Outcome", "absoluteChange": "0.15", "expect": "OutcomeShape" },
    { "id": "ex:bad-practice", "type": "Practice", "statement": "A rule with no kind and no status.", "expect": "PracticeShape" },
    { "id": "ex:bad-consent", "type": "Consent", "consentPurpose": "ad_personalization", "consentStatus": "GRANTED", "consentRecordedAt": "2026-11-01T10:00:00Z", "expect": "ConsentShape" },
    { "id": "ex:bad-credit", "type": "AttributedCredit", "creditShare": "0.5", "expect": "AttributedNumberNamesItsModel" },
    { "id": "ex:bad-share", "creditShare": "1.4", "expect": "CreditShareIsAShare" },
    { "id": "ex:bad-stage", "type": "Stage", "name": "Ranked", "stageOrder": "second", "expect": "StageShape" },
    { "id": "ex:bad-run", "type": "AlgorithmRun", "algorithm": "xeos:algorithm-pagerank", "expect": "AlgorithmRunShape" },
    { "id": "ex:bad-gap", "type": "Gap", "magnitude": "120", "expect": "MagnitudeNeedsUnit" },
    { "id": "ex:bad-gap-2", "type": "Gap", "magnitudeUnit": "xeos:magnitudeUnit-clicks", "expect": "UnitNeedsMagnitude" },
    {
      "id": "ex:bad-edge-1", "type": "Edge", "start": "ex:a", "edge": "similarTo", "end": "ex:b",
      "similarity": "1.4", "expect": "SimilarityRange"
    },
    {
      "id": "ex:bad-edge-2", "type": "Edge", "start": "ex:a", "edge": "about", "end": "ex:t",
      "confidence": "87", "expect": "ConfidenceRange"
    },
    {
      "id": "ex:bad-edge-3", "type": "Edge", "start": "ex:p", "edge": "visibilityFor", "end": "ex:br",
      "mentionRate": "35", "citationRate": "-0.1", "expect": ["MentionRateRange", "CitationRateRange"]
    },

    { "id": "ex:bad-metric", "type": "Metric", "expect": "MetricShape" },
    {
      "id": "ex:bad-simple-metric", "type": "Metric",
      "metricType": "xeos:metricType-simple", "aggregation": "xeos:aggregation-sum",
      "unit": "xeos:metricUnit-count", "betterDirection": "xeos:betterDirection-up",
      "additivity": "xeos:additivity-additive", "expect": "SimpleMetricShape"
    },
    {
      "id": "ex:bad-ratio-metric", "type": "Metric",
      "metricType": "xeos:metricType-ratio",
      "numerator": "xeos:metric-clicks", "denominator": "xeos:metric-impressions",
      "unit": "xeos:metricUnit-count", "betterDirection": "xeos:betterDirection-up",
      "additivity": "xeos:additivity-non_additive", "expect": "RatioMetricShape"
    },
    {
      "id": "ex:bad-derived-metric", "type": "Metric",
      "metricType": "xeos:metricType-derived", "expression": "revenue_won / deals_won",
      "unit": "xeos:metricUnit-currency", "betterDirection": "xeos:betterDirection-up",
      "additivity": "xeos:additivity-non_additive", "expect": "DerivedMetricShape"
    },
    {
      "id": "ex:bad-reading", "type": "MetricReading",
      "readingOf": "xeos:metric-clicks", "value": "310", "periodStart": "2026-06-03",
      "expect": "MetricReadingShape"
    },
    {
      "id": "ex:bad-currency-reading", "type": "MetricReading",
      "readingOf": "xeos:metric-revenue_won", "value": "42000",
      "periodStart": "2026-07-01", "periodEnd": "2026-07-28",
      "expect": "CurrencyReadingNeedsCurrency"
    },
    {
      "id": "ex:bad-currency-target", "type": "MetricTarget",
      "targetMetric": "xeos:metric-revenue_won", "targetValue": "40000", "expect": "CurrencyTargetNeedsCurrency"
    },
    { "id": "ex:bad-deal", "crmRecordRef": "hubspot:12345:deal:1", "dealAmount": "42000", "expect": "DealAmountNeedsCurrency" },
    {
      "id": "ex:bad-deal-2", "crmRecordRef": "hubspot:12345:deal:2",
      "dealAmount": "42000", "currencyCode": "gbp", "expect": "CurrencyCodeFormat"
    },
    { "id": "ex:bad-transition", "type": "StageTransition", "toStageRef": "closedwon", "expect": "StageTransitionShape" }
  ]
}
