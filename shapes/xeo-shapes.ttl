@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xeo:  <https://xeoontology.org/xeo#> .
@prefix xeos: <https://xeoontology.org/schemes#> .
@prefix xeosh: <https://xeoontology.org/shapes#> .

# XEO Shapes — the prose rules, made executable.
#
# The ontology states its rules in dct:description: a magnitude is "required
# together with magnitudeUnit and never alone", confidence is "0-1", a captured
# response without its model "is not comparable across time". RDFS cannot check
# any of that. rdfs:domain and rdfs:range are entailment rules, not constraints,
# so until this file the only enforced rule in XEO was a Neo4j uniqueness
# constraint. These shapes turn the rules that can be checked into SHACL.
#
# CONSERVATIVE BY DESIGN. A shape here fires only on data the ontology already
# calls wrong. Nothing is closed: extra properties, local terms and open
# domains all pass. Where the ontology says "expected" or "should" rather than
# "required", there is no shape. Passing these shapes means a graph breaks none
# of XEO's stated rules; it does not mean the graph is complete or sensible.
#
# EDGE-CARRIED PROPERTIES. confidence, similarity, magnitude and the rollup
# rates ride on relationships in a property graph and on reified statements (or
# plain nodes) in RDF. The range shapes therefore target "any subject that
# carries the property" (sh:targetSubjectsOf), which holds wherever it sits.
#
# Run:  uv run --no-project --with rdflib --with pyshacl python tools/validate.py
#   or: pyshacl -s shapes/xeo-shapes.ttl <your-data>

xeosh: a owl:Ontology ;
    dct:title "XEO Shapes" ;
    dct:description "SHACL shapes for the rules the XEO ontology states in prose. Conservative: each shape checks one rule a term's description already makes, and none closes a class." ;
    dct:creator "Inbound Found" ;
    owl:versionInfo "0.7.0" .

# --- Values in range ---------------------------------------------------------

xeosh:ConfidenceRange a sh:NodeShape ;
    rdfs:label "confidence is between 0 and 1" ;
    rdfs:seeAlso xeo:confidence ;
    sh:targetSubjectsOf xeo:confidence ;
    sh:property [
        sh:path xeo:confidence ;
        sh:minInclusive 0 ; sh:maxInclusive 1 ;
        sh:message "xeo:confidence must be a number from 0 to 1."
    ] .

xeosh:SimilarityRange a sh:NodeShape ;
    rdfs:label "similarity is between 0 and 1" ;
    rdfs:seeAlso xeo:similarity ;
    sh:targetSubjectsOf xeo:similarity ;
    sh:property [
        sh:path xeo:similarity ;
        sh:minInclusive 0 ; sh:maxInclusive 1 ;
        sh:message "xeo:similarity must be a number from 0 to 1."
    ] .

xeosh:MentionRateRange a sh:NodeShape ;
    rdfs:label "mentionRate is a share" ;
    rdfs:seeAlso xeo:mentionRate ;
    sh:targetSubjectsOf xeo:mentionRate ;
    sh:property [
        sh:path xeo:mentionRate ;
        sh:minInclusive 0 ; sh:maxInclusive 1 ;
        sh:message "xeo:mentionRate is a share of responses and must be from 0 to 1."
    ] .

xeosh:CitationRateRange a sh:NodeShape ;
    rdfs:label "citationRate is a share" ;
    rdfs:seeAlso xeo:citationRate ;
    sh:targetSubjectsOf xeo:citationRate ;
    sh:property [
        sh:path xeo:citationRate ;
        sh:minInclusive 0 ; sh:maxInclusive 1 ;
        sh:message "xeo:citationRate is a share of responses and must be from 0 to 1."
    ] .

# --- Pairs that travel together ----------------------------------------------

xeosh:MagnitudeNeedsUnit a sh:NodeShape ;
    rdfs:label "a magnitude has a unit" ;
    rdfs:seeAlso xeo:magnitude ;
    sh:targetSubjectsOf xeo:magnitude ;
    sh:property [
        sh:path xeo:magnitudeUnit ;
        sh:minCount 1 ;
        sh:message "A xeo:magnitude without a xeo:magnitudeUnit is an uninterpretable number."
    ] .

xeosh:UnitNeedsMagnitude a sh:NodeShape ;
    rdfs:label "a magnitude unit has a magnitude" ;
    rdfs:seeAlso xeo:magnitudeUnit ;
    sh:targetSubjectsOf xeo:magnitudeUnit ;
    sh:property [
        sh:path xeo:magnitude ;
        sh:minCount 1 ;
        sh:message "A xeo:magnitudeUnit without a xeo:magnitude is noise."
    ] .

# --- What a node of a class must carry ----------------------------------------

xeosh:URLShape a sh:NodeShape ;
    rdfs:label "a URL has its address" ;
    sh:targetClass xeo:URL ;
    sh:property [
        sh:path xeo:address ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A xeo:URL is identified by exactly one xeo:address."
    ] .

xeosh:DomainShape a sh:NodeShape ;
    rdfs:label "a Domain has its name" ;
    sh:targetClass xeo:Domain ;
    sh:property [
        sh:path xeo:name ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A xeo:Domain is identified by exactly one xeo:name."
    ] .

xeosh:SerpSnapshotShape a sh:NodeShape ;
    rdfs:label "a SERP snapshot says when it was captured" ;
    sh:targetClass xeo:SerpSnapshot ;
    sh:property [
        sh:path xeo:capturedAt ;
        sh:minCount 1 ;
        sh:message "A xeo:SerpSnapshot is an observation at a moment and requires xeo:capturedAt."
    ] .

xeosh:LLMResponseShape a sh:NodeShape ;
    rdfs:label "a captured response says when, and from which model" ;
    sh:targetClass xeo:LLMResponse ;
    sh:property [
        sh:path xeo:capturedAt ;
        sh:minCount 1 ;
        sh:message "A xeo:LLMResponse requires xeo:capturedAt."
    ] ;
    sh:property [
        sh:path xeo:model ;
        sh:minCount 1 ;
        sh:message "A xeo:LLMResponse requires xeo:model: without it the episode is not comparable across time."
    ] .

xeosh:MetricTargetShape a sh:NodeShape ;
    rdfs:label "a metric target names its metric" ;
    sh:targetClass xeo:MetricTarget ;
    sh:property [
        sh:path xeo:targetMetric ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "A xeo:MetricTarget requires exactly one xeo:targetMetric, a link to its Metric."
    ] .

xeosh:OutcomeShape a sh:NodeShape ;
    rdfs:label "an outcome says whether it moved" ;
    sh:targetClass xeo:Outcome ;
    sh:property [
        sh:path xeo:result ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A xeo:Outcome requires exactly one xeo:result."
    ] .

xeosh:PracticeShape a sh:NodeShape ;
    rdfs:label "a practice has a statement, a kind and a status" ;
    sh:targetClass xeo:Practice ;
    sh:property [
        sh:path xeo:statement ;
        sh:minCount 1 ;
        sh:message "A xeo:Practice requires xeo:statement, the rule in plain language."
    ] ;
    sh:property [
        sh:path xeo:practiceKind ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A xeo:Practice requires exactly one xeo:practiceKind."
    ] ;
    sh:property [
        sh:path xeo:status ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A xeo:Practice requires exactly one xeo:status."
    ] .

xeosh:StageShape a sh:NodeShape ;
    rdfs:label "a stage's order, when given, is one integer" ;
    sh:targetClass xeo:Stage ;
    sh:property [
        sh:path xeo:stageOrder ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:message "xeo:stageOrder, when present on a xeo:Stage, must be a single xsd:integer."
    ] .

xeosh:AlgorithmRunShape a sh:NodeShape ;
    rdfs:label "an algorithm run says what ran, and on what" ;
    sh:targetClass xeo:AlgorithmRun ;
    sh:property [
        sh:path xeo:algorithm ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A xeo:AlgorithmRun requires exactly one xeo:algorithm."
    ] ;
    sh:property [
        sh:path xeo:projection ;
        sh:minCount 1 ;
        sh:message "A xeo:AlgorithmRun requires xeo:projection: a score is meaningless without the graph it was computed on."
    ] .

# --- Metrics and readings ----------------------------------------------------
# The rules core states for a Metric and a MetricReading. The typed
# rules (simple, ratio, derived) fire only when metricType is the concept from
# the published xeos:metricType scheme; a Metric typed from a consumer's own
# scheme is not judged by them. The Metrics published in xeos:metric are held
# to these shapes by tools/validate.py.
#
# CurrencyReadingNeedsCurrency reads through readingOf to the Metric's unit, so
# it can only fire where the Metric's definition is in the graph being
# validated. Load xeo-schemes.ttl beside your data, as tools/validate.py does,
# or keep your Metrics as nodes.

xeosh:MetricShape a sh:NodeShape ;
    rdfs:label "a metric has one type, unit, better direction and additivity" ;
    rdfs:seeAlso xeo:Metric ;
    sh:targetClass xeo:Metric ;
    sh:property [
        sh:path xeo:metricType ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A xeo:Metric requires exactly one xeo:metricType."
    ] ;
    sh:property [
        sh:path xeo:unit ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A xeo:Metric requires exactly one xeo:unit."
    ] ;
    sh:property [
        sh:path xeo:betterDirection ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A xeo:Metric requires exactly one xeo:betterDirection."
    ] ;
    sh:property [
        sh:path xeo:additivity ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A xeo:Metric requires exactly one xeo:additivity."
    ] .

xeosh:SimpleMetricShape a sh:NodeShape ;
    rdfs:label "a simple metric names its aggregation and the slot it reads" ;
    rdfs:seeAlso xeo:aggregation , xeo:readsSlot ;
    sh:targetClass xeo:Metric ;
    sh:or (
        [ sh:not [ sh:path xeo:metricType ; sh:hasValue xeos:metricType-simple ] ]
        [ sh:and (
            [ sh:path xeo:aggregation ; sh:minCount 1 ; sh:maxCount 1 ]
            [ sh:path xeo:readsSlot ; sh:minCount 1 ; sh:maxCount 1 ]
        ) ]
    ) ;
    sh:message "A simple xeo:Metric requires one xeo:aggregation and one xeo:readsSlot." .

xeosh:RatioMetricShape a sh:NodeShape ;
    rdfs:label "a ratio metric has a numerator, a denominator and unit ratio" ;
    rdfs:seeAlso xeo:numerator , xeo:denominator ;
    sh:targetClass xeo:Metric ;
    sh:or (
        [ sh:not [ sh:path xeo:metricType ; sh:hasValue xeos:metricType-ratio ] ]
        [ sh:and (
            [ sh:path xeo:numerator ; sh:minCount 1 ; sh:maxCount 1 ]
            [ sh:path xeo:denominator ; sh:minCount 1 ; sh:maxCount 1 ]
            [ sh:path xeo:unit ; sh:hasValue xeos:metricUnit-ratio ]
        ) ]
    ) ;
    sh:message "A ratio xeo:Metric requires one xeo:numerator, one xeo:denominator, and xeo:unit ratio." .

xeosh:DerivedMetricShape a sh:NodeShape ;
    rdfs:label "a derived metric has an expression and at least one input" ;
    rdfs:seeAlso xeo:expression , xeo:inputMetric ;
    sh:targetClass xeo:Metric ;
    sh:or (
        [ sh:not [ sh:path xeo:metricType ; sh:hasValue xeos:metricType-derived ] ]
        [ sh:and (
            [ sh:path xeo:expression ; sh:minCount 1 ; sh:maxCount 1 ]
            [ sh:path xeo:inputMetric ; sh:minCount 1 ]
        ) ]
    ) ;
    sh:message "A derived xeo:Metric requires one xeo:expression and at least one xeo:inputMetric." .

xeosh:MetricReadingShape a sh:NodeShape ;
    rdfs:label "a reading has a value, a window and the metric it is a reading of" ;
    rdfs:seeAlso xeo:MetricReading ;
    sh:targetClass xeo:MetricReading ;
    sh:property [
        sh:path xeo:readingOf ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A xeo:MetricReading requires exactly one xeo:readingOf."
    ] ;
    sh:property [
        sh:path xeo:value ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A xeo:MetricReading requires exactly one xeo:value."
    ] ;
    sh:property [
        sh:path xeo:periodStart ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A xeo:MetricReading requires exactly one xeo:periodStart."
    ] ;
    sh:property [
        sh:path xeo:periodEnd ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A xeo:MetricReading requires exactly one xeo:periodEnd."
    ] .

xeosh:CurrencyReadingNeedsCurrency a sh:NodeShape ;
    rdfs:label "a reading of a currency metric says which currency" ;
    rdfs:seeAlso xeo:currencyCode ;
    sh:targetClass xeo:MetricReading ;
    sh:or (
        [ sh:not [ sh:path ( xeo:readingOf xeo:unit ) ; sh:hasValue xeos:metricUnit-currency ] ]
        [ sh:path xeo:currencyCode ; sh:minCount 1 ; sh:maxCount 1 ]
    ) ;
    sh:message "A xeo:MetricReading of a Metric whose unit is currency requires one xeo:currencyCode." .

# --- Money ---------------------------------------------------------------------

xeosh:CurrencyTargetNeedsCurrency a sh:NodeShape ;
    rdfs:label "a pipeline currency target says which currency" ;
    rdfs:seeAlso xeo:targetCurrency ;
    sh:targetClass xeo:MetricTarget ;
    # The currency metrics are listed by their Metric. Only the two read from
    # deal amounts: etv was targetable before targetCurrency existed and its
    # currency is the vendor's, so it is left alone.
    sh:or (
        [ sh:not [ sh:path xeo:targetMetric ; sh:minCount 1 ; sh:in ( xeos:metric-pipeline_created xeos:metric-revenue_won ) ] ]
        [ sh:path xeo:targetCurrency ; sh:minCount 1 ; sh:maxCount 1 ]
    ) ;
    sh:message "A xeo:MetricTarget on pipeline_created or revenue_won requires one xeo:targetCurrency." .

xeosh:DealAmountNeedsCurrency a sh:NodeShape ;
    rdfs:label "a deal amount has a currency, and is not negative" ;
    rdfs:seeAlso xeo:dealAmount ;
    sh:targetSubjectsOf xeo:dealAmount ;
    sh:property [
        sh:path xeo:currencyCode ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A xeo:dealAmount without a xeo:currencyCode cannot be summed or compared."
    ] ;
    sh:property [
        sh:path xeo:dealAmount ;
        sh:minInclusive 0 ;
        sh:message "xeo:dealAmount is zero or more."
    ] .

xeosh:CurrencyCodeFormat a sh:NodeShape ;
    rdfs:label "a currency code is three upper-case letters" ;
    rdfs:seeAlso xeo:currencyCode , xeo:targetCurrency ;
    sh:targetSubjectsOf xeo:currencyCode , xeo:targetCurrency ;
    sh:property [
        sh:path xeo:currencyCode ;
        sh:pattern "^[A-Z]{3}$" ;
        sh:message "xeo:currencyCode is an ISO 4217 code: three upper-case letters."
    ] ;
    sh:property [
        sh:path xeo:targetCurrency ;
        sh:pattern "^[A-Z]{3}$" ;
        sh:message "xeo:targetCurrency is an ISO 4217 code: three upper-case letters."
    ] .

# --- CRM stage history ---------------------------------------------------------

xeosh:StageTransitionShape a sh:NodeShape ;
    rdfs:label "a stage transition says which record entered which stage, and when" ;
    rdfs:seeAlso xeo:StageTransition ;
    sh:targetClass xeo:StageTransition ;
    sh:property [
        sh:path xeo:crmRecordRef ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A xeo:StageTransition requires exactly one xeo:crmRecordRef."
    ] ;
    sh:property [
        sh:path xeo:toStageRef ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A xeo:StageTransition requires exactly one xeo:toStageRef."
    ] ;
    sh:property [
        sh:path xeo:enteredAt ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A xeo:StageTransition requires exactly one xeo:enteredAt."
    ] .

# --- Consent (0.7) ---------------------------------------------------------------

xeosh:ConsentShape a sh:NodeShape ;
    rdfs:label "a consent names one subject, purpose, status and time" ;
    sh:targetClass xeo:Consent ;
    sh:property [
        sh:path xeo:consentSubject ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A xeo:Consent requires exactly one xeo:consentSubject."
    ] ;
    sh:property [
        sh:path xeo:consentPurpose ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A xeo:Consent requires exactly one xeo:consentPurpose."
    ] ;
    sh:property [
        sh:path xeo:consentStatus ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "granted" "denied" "unspecified" ) ;
        sh:message "A xeo:Consent requires one xeo:consentStatus: granted, denied or unspecified."
    ] ;
    sh:property [
        sh:path xeo:consentRecordedAt ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A xeo:Consent requires exactly one xeo:consentRecordedAt."
    ] .

# --- Attribution (0.7) -----------------------------------------------------------

xeosh:AttributedNumberNamesItsModel a sh:NodeShape ;
    rdfs:label "an attributed number names its attribution model" ;
    rdfs:seeAlso xeo:usesAttributionModel ;
    sh:targetClass xeo:AttributedCredit , xeo:AttributionRollup ;
    sh:property [
        sh:path xeo:usesAttributionModel ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "An xeo:AttributedCredit or xeo:AttributionRollup requires exactly one xeo:usesAttributionModel: a credited number without its model cannot be read."
    ] .

xeosh:CreditShareIsAShare a sh:NodeShape ;
    rdfs:label "a credit share is between 0 and 1" ;
    sh:targetSubjectsOf xeo:creditShare ;
    sh:property [
        sh:path xeo:creditShare ; sh:maxCount 1 ;
        sh:minInclusive 0 ; sh:maxInclusive 1 ;
        sh:message "xeo:creditShare is one number from 0 to 1."
    ] .
