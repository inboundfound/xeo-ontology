@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix weo:  <https://inboundfound.github.io/weo-ontology/weo#> .

# WEO Engagement module — DRAFT (v0).
#
# The seam between web-engine visibility and the pipeline: intents,
# conversion points, and conversion events, with pointers into whatever CRM
# you run. Design rule inherited from core: integrate with data sources, not
# vocabularies — the CRM record is referenced by identity key (crmRecordRef),
# never mirrored as a vendor vocabulary dependency.
#
# This module deliberately introduces interpretation-layer terms (targetsIntent,
# attributedResponse). Interpretations carry method and confidence; they are claims,
# not facts, and agents assembling context can filter them out.

weo:engagement-module a owl:Ontology ;
    dct:title "WEO Engagement (draft)" ;
    dct:description "DRAFT v0. The seam between web-engine visibility and the pipeline: intents, conversion points, conversion events, and identity-key pointers into whatever CRM you run." ;
    dct:creator "Inbound Found" ;
    owl:versionInfo "0.4.0" .

# --- Intent ------------------------------------------------------------------

weo:SearchIntent a owl:Class ;
    rdfs:label "Search Intent" ;
    weo:epistemicLayer "entity" ;
    weo:groundedIn "Broder (2002), 'A taxonomy of web search', as extended in common practice" ;
    dct:description "Why the person is asking. Modeled as named individuals, not free strings." .

weo:Informational a weo:SearchIntent , owl:NamedIndividual ; rdfs:label "Informational" .
weo:Navigational  a weo:SearchIntent , owl:NamedIndividual ; rdfs:label "Navigational" .
weo:CommercialInvestigation a weo:SearchIntent , owl:NamedIndividual ; rdfs:label "Commercial Investigation" .
weo:Transactional a weo:SearchIntent , owl:NamedIndividual ; rdfs:label "Transactional" .

weo:targetsIntent a owl:ObjectProperty ;
    rdfs:range weo:SearchIntent ;
    weo:epistemicLayer "interpretation" ;
    dct:description "A URL or Prompt is aimed at this intent. A strategist's or model's claim — carries method and confidence." .

# --- Conversion points (entities on the page) ---------------------------------

weo:ConversionPoint a owl:Class ;
    rdfs:label "Conversion Point" ;
    weo:epistemicLayer "entity" ;
    dct:description "A durable on-page mechanism that turns attention into a pipeline event." .

weo:CallToAction a owl:Class ; rdfs:subClassOf weo:ConversionPoint ;
    rdfs:label "Call To Action" .

weo:LeadCaptureForm a owl:Class ; rdfs:subClassOf weo:ConversionPoint ;
    rdfs:label "Lead Capture Form" .

weo:GatedAsset a owl:Class ; rdfs:subClassOf weo:ConversionPoint ;
    rdfs:label "Gated Asset" ;
    dct:description "Content exchanged for contact information." .

weo:hasConversionPoint a owl:ObjectProperty ;
    rdfs:domain weo:URL ; rdfs:range weo:ConversionPoint ;
    weo:epistemicLayer "observation" ;
    dct:description "Observed presence of a conversion point on a page (crawl-attributed, bitemporal like linksTo)." .

# --- Conversion events (episodes) ---------------------------------------------

weo:ConversionEvent a owl:Class ;
    rdfs:label "Conversion Event" ;
    weo:epistemicLayer "episode" ;
    dct:description "A submission/click/unlock that happened at a time. Immutable once recorded." .

weo:capturedBy a owl:ObjectProperty ;
    rdfs:domain weo:ConversionEvent ; rdfs:range weo:ConversionPoint ;
    weo:epistemicLayer "observation" .

weo:occurredAt a owl:DatatypeProperty ;
    rdfs:domain weo:ConversionEvent ; rdfs:range xsd:dateTime ;
    weo:epistemicLayer "episode" .

weo:crmRecordRef a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    weo:epistemicLayer "entity" ;
    weo:canonicalStore "crm" ;
    dct:description "Identity-key pointer to the CRM object (form id, contact id, deal id) in whatever system runs the pipeline. The join contract to the post-click world — the graph never mirrors the CRM's schema." .

# --- Pre-click attribution (an interpretation, and labeled as one) --------------

weo:attributedResponse a owl:ObjectProperty ;
    rdfs:domain weo:ConversionEvent ; rdfs:range weo:LLMResponse ;
    weo:epistemicLayer "interpretation" ;
    dct:description "The claim that this conversion traces to engine visibility captured in this response episode. Multi-engine attribution is inherently inferential: this edge MUST carry method and confidence, and honest implementations will leave it sparse." .
